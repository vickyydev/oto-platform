S.phase = "5/9: Settle party 1 on the ZZ TEST till: the form's preview, Confirm, Back with nothing taken (the settlement open)";
const till = S.pages.till.page;
await S.unlock('till');
S.inPlace = page => [page.getByLabel('Lock screen').locator('..')];
await S.openParty(till, S.p1, S.P1);
const r = {};
const previews = [];
const onResp = async (resp) => { try { if (/\/api\/parties\/[^/]+\/settle\/preview$/.test(new URL(resp.url()).pathname)) previews.push(await resp.json()); } catch { /* ignore */ } };
till.on('response', onResp);
await till.getByRole('button', { name: 'Settle party', exact: true }).click();
await till.getByText('Balance', { exact: true }).first().waitFor({ timeout: 30000 }).catch(() => {});
await till.waitForTimeout(2500);
const q = previews.at(-1)?.quote ?? null;
r.preview = q ? { packageName: q.packageName, rateMode: q.rateMode, lines: q.lines.map(l => `${l.role} | ${l.label} | ${l.quantity} x ${l.unitSatang / 100} = ${l.totalSatang / 100}`), packageSatang: q.packageSatang / 100, socks: q.socksSatang / 100, addOns: q.addOnsSatang / 100, total: q.totalSatang / 100, deposit: q.depositSatang / 100, balance: q.balanceSatang / 100 } : null;
const dialog = till.getByRole('dialog').last();
r.formText = S.flat(await dialog.innerText().catch(() => '')).slice(0, 900);
await S.shot(till, '05a-settle-party-form-preview.png');
const settled = till.waitForResponse(rr => /\/api\/parties\/[^/]+\/settle$/.test(new URL(rr.url()).pathname) && rr.request().method() === 'POST', { timeout: 60000 });
await till.getByRole('button', { name: /^Confirm/ }).click();
const sr = await settled;
const sb = await sr.json().catch(() => null);
S.settleSale = sb?.sale?.id ?? null;
if (S.settleSale) { S.receipt.created.push({ kind: 'party-settlement-sale', id: S.settleSale }); S.save(); }
r.settle = { status: sr.status(), state: sb?.settlement?.state ?? null, gross: (sb?.sale?.grossSatang ?? 0) / 100, outstanding: (sb?.sale?.outstandingSatang ?? 0) / 100, quoteLines: (sb?.quote?.lines ?? []).map(l => `${l.role} | ${l.label} | ${l.quantity} x ${l.unitSatang / 100} = ${l.totalSatang / 100}`) };
till.off('response', onResp);
await till.getByTestId('payment-step').waitFor({ timeout: 30000 }); await till.waitForTimeout(2500);
await S.shot(till, '05b-settle-payment-step.png');
const back = till.getByTestId('payment-step').getByRole('button', { name: 'Back', exact: true });
await back.click(); await till.waitForTimeout(3000);
const body = S.flat(await till.locator('body').innerText());
r.afterBack = { bill: body.match(/Party bill[^]*?Outstanding[^฿]*฿[0-9,]+/)?.[0]?.slice(0, 600) ?? null };
const buttons = [];
for (const b of await till.getByRole('button').all()) { const l = S.flat(await b.innerText().catch(() => '')); if (/Take balance|Fully paid|Resume settlement|Cancel settlement|Settle party/.test(l) && await b.isVisible()) buttons.push({ l, enabled: await b.isEnabled() }); }
r.afterBack.buttons = buttons;
await till.mouse.wheel(0, -3000); await till.waitForTimeout(400);
await S.shot(till, '09a-till-desk-settlement-open-party-bill.png');
S.receipt.reads.p5open = r;
return r;

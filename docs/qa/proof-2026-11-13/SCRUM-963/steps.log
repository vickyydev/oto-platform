=== 2026-11-12T23:55:43.989Z 1: the till after the reconnect: its copy scrolled to the allergy; the language the box holds for this sale (read by the till)
S.phase = '1: the till after the reconnect: its copy scrolled to the allergy; the language the box holds for this sale (read by the till)';
const till = S.till, d = S.d;
const out = {};
const doc = await till.evaluate(async (id) => { const r = await fetch(`/api/stations/${id}/session`, { credentials: 'include' }); const b = await r.json().catch(() => null); const docu = b?.document ?? b?.session?.document ?? b; return { status: r.status, keys: b ? Object.keys(b).slice(0, 12) : null, language: docu?.language ?? null, stage: docu?.stage ?? docu?.customerStage ?? null }; }, S.station.id);
out.sessionDoc = doc;
const m = till.getByTestId('consent-mirror');
await m.getByTestId('consent-allergies').scrollIntoViewIfNeeded();
await till.waitForTimeout(500);
out.mirror = await S.mirrorState(till);
out.mirrorAllergyBox = await m.getByTestId('consent-allergies').evaluate(e => ({ value: e.value, readOnly: e.readOnly || e.disabled, box: (r => [Math.round(r.left), Math.round(r.top), Math.round(r.right), Math.round(r.bottom)])(e.getBoundingClientRect()) }));
await S.both('01g-till-copy-scrolled-to-the-allergy-display-in-thai.png', `Point 1 — after the reconnect: the till's read-only copy shows the allergy "${out.mirror.allergies}"; the box holds the sale's language as "${doc.language}" (read by the till); the display in Thai`, till, d);
S.receipt.reads.p1tillAfter = out; S.save();
return out;

=== 2026-11-12T17:38:13.990Z clean up: release own ZZ TEST children in the park (synthetic pickup picture); the staging manager refunds every own cash sale whole
S.phase = 'clean up: release own ZZ TEST children in the park (synthetic pickup picture); the staging manager refunds every own cash sale whole';
clearInterval(S.aliveTimer); S.aliveTimer = null;
const out = { registrations: [], refunds: [] };
for (const [fam, v] of Object.entries(S.fam)) {
  if (!v.reg) continue;
  let reg = await S.registration(v.reg);
  S.assert.ok(S.isZz(reg.guardianName) && reg.children.every(c => S.isZz(c.childName)), 'own ZZ TEST registration only');
  const released = await S.releaseOwn(v.reg);
  reg = await S.registration(v.reg);
  let cancelled = null;
  if (reg.children.some(c => c.status === 'registered')) { const r = await S.call('POST', `/checkin/registrations/${v.reg}/cancel`, { reason: 'ZZ TEST SCRUM-954 proof clean-up' }); cancelled = { status: r.status, code: r.body?.error?.code ?? null }; reg = await S.registration(v.reg); }
  out.registrations.push({ fam, released, cancelled, children: reg.children.map(c => `${c.childName}: ${c.status}`) });
}

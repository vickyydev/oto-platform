  if (!card) return null;
  const cb = card.getBoundingClientRect();
  const r1 = v => Math.round(v * 10) / 10;
  const buttons = [...card.querySelectorAll('button')].filter(b => b.getBoundingClientRect().width > 0).map(b => {
    const bb = b.getBoundingClientRect();
    const rg = document.createRange(); rg.selectNodeContents(b); const rects = [...rg.getClientRects()];
    let worst = 0; for (const rr of rects) if (rr.width > 0) worst = Math.max(worst, bb.left - rr.left, rr.right - bb.right, bb.top - rr.top, rr.bottom - bb.bottom);
    return { text: b.innerText.replace(/\s+/g, ' ').trim(), box: [r1(bb.left), r1(bb.top), r1(bb.width), r1(bb.height)], textSpillsBy: r1(Math.max(0, worst)), insideCard: bb.left >= cb.left - 1 && bb.right <= cb.right + 1, enabled: !b.disabled, cls: (b.className.match(/(?:^| )(h-11|h-auto|min-h-11|min-h-16|h-16|h-12|min-h-12)(?= |$)/g) ?? []).map(s => s.trim()) };
  });
  return { card: [r1(cb.left), r1(cb.top), r1(cb.width), r1(cb.height)], viewport: [window.innerWidth, window.innerHeight], buttons, text: card.innerText.replace(/\s+/g, ' ').trim().slice(0, 400) };
}, guardian);

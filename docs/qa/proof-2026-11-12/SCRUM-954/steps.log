await S.boardApi();
const d = await S.pairDisplay('main');
S.d = d;
const facts = await d.evaluate(() => ({ url: location.pathname + location.search, touch: navigator.maxTouchPoints, w: innerWidth, h: innerHeight, theme: document.querySelector('[data-testid="separate-display"]')?.className.split(' ')[0] ?? null }));
await d.getByTestId('language-choice-en').tap();
await d.getByTestId('identify-safety').waitFor();
const nick = d.getByPlaceholder('e.g. Mama, John');
await nick.scrollIntoViewIfNeeded();
await nick.tap();
await expect.poll(() => S.keys(d).count()).toBe(1);
await d.waitForTimeout(600);
const look = await S.keyLook(d);
const blue = await S.blueButtons(d, /^(Continue)$/);
await S.shot(d, '01a-600-first-screen-nickname-keys-hide-grey.png');
// a close-up of the bottom row: Backspace, Space, Hide
const kb = await d.getByTestId('screen-keyboard').boundingBox();
await S.shot(d, '01b-600-first-screen-keys-close-up.png', [], { clip: { x: Math.max(0, kb.x - 8), y: Math.max(0, kb.y - 8), width: Math.min(600, kb.width + 16), height: kb.height + 16 } });
await S.typeKeys(d, 'ZZ');
const typed = await nick.inputValue();
await S.hideKeys(d);
await d.waitForTimeout(500);
const keysAfterHide = await S.keys(d).count();
// clear the two letters again with the keys (nickname left empty)
await nick.tap(); await S.keys(d).waitFor();
await S.keys(d).getByRole('button', { name: 'Backspace' }).tap(); await S.keys(d).getByRole('button', { name: 'Backspace' }).tap();
await S.hideKeys(d);
S.receipt.reads.p1first = { facts, look, blue, typed, keysAfterHide, nicknameAfter: await nick.inputValue() };
S.save();
return S.receipt.reads.p1first;

await S.payCash(till);
const leave = till.getByRole('button', { name: 'Leave as booked', exact: true });
await leave.waitFor({ timeout: 20000 });
await leave.click();
await till.waitForTimeout(2500);
// three siblings, through the till's own "Add sibling" route
const sibs = ['ZZ TEST Sibling 884 Age Three Long', 'ZZ TEST Sibling 884 Age Four Longer', 'ZZ TEST Sibling 884 Age Six Nanny Long'];
const add = await till.evaluate(async ({ id, sibs }) => {
  const r = await fetch(`/api/checkin/registrations/${id}/children`, { method: 'POST', credentials: 'include', headers: { 'content-type': 'application/json', 'idempotency-key': crypto.randomUUID() },
    body: JSON.stringify({ children: sibs.map((name, i) => ({ checkinId: crypto.randomUUID(), name, ageYears: [3, 4, 6][i], service: 'drop_off', allergies: null, foodRestrictions: null, foodProvision: { mode: 'none', paidSatang: 0 } })) }) });
  const b = await r.json().catch(() => null);
  return { status: r.status, code: b?.error?.code ?? null, message: b?.error?.message ?? null, children: (b?.children ?? []).map(c => ({ id: c.id, name: c.childName, status: c.status })) };
}, { id: reg.id, sibs });
S.fam.F = { reg: reg.id, sale: sale.id };
S.receipt.created.push({ kind: 'siblings-added', registration: reg.id, status: add.status, children: add.children.map(c => c.name) }); S.save();
const s = await S.sale(sale.id);
return { due, sale: { status: s.sale.status, receipt: s.sale.receiptNumber, gross: s.sale.totals.grossSatang / 100 }, add, board: S.stayFacts(await S.familyOnBoard(reg.id)) };

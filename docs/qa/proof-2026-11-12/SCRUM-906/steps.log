S.phase = '1: pictures retaken with short names matched case-sensitively (a name like "[name]" must not black out "min")';
const { resolve } = S;
S.shot = async (page, name, extra = [], opts = {}) => {
  for (const loc of S.inPlace(page)) await loc.evaluateAll(els => { for (const e of els) e.setAttribute('data-zz-mask', '1'); }).catch(() => {});
  await page.evaluate((list) => {
    if (!document.getElementById('zz-mask-style')) { const st = document.createElement('style'); st.id = 'zz-mask-style'; st.textContent = '[data-zz-mask]{background:#18181b!important;color:#18181b!important;border-color:#18181b!important;border-radius:2px} [data-zz-mask] *{color:#18181b!important;background:#18181b!important}'; document.head.appendChild(st); }
    const esc = s => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const res = list.map(s => new RegExp(`(?<![\\p{L}\\p{N}])${esc(s)}(?![\\p{L}\\p{N}])`, s.length <= 4 ? 'u' : 'iu'));
    const w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
    while (w.nextNode()) { const v = w.currentNode.nodeValue || ''; if (v.trim() && res.some(r => r.test(v))) w.currentNode.parentElement?.setAttribute('data-zz-mask', '1'); }
    for (const el of document.querySelectorAll('input,textarea')) { if (res.some(r => r.test(el.value || ''))) el.setAttribute('data-zz-mask', '1'); }
  }, S.needles());
  try {
    if (opts.element) await opts.element.screenshot({ path: resolve(S.out, name), animations: 'disabled', mask: [...S.masks(page), ...extra], maskColor: '#18181b' });
    else await page.screenshot({ path: resolve(S.out, name), animations: 'disabled', ...opts, mask: [...S.masks(page), ...extra], maskColor: '#18181b' });
  } finally {
    await page.evaluate(() => { for (const el of document.querySelectorAll('[data-zz-mask]')) el.removeAttribute('data-zz-mask'); }).catch(() => {});
  }
  S.shots.push(name);
  return name;
};
S.scrub = text => {
  let t = String(text);
  for (const n of S.needles()) t = t.replace(new RegExp(`(?<![\\p{L}\\p{N}])${n.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}(?![\\p{L}\\p{N}])`, n.length <= 4 ? 'gu' : 'giu'), '[name]');
  return t.replace(/[0-9a-f]{48}/g, '<token>');
};
const till = S.pages.till.page;
await till.mouse.wheel(0, -3000); await till.waitForTimeout(500);
await S.shot(till, '01a-till-desk-party-page-top.png');
await S.shot(till, '01b-till-desk-kitchen-plan-card.png', [], { element: S.cardOf(till, 'Kitchen plan') });
await S.shot(till, '01c-till-desk-bar-plan-card.png', [], { element: S.cardOf(till, 'Bar plan') });
return S.shots;

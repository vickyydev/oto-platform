    badgeUnderName: bb ? bb.top >= nb.bottom - 1 : null, cardBox: [cb.left, cb.top, cb.width, cb.height].map(Math.round), insideCard: nb.right <= cb.right + 1 && (!bb || bb.right <= cb.right + 1) };
}, S.MEMBER);

const { expect } = S;
S.phase = '8: family N completes the form; the registration write is held in the till; the family presses Done';
const till = S.till, d = S.displays.nocam.page;
await S.keepAlive();
const consent = d.getByTestId('display-consent');
await consent.getByRole('button', { name: 'Continue', exact: true }).click();
const g = consent.locator('#public-consent-guardian');
await g.waitFor();
await g.fill('ZZ TEST 857 guardian N');
for (const box of await consent.getByRole('checkbox').all()) if (await box.getAttribute('data-state') !== 'checked' && await box.isEnabled()) await box.click();
const done = consent.getByRole('button', { name: 'Done', exact: true });
await expect(done).toBeEnabled({ timeout: 20000 });
// hold the registration write in the till's own context
let release; const released = new Promise(r => { release = r; });
let reached; const reachedP = new Promise(r => { reached = r; });
S.regHold = { release, count: 0 };
S.regRoute = url => url.pathname === '/api/checkin/registrations';
await till.route(S.regRoute, async route => {
  if (route.request().method() !== 'POST') return route.continue();
  S.regHold.count += 1; reached();
  await released;
  await route.continue();
});
await done.click();
await Promise.race([reachedP, till.waitForTimeout(30000)]);
await till.waitForTimeout(700);
const line = await S.staffLine(till);
await S.pair('08a-done-pressed-registration-held.png', till, d, { caption: 'Point 8 — the family pressed Done; the registration write is held in the till (harness); the till line and the display say it is saving' });
return { heldRequests: S.regHold.count, line, display: await S.displayState(d), backEnabled: await till.getByRole('button', { name: 'Back', exact: true }).first().isEnabled() };

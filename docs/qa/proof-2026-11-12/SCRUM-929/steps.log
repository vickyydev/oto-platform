await till.locator('input[inputmode="tel"],input[type="tel"]').first().fill(need('STAGING_MANAGER_PHONE').replace(/^\+66/, '0'));
await till.locator('input[type="password"]').first().fill(need('STAGING_MANAGER_PASSWORD'));
await till.getByRole('button', { name: 'Sign in', exact: true }).click();
const pick = till.getByRole('button', { name: S.stations.A.name, exact: false }).first();
const picker = till.getByRole('heading', { name: 'Which station are you on?' });
const deadline = Date.now() + 60000;
while (Date.now() < deadline) { if (await picker.isVisible()) { if (await pick.isVisible()) { await pick.click(); break; } } else if (await till.locator('a[href="/history"]').first().isVisible()) break; await till.waitForTimeout(500); }
await till.locator('a[href="/history"]').first().waitFor({ timeout: 60000 });
const me = await till.evaluate(async () => (await (await fetch('/api/me', { credentials: 'include' })).json()));
const walk = (o, dd = 0) => { if (!o || dd > 3) return; for (const [k, v] of Object.entries(o)) { if (typeof v === 'string' && /^(name|nickname|fullName|displayName|firstName|lastName)$/i.test(k) && v.trim().length >= 2) { S.names.add(v.trim()); for (const p of v.trim().split(/\s+/)) if (p.length >= 3) S.names.add(p); } else if (v && typeof v === 'object' && !/branch|operator|station|role/i.test(k)) walk(v, dd + 1); } };
walk(me);
out.managerAtOwnTill = JSON.stringify(me).includes(S.stations.A.id);
S.assert.ok(out.managerAtOwnTill);
const sale = (await S.call('GET', `/sales?branchId=${S.branchId}&stationId=${S.stations.A.id}&limit=20`)).body.sales.find(s => s.receiptNumber === 'Z92901-000001');
S.assert.ok(sale && sale.status === 'finalised');
out.refund = await till.evaluate(async ({ id, key }) => { const res = await fetch(`/api/sales/${id}/refunds`, { method: 'POST', credentials: 'include', headers: { 'content-type': 'application/json', 'idempotency-key': key }, body: JSON.stringify({ mode: 'whole', reason: 'ZZ TEST SCRUM-929 proof cleanup' }) }); const b = await res.json().catch(() => null); return { status: res.status, code: b?.error?.code ?? null }; }, { id: sale.id, key: S.randomUUID() });
const after = (await S.call('GET', `/sales/${sale.id}`)).body;
const s = after.sale ?? after;
out.saleAfter = { receipt: s.receiptNumber, status: s.status, gross: s.totals?.grossSatang / 100, refunded: (s.totals?.refundedSatang ?? 0) / 100 };
S.receipt.cleanup.refund = out;
return out;

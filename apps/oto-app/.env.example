# Local development values. Use deployment-specific values on Render.
APP_ENV=dev
DEPLOY_ENV=local
NODE_ENV=development
PORT=5000
TRUST_PROXY=1
TZ=UTC

# The app tables live in otoapp on the central PostgreSQL database.
DATABASE_URL=
DB_SCHEMA=otoapp

# Use local only on a laptop. Staging and production require s3 and a private bucket.
OBJECT_STORAGE=local
STORAGE_ENV_PREFIX=dev
S3_BUCKET=
S3_ENDPOINT=
S3_PORT=443
S3_USE_SSL=true
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Supply distinct, non-default values through the deployment environment.
SESSION_SECRET=
SESSION_PEPPER=
KIOSK_CODE_PEPPER=
PIN_FINGERPRINT_SECRET=

# Platform hand-off; legacy login is only for an isolated cutover rehearsal.
PLATFORM_API_URL=
OTOAPP_PUBLIC_ORIGIN=
OTOAPP_LEGACY_LOGIN=false

# Who runs the night jobs: inprocess (this app's own timers, the default) or
# platform (the platform's job runner, from S2-17b round 3).
#   - platform: no timer starts here; the platform runs each batch for each
#     park group through POST /api/directory/jobs/:name/run, with a directory
#     key carrying the jobs:run scope (npm run directory:client -- create
#     --tenant <uuid> --name platform-jobs --scope jobs:run), which the platform
#     api holds as OTOAPP_JOBS_KEYS; the two manual job triggers point at the
#     platform's 03:00 run and Retry on the Console instead of running.
#   - from S2-17b round 4b the same switch decides the Attention engine (every
#     six hours, and five seconds after start-up) and the no-show check (every
#     ten minutes, 07:00-22:00 Bangkok): under platform they are the
#     platform's job:otoapp.attention and job:otoapp.no_show, with the same key.
#   - inprocess: this app's timers run, and that endpoint refuses in words, so
#     the two never run one batch side by side. The timers take the
#     endpoint's per-park-group lock, so even two instances that disagree
#     about this switch never run one park group's night at once.
# The hand-over (S2-17b plan Q22), between 03:00 and 23:00 Bangkok: issue a
# jobs:run key for EVERY park group this app holds staff in (one left out
# fails every platform run, naming it), flip this to platform, then set the
# keys on the api the same day (in between, no night work runs). Within five
# minutes the platform runs the day's batches a second time (which changes
# nothing) and the Console's Health page shows each run, or Failures shows
# why. Run now exists only among a staging deployment's test controls. Flip
# back to inprocess if a batch keeps failing.
OTOAPP_JOBS=inprocess

# The directory's six HR reads (/api/directory/employee/:id, employees/search,
# branches/:id/employees, roles, departments, branches) answer for one park
# group: send a directory key issued to that park group with the hr:read scope
# (npm run directory:client -- create --tenant <uuid> --name <who> --scope
# hr:read) as Authorization: Bearer <key>. The old shared key below still
# works where it is set, for the default park group only (S2-17b round 4a,
# plan Q13); unset — as on staging — a request sending X-HR-API-KEY is
# refused with a 403 in words.
HR_DIRECTORY_API_KEY=

# Optional integrations; their modules report unavailable until configured.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_FAST_MODEL=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
USE_AWS_REKOGNITION=false

# Build and logging metadata.
APP_VERSION=
APP_CHANGE_ID=
LOG_RESPONSE_BODY=false

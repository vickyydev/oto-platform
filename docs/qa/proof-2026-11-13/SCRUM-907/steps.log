S.phase = "3: the ZZ TEST till named for party slips; Print party slips now for party 1 (SCRUM-951's READY BY)";
const r = {};
const b0 = (await S.call('GET', '/branches')).body.branches.find(b => b.id === S.branchId);
S.assert.equal(b0.partySlipsStationId ?? null, S.receipt.foundAtStart.partySlipsStationId ?? null, 'nobody changed the naming since the look');
S.assert.equal(b0.partySlipsStationId ?? null, null, 'the park names no party slips station (nobody else is using it)');
S.seen = { kitchen: (await S.printouts('kitchen')).map(S.keyOf), bar: (await S.printouts('bar')).map(S.keyOf) };
S.slipsFrom = new Date().toISOString();
const named = await S.call('PATCH', `/branches/${S.branchId}`, { partySlipsStationId: S.station.id });
S.assert.equal(named.status, 200, 'named');
S.stationNamed = true;
r.named = { at: S.slipsFrom, status: named.status, readBack: (await S.call('GET', '/branches')).body.branches.find(b => b.id === S.branchId).partySlipsStationId === S.station.id };
const till = S.pages.rec.page;
await S.unlock('rec');
await S.openParty(till, S.p1, S.P1);
const btn = till.getByRole('button', { name: 'Print party slips now', exact: true });
await btn.scrollIntoViewIfNeeded();
const resp = till.waitForResponse(rr => /\/api\/parties\/[^/]+\/slips\/print$/.test(new URL(rr.url()).pathname) && rr.request().method() === 'POST', { timeout: 60000 });
r.pressedAt = new Date().toISOString();
await btn.click();
const rr = await resp;
const rb = await rr.json().catch(() => null);
r.press = { status: rr.status(), records: (rb?.slips?.records ?? []).map(x => `${x.station} run ${x.run} ${x.trigger} ${x.status}`) };
const deadline = Date.now() + 90000;
let n = { kitchen: [], bar: [] };
while (Date.now() < deadline) { n = await S.newPrintouts(); if (n.kitchen.length >= 1 && n.bar.length >= 1) break; await S.sleep(3000); }
await S.sleep(5000);
n = await S.newPrintouts();
r.printouts = { kitchen: n.kitchen.map(p => ({ seq: p.seq, at: S.bkk(p.at), heightDots: p.heightDots })), bar: n.bar.map(p => ({ seq: p.seq, at: S.bkk(p.at), heightDots: p.heightDots })) };
if (n.kitchen[0]) await S.keepPreview('kitchen', n.kitchen[0], '03a-kitchen-slip-first-print.png');
if (n.bar[0]) await S.keepPreview('bar', n.bar[0], '03b-bar-slip-first-print.png');
S.markSeen(n.kitchen, n.bar);
r.jobsAtTill = (await S.jobsAtTill(S.slipsFrom)).map(j => `${j.bangkok} ${j.kind} ${j.role} ${j.status}`);
r.tillRead = await S.tillRead(S.p1, 'p1-after-first-print');
await S.sleep(1500);
const block = till.locator('div.font-bold', { hasText: /^Kitchen & bar slips$/ }).first();
await block.scrollIntoViewIfNeeded().catch(() => {});
r.slipsCard = await S.cardText(till, 'Kitchen & bar slips');
await S.shot(till, '03c-till-slips-card-after-print-now.png', [], { element: S.cardOf(till, 'Kitchen & bar slips') });
S.receipt.reads.p3print = r;
return r;

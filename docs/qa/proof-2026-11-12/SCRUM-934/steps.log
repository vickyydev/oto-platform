  const fin = till.waitForResponse(rr => /\/api\/sales\/[^/]+\/finalise$/.test(new URL(rr.url()).pathname) && rr.request().method() === 'POST', { timeout: 30000 });
  await till.getByTestId('payment-step').getByRole('button', { name: 'Confirm Payment Received', exact: true }).click();
  const fr = await fin;
  await S.sleep(4000);

S.phase = "1: the parent's choices through the link's public routes";
// word-bounded scrub (a short name must not cut into a dish's name)
S.scrub = text => {
  let t = String(text);
  for (const n of S.needles()) t = t.replace(new RegExp(`(?<![\\p{L}\\p{N}])${n.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}(?![\\p{L}\\p{N}])`, 'gu'), '[name]');
  return t.replace(/[0-9a-f]{48}/g, '<token>');
};
const link = await S.appCall('POST', '/beo/set-menu-selections', { eventId: S.p1, templateId: S.tmpl.id });
S.assert.equal(link.status, 201, 'parent link');

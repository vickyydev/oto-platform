S.phase = 'setup';
const r = await S.setup();
S.phase = 'sign in desk till';
const till = await S.signIn('till', 'STAGING_RECEPTION_PHONE', 'STAGING_RECEPTION_PASSWORD', { width: 1680, height: 1050 });
S.till = till;
const bundle = await till.evaluate(async () => {
  const urls = [...new Set(performance.getEntriesByType('resource').map(e => e.name).filter(n => /\.js(\?|$)/.test(n)))];
  const found = { files: urls.length, mirror: 0, familyDone: 0, stillNeeded: 0, stillRegistering: 0, photoReceived: 0 };
  for (const url of urls) { const t = await (await fetch(url, { cache: 'no-store' })).text();
    found.mirror += t.split('consent-mirror').length - 1; found.familyDone += t.split('The family pressed Done: the children are being registered').length - 1;
    found.stillNeeded += t.split('Still needed before Done').length - 1; found.stillRegistering += t.split('Still registering the children').length - 1; found.photoReceived += t.split('The team has this photo.').length - 1; }
  return found;
});
S.receipt.reads.bundle = bundle;
await S.landing(till).waitFor();
await S.shot(till, '00-desk-till-signed-in-landing.png');
return { r, bundle };

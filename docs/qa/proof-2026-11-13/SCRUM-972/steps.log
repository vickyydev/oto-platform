=== 2026-11-13T01:57:05.746Z 2: a card the box refuses on purpose: ring the sale, assign the terminal, press Card at once; time it, no reload
S.phase = '2: a card the box refuses on purpose: ring the sale, assign the terminal, press Card at once; time it, no reload';
const till = S.till;
await S.unlock('rec');
const hashBefore = (await S.box1()).lastStatus?.configVersion ?? null;
S.receipt.numbers.p2 = S.free[0];
const r = await S.refuse(till, { number: S.free[0], kind: 'p2-refused-then-cash', shotPrefix: '02' });
S.p2 = r;
r.boxHashBeforeAssign = hashBefore;
r.boxHashRightAfter = (await S.box1()).lastStatus?.configVersion ?? null;
await till.waitForTimeout(800);
const step = S.paymentStep(till);
r.stepText = S.flat(await step.innerText());
r.alerts = (await till.locator('[role="alert"], [role="status"]').allInnerTexts().catch(() => [])).map(S.flat).filter(Boolean).slice(0, 8);
r.buttons = await step.getByRole('button').evaluateAll(els => els.map(e => ({ text: (e.innerText || '').replace(/\s+/g, ' ').trim(), disabled: e.disabled })));
r.cardTiles = await step.locator('[aria-disabled]').evaluateAll(els => els.map(e => ({ text: (e.innerText || '').replace(/\s+/g, ' ').trim(), ariaDisabled: e.getAttribute('aria-disabled') })));
r.plainReasonOnScreen = r.stepText.includes('not ready on this counter');
await S.shot(till, '02b-till-payment-declined-no-reload.png');
S.receipt.reads.p2 = r;
return r;

S.phase = 'masks: every picture measured for how much of it is masked black (a mask that swallowed a page shows up here); the demo-wristband rule replaced by the cards themselves';
S.extraInPlace.length = 0;
S.extraInPlace.push(page => page.locator('button').filter({ has: page.locator('text=/^#(\\d{4}|WK-|GT-)/') }).filter({ hasText: /credit|prepaid/i }));
const fs = await import('node:fs');
const files = fs.readdirSync(S.out).filter(f => f.endsWith('.png'));
const ctx = await S.browser.newContext({ viewport: { width: 400, height: 300 } });
const page = await ctx.newPage();
const out = [];
for (const f of files) {
  const b64 = fs.readFileSync(S.resolve(S.out, f)).toString('base64');
  const v = await page.evaluate(async (src) => {
    const img = new Image(); img.src = src; await img.decode();
    const c = document.createElement('canvas'); const w = Math.min(img.naturalWidth, 600); const h = Math.round(img.naturalHeight * w / img.naturalWidth);
    c.width = w; c.height = h; const g = c.getContext('2d'); g.drawImage(img, 0, 0, w, h);
    const d = g.getImageData(0, 0, w, h).data; let mask = 0;
    for (let i = 0; i < d.length; i += 4) if (Math.abs(d[i] - 0x18) < 4 && Math.abs(d[i + 1] - 0x18) < 4 && Math.abs(d[i + 2] - 0x1b) < 4) mask++;
    return Math.round(mask / (w * h) * 1000) / 10;
  }, 'data:image/png;base64,' + b64);
  out.push([f, v]);
}
await ctx.close();
return out.sort((a, b) => b[1] - a[1]).slice(0, 20);

const ctx = await S.browser.newContext({ viewport: { width: 2000, height: 1000 } });
const page = await ctx.newPage();
await page.setContent(`<html><body style="margin:0"><div id="w" style="position:relative;display:inline-block"><img id="i" src="data:image/png;base64,${b64}"><div style="position:absolute;left:0;top:0;width:100%;height:34px;background:#fff;font:15px system-ui;color:#111;padding:8px 12px;box-sizing:border-box"><b>SCRUM-964</b> · hunt — B continued over the waiting QR: the payment step shows the methods, no payment in progress (the QR was NOT read back); the display in the held minute still shows the QR (masked) · captured together at 10:45:15 Bangkok</div></div></body></html>`);

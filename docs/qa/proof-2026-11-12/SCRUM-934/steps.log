await S.shot(till, '01b-family-a-paid.png');
await leave.click();
await till.waitForTimeout(2500);
S.fam.A = { reg: reg.id, sale: sale.id, stays: reg.children.map(c => ({ id: c.id, name: c.childName })) };
const s = await S.sale(sale.id);
return { due, status: s.sale.status, gross: s.sale.totals.grossSatang / 100, receipt: s.sale.receiptNumber,
  lines: s.lines.map(l => ({ kind: l.kind, label: l.label, childName: l.childName ?? null, cart: S.fam.A.stays.findIndex(x => x.id === l.cartLineId), gross: l.grossSatang / 100 })),
  board: S.stayFacts(await S.familyOnBoard(reg.id)) };

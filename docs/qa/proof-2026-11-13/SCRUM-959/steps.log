  const found = { files: urls.length, savePartPaid: 0, itemPartPaid: 0, historyPlaceholder: 0, discountCode: 0, inFlight: 0 };
  for (const url of urls) { const t = await (await fetch(url, { cache: 'no-store' })).text();
    found.savePartPaid += t.split('Save as partly paid').length - 1; found.itemPartPaid += t.split('item-part-paid').length - 1;
    found.historyPlaceholder += t.split('Search by name, receipt, bracelet').length - 1; found.discountCode += t.split('Discount code').length - 1;
    found.inFlight += t.split('A payment is in progress').length - 1; }
  return found;
});

const { expect } = S;
S.phase = '1/2: SCRUM-893/894 on the counter display at 600x1024: each box opens the keys; typing reaches the box and the till copy';
const till = S.till, d = S.displays.main.page;
await S.keepAlive();
/** One box: touch it, the keys open; where box, keys and bar sit; type with the keys; how long until the till copy has it; does the page move while typing. */
S.boxProof = async (d, testId, text, picture, caption) => {
  const r = { testId };
  const box = d.getByTestId('display-consent').getByTestId(testId);
  r.keysBefore = await S.keys(d).count();
  await box.tap();
  await expect.poll(() => S.keys(d).count()).toBe(1);
  await d.waitForTimeout(400);
  r.opened = await S.placing(d, testId);
  const before = (await box.inputValue());
  const t0 = Date.now();
  r.typeMs = await S.typeKeys(d, text);
  const typed = Date.now();
  const want = before + text.split(' ').map(w => w ? w[0].toUpperCase() + w.slice(1).toLowerCase() : w).join(' ');
  r.value = await box.inputValue();
  r.expected = want;
  await expect.poll(async () => (await S.mirrorState(S.till))[{ 'consent-child-name': 'childName', 'consent-allergies': 'allergies', 'consent-dietary': 'dietary', 'consent-guardian': 'guardian' }[testId]], { timeout: 15000 }).toBe(want.trim());
  r.tillCopyMsAfterLastKey = Date.now() - typed;
  r.afterTyping = await S.placing(d, testId);
  r.moved = { field: r.afterTyping.field[0] - r.opened.field[0], scrollTop: r.afterTyping.scrollTop - r.opened.scrollTop };
  await S.pair(picture, S.till, d, { caption });
  return r;
};
const out = {};
out.name = await S.boxProof(d, 'consent-child-name', 'ZZ TEST KEYS', '01b-600-child-name-keys-typed-till-follows.png', 'Points 1/2 — 600x1024: the child name box touched, the on-screen keys open under it; typed with the keys; the till copy has it');
out.keyNames = await S.keyNames(d);
await S.shot(d, '01c-600-keyboard-close-up.png');
await S.keys(d).getByRole('button', { name: 'Done', exact: true }).tap();
out.keysAfterDone = await S.keys(d).count();
await S.setAge(d, d.getByTestId('display-consent'), 6, { tap: true });
await d.getByTestId('display-consent').getByRole('button', { name: 'Continue', exact: true }).tap();
await d.getByTestId('display-consent').getByTestId('consent-allergies').waitFor();
await d.waitForTimeout(800);
out.allergies = await S.boxProof(d, 'consent-allergies', 'PEANUTS AND EGGS', '01d-600-allergies-keys-typed-till-follows.png', 'Points 1/2 — 600x1024: the owner\'s case, an allergy typed with the on-screen keys; the till copy has it');
out.dietary = await S.boxProof(d, 'consent-dietary', 'NO PORK', '01e-600-dietary-keys-typed-till-follows.png', 'Points 1/2 — 600x1024: the dietary box touched (the allergies keys put away), typed; the till copy has it');
out.allergyKeysClosedWhenDietaryOpened = await S.keys(d).count();
await S.keys(d).getByRole('button', { name: 'Done', exact: true }).tap();
return out;

  await S.shot(p, '97a-hunt-1440x900-touch-tapped-more-categories.png');
  await p.getByRole('button', { name: 'More categories', exact: true }).tap(); await p.waitForTimeout(900);
  const r2 = await S.rowRead(p);
  out.afterSecondTap = { scrollLeft: r2.scrollLeft, chosen: r2.chosen?.text };
  await p.getByRole('button', { name: 'Earlier categories', exact: true }).tap(); await p.waitForTimeout(900);
  const r3 = await S.rowRead(p);
  out.afterTapEarlier = { scrollLeft: r3.scrollLeft, more: !!r3.more, earlier: !!r3.earlier, chosen: r3.chosen?.text };
  await S.shot(p, '97b-hunt-1440x900-touch-tapped-earlier-categories.png');
  // does a finger swipe (touch scroll) on the row move it? emulated with a CDP touch drag
  const box = await p.locator('[data-testid="category-row"]').first().boundingBox();
  const cdp = await p.context().newCDPSession(p);
  const y = box.y + box.height / 2; const x0 = box.x + box.width * 0.75, x1 = box.x + box.width * 0.2;
  await cdp.send('Input.dispatchTouchEvent', { type: 'touchStart', touchPoints: [{ x: x0, y }] });
  for (let i = 1; i <= 8; i++) { await cdp.send('Input.dispatchTouchEvent', { type: 'touchMove', touchPoints: [{ x: x0 + (x1 - x0) * i / 8, y }] }); await p.waitForTimeout(30); }
  await cdp.send('Input.dispatchTouchEvent', { type: 'touchEnd', touchPoints: [] });
  await p.waitForTimeout(900);
  const r4 = await S.rowRead(p);
  out.afterSwipe = { scrollLeft: r4.scrollLeft, chosen: r4.chosen?.text };
  await cdp.detach().catch(() => {});
}
S.receipt.hunt.push({ what: 'category arrows with a finger (touch context)', ...out }); S.save();

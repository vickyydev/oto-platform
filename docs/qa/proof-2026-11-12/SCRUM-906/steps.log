S.assert.equal(ev.status, 201, 'party created ' + JSON.stringify(ev.body).slice(0, 200));
S.p1 = ev.body.id;
S.receipt.created.push({ kind: 'oto-app party', id: S.p1, title: S.P1 }); S.save();

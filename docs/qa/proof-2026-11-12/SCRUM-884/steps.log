S.scrollOf = (page, text) => page.evaluate((text) => {
  const h = [...document.querySelectorAll('h1,h2,h3,h4,button,span,p')].find(e => e.innerText.trim() === text && e.getBoundingClientRect().width > 0);
  if (!h) return null;
  let el = h.parentElement;
  while (el && el !== document.body) { const cs = getComputedStyle(el); if (/(auto|scroll)/.test(cs.overflowY) && el.scrollHeight > el.clientHeight + 1) break; el = el.parentElement; }
  const hb = h.getBoundingClientRect();
  if (!el || el === document.body) return { scroller: null, el: [hb.top, hb.bottom].map(Math.round) };
  const b = el.getBoundingClientRect();
  return { scroller: { top: Math.round(b.top), bottom: Math.round(b.bottom), scrollHeight: el.scrollHeight, clientHeight: el.clientHeight, hiddenBelow: el.scrollHeight - el.clientHeight - el.scrollTop, cls: String(el.className).slice(0, 120) }, el: [hb.top, hb.bottom].map(Math.round) };
}, text);
const till = S.till;
return { thai: await S.scrollOf(till, 'Thai'), thaiProof: await S.scrollOf(till, 'Proof required — verify now') };

S.W='1680x1050'; S.pfx='06'; S.pay=true;
// args: S.W, S.pfx, S.pay (true: take the payment in cash) ; the ticket list with a ticket in the order is on screen
S.phase = `3: the payment screen, ${S.W}`;
const { expect } = S;
const till = S.till;
await S.unlock('till');
const pfx = S.pfx;
const r = { pics: [] };
const cust = async () => S.flat(await S.customerHalf(till).innerText().catch(() => ''));
const pleasePay = t => (t.match(/Please pay\s*฿[0-9,]+(?:\.[0-9]+)?/) ?? [null])[0];
const shoot = async (n) => { const pic = `${pfx}${n}-${S.W}-split-${n.slice(1)}.png`; await S.shot(till, pic); r.pics.push(pic); return pic; };
await till.getByRole('button', { name: 'Done Adding', exact: true }).click().catch(async () => { await till.getByRole('button', { name: /^Pay ฿/ }).first().click(); });
await expect(S.paymentStep(till)).toBeVisible({ timeout: 45000 });
const sale = await S.saleWritten(`ticket-sale-${S.W}`);
S.lastSale = sale.id;
await till.waitForTimeout(2500);
r.amountDue = await S.amountDue(till);
r.methods = {};
for (const m of ['Cash', 'Card', 'PromptPay']) r.methods[m] = await S.boxOf(till, m, { within: '[data-testid="payment-step"]' });
r.customerAtMethods = { pleasePay: pleasePay(await cust()), dotZeroZero: /\.00/.test(await cust()) };
r.fitMethods = await S.fit(till, '[data-testid="payment-step"]');
let pic = `${pfx}a-${S.W}-split-payment-methods-cash-card-promptpay.png`; await S.shot(till, pic); r.pics.push(pic);
// Cash: Back and Confirm at the window's foot while the tender scrolls above them
await till.getByRole('heading', { name: 'Cash', exact: true }).first().click();
const confirm = till.getByRole('button', { name: 'Confirm Payment Received', exact: true });
await expect(confirm).toBeVisible({ timeout: 20000 });
await till.waitForTimeout(1500);
const footRead = () => till.evaluate(() => {
  const step = document.querySelector('[data-testid="payment-step"]');
  const btns = [...step.querySelectorAll('button')];
  const back = btns.find(b => b.innerText.trim() === 'Back');
  const conf = btns.find(b => b.innerText.trim() === 'Confirm Payment Received');
  let sc = step; while (sc && sc !== document.body) { const cs = getComputedStyle(sc); if (/(auto|scroll)/.test(cs.overflowY) && sc.scrollHeight > sc.clientHeight + 1) break; sc = sc.parentElement; }
  const box = e => { if (!e) return null; const b = e.getBoundingClientRect(); return [Math.round(b.left), Math.round(b.top), Math.round(b.width), Math.round(b.height)]; };
  const foot = conf?.parentElement; const fcs = foot ? getComputedStyle(foot) : null;

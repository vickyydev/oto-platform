S.phase = 'harness: black out the credit-grant QR code drawn on 20b (a solid box over the saved picture); QR svgs masked from now on';
const { readFileSync } = await import('node:fs');
const file = S.resolve(S.out, '20b-ordinary-sale-paid-till-and-display.png');
const buf = readFileSync(file);
const page = await S.browser.newPage({ viewport: { width: 400, height: 300 } });
await page.setContent(`<html><body style="margin:0"><img id="i" src="data:image/png;base64,${buf.toString('base64')}"></body></html>`);
const size = await page.evaluate(() => new Promise(r => { const i = document.getElementById('i'); const f = () => r([i.naturalWidth, i.naturalHeight]); if (i.complete) f(); else i.onload = f; }));
await page.setViewportSize({ width: size[0], height: size[1] });
// the QR sits in the till picture's Credit Grants card, about x 780-835, y 568-625 of this sheet
await page.evaluate(() => { const b = document.createElement('div'); Object.assign(b.style, { position: 'absolute', left: '772px', top: '560px', width: '72px', height: '72px', background: '#18181b' }); document.body.appendChild(b); });
await page.screenshot({ path: file, clip: { x: 0, y: 0, width: size[0], height: size[1] } });
await page.close();
const prev = S.masks;
S.masks = p => [...prev(p), p.locator('svg:not(.lucide)')];
S.receipt.odd.push({ what: 'the credit-grant QR code on 20b was blacked out on the saved picture; svg QR codes are masked from then on' }); S.save();
return { size };

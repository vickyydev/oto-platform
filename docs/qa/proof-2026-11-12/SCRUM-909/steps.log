  const res = performance.getEntriesByType('resource').map(e => e.name).filter(n => /NotoSansThai/i.test(n));
  const heads = [];
  for (const u of res) { const r = await fetch(u, { method: 'GET', cache: 'no-store' }); heads.push({ url: new URL(u).origin + new URL(u).pathname, status: r.status, type: r.headers.get('content-type'), bytes: (await r.arrayBuffer()).byteLength }); }
  const stack = getComputedStyle(document.body).fontFamily;
  // a Thai string on the customer half
  const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
  let thai = null; while (walker.nextNode()) { if (/[฀-๿]{3,}/.test(walker.currentNode.nodeValue || '')) { thai = walker.currentNode.parentElement; break; } }
  if (thai) thai.setAttribute('data-zz-thai', '1');
  return { faces, files: heads, bodyStack: stack, thaiSample: thai ? thai.textContent.trim().slice(0, 40) : null, thaiComputed: thai ? getComputedStyle(thai).fontFamily : null, check: document.fonts.check('16px "Till Thai"', 'ก') };
});
page.cdp = await S.fontFacts(till, '[data-zz-thai]');
await till.evaluate(() => document.querySelector('[data-zz-thai]')?.removeAttribute('data-zz-thai'));
S.receipt.reads.p6 = { font: page };
return page;

S.phase = 'probe: camera without a grant';
const ctx = await S.browser.newContext({ baseURL: S.pos });
const page = await ctx.newPage();
await page.goto(S.pos + '/display');
const r = await page.evaluate(async () => {
  const out = {};
  try { out.perm = (await navigator.permissions.query({ name: 'camera' })).state; } catch (e) { out.perm = 'query failed ' + e.name; }
  try { out.devices = (await navigator.mediaDevices.enumerateDevices()).map(d => d.kind); } catch (e) { out.devices = 'failed ' + e.name; }
  try { const s = await navigator.mediaDevices.getUserMedia({ video: true }); out.gum = 'granted'; s.getTracks().forEach(t => t.stop()); } catch (e) { out.gum = e.name; }
  return out;
});
await ctx.close();
return r;

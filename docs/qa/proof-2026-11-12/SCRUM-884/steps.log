await S.unlock('till');
const r = { pics: [] };
const pic = async n => { await S.shot(till, n); r.pics.push(n); };
const cust = async () => S.flat(await S.customerHalf(till).innerText().catch(() => ''));
const staff = async () => S.flat(await till.locator('div[class^="w-1/2 h-full"]').first().innerText().catch(() => ''));
const money = t => S.money(t);
await till.goto('/'); await till.waitForTimeout(2000);
await S.toggleDisplay(till, true).catch(() => {});
await till.locator('nav').getByRole('button', { name: S.stationName, exact: true }).click();
await till.waitForTimeout(2000);
const guest = till.getByRole('button', { name: /continue as guest/i });
if (await guest.count()) await guest.first().click();
await till.waitForTimeout(1000);
const search = till.getByPlaceholder(/Search/).first();
if (await search.count()) await search.fill(S.itemSearch);
await till.waitForTimeout(1000);
await till.getByText(new RegExp(S.item, 'i')).first().click();
await till.waitForTimeout(1500);
// a size/variant sheet, when the item has one
const sheetAdd = till.getByRole('dialog').getByRole('button', { name: /^Add/ });
if (await sheetAdd.count()) { await sheetAdd.first().click(); await till.waitForTimeout(800); }
const charge = till.getByRole('button', { name: /^Charge ฿/ });
await expect(charge).toBeEnabled({ timeout: 20000 });
r.whole = { charge: S.flat(await charge.innerText()), staffMoney: money(await staff()), customerMoney: money(await cust()) };
await pic(`${S.pfx}a-1440x900-split-${S.tag}-whole-baht-cart.png`);
// the code
const promo = till.getByPlaceholder(/Promo code/i).first();
r.promoInputs = await till.getByPlaceholder(/Promo code/i).count();
await promo.fill(S.CODE);
await till.getByRole('button', { name: 'Apply', exact: true }).first().click();
await till.waitForTimeout(2500);
r.coded = { charge: S.flat(await charge.innerText()), staffMoney: money(await staff()), customerMoney: money(await cust()), badge: (S.flat(await staff()).match(new RegExp(S.CODE + '[^฿]{0,40}[−-]?฿[0-9,.]+')) ?? [null])[0] };
r.coded.staffText = (await staff()).slice(0, 700);
r.coded.customerText = (await cust()).slice(0, 500);
await pic(`${S.pfx}b-1440x900-split-${S.tag}-code-applied-cart.png`);
await charge.click();
await till.waitForTimeout(1200);
const dialog = till.getByRole('dialog').last();
if (S.digits && await dialog.count()) {
  for (const d of S.digits) await dialog.getByRole('button', { name: d, exact: true }).click();
  await till.waitForTimeout(500);
  r.coded.continueLabel = S.flat(await dialog.getByRole('button', { name: /^Continue to Payment/ }).innerText());
  r.coded.dialogMoney = money(await dialog.innerText());
  await pic(`${S.pfx}c-1440x900-split-${S.tag}-pickup-code-continue-to-payment.png`);
  await dialog.getByRole('button', { name: /^Continue to Payment/ }).click();
}
await till.waitForTimeout(3000);
r.coded.payment = { staffMoney: money(await staff()), customerMoney: money(await cust()), amountDue: (S.flat(await staff()).match(/Amount due\s*฿[0-9,.]+/) ?? [null])[0], customerText: (await cust()).slice(0, 400) };
await pic(`${S.pfx}d-1440x900-split-${S.tag}-payment-amount-due.png`);
// pay it in cash: 160 received
await till.getByRole('button', { name: /^Cash / }).first().click();
await till.waitForTimeout(800);
const received = till.locator('#payment-cash-received');
if (await received.count()) { await received.fill(S.cashIn); await till.waitForTimeout(800); }
r.coded.cash = { staffMoney: money(await staff()), customerMoney: money(await cust()), staffTail: (await staff()).slice(-400) };
await pic(`${S.pfx}e-1440x900-split-${S.tag}-cash-tender.png`);
const fin = till.waitForResponse(x => /\/api\/sales\/[^/]+\/finalise$/.test(new URL(x.url()).pathname), { timeout: 45000 });
await till.getByRole('button', { name: /^(Record|Confirm)/ }).first().click();
const f = await fin;
const saleId = new URL(f.url()).pathname.split('/')[3];
S.knownSales.add(saleId);
S.receipt.created.push({ kind: `${S.tag}-satang-sale`, id: saleId }); S.save();
await till.waitForTimeout(3500);
r.coded.done = { staffMoney: money(await staff()), customerMoney: money(await cust()), staffText: (await staff()).slice(0, 400) };
await pic(`${S.pfx}f-1440x900-split-${S.tag}-paid.png`);
const s = await S.sale(saleId);
r.sale = { id: saleId, status: s.sale.status, receipt: s.sale.receiptNumber, gross: s.sale.totals.grossSatang / 100, discount: (s.discounts ?? []).map(d => `${d.code ?? d.label} ${d.amountSatang / 100}`), total: (s.sale.totals.totalSatang ?? s.sale.totals.netSatang ?? null) / 100, totals: s.sale.totals };
r.fit = await S.fit(till);
r.fit.truncated = r.fit.truncated.filter(t => t.cw > 2 && !/proof till/.test(t.text));
r.fit.spill = r.fit.spill.filter(t => !/proof till/.test(t.text));
S.receipt.reads[`p9-${S.tag}`] = r; S.save();
return r;

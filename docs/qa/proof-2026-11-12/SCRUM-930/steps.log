const out = {};
const reg = S.receipt.created.find(i => i.kind === 'registration');
out.released = await S.releaseOwn(reg.id, reg.guardian);
out.regAfter = (await S.registration(reg.id)).children.map(c => ({ child: c.childName, status: c.status }));
const mgr = await S.pw.request.newContext({ baseURL: S.pos });
const si = await mgr.post('/api/auth/sign-in', { data: { phone: S.need('STAGING_MANAGER_PHONE'), password: S.need('STAGING_MANAGER_PASSWORD') } });
out.mgrSignIn = si.status();
out.refunds = [];
for (const id of [S.ticketSale, S.dropSale]) {
  const s = await S.sale(id);
  S.assert.equal(s.sale.stationId ?? S.station.id, S.station.id);
  const res = await mgr.post(`/api/sales/${id}/refunds`, { headers: { 'idempotency-key': S.randomUUID() }, data: { mode: 'whole', reason: 'ZZ TEST SCRUM-930 proof cleanup' } });
  const b = await res.json().catch(() => null);
  out.refunds.push({ receipt: s.sale.receiptNumber, status: res.status(), code: b?.error?.code ?? null, message: res.status() >= 400 ? (b?.error?.message ?? null) : null, amount: b?.refund?.amountSatang != null ? b.refund.amountSatang / 100 : null });
}
const so = await mgr.post('/api/auth/sign-out', { headers: { 'idempotency-key': S.randomUUID() } });
out.mgrSignOut = { status: so.status(), me: (await mgr.get('/api/me')).status() };
await mgr.dispose();
const sales = await S.stationSales();
out.sales = sales.map(s => ({ receipt: s.receiptNumber, status: s.status, gross: s.totals.grossSatang / 100, refunded: (s.totals.refundedSatang ?? 0) / 100, refundStatus: s.refundStatus ?? null }));
S.receipt.cleanup.salesAndFamily = out;
return out;

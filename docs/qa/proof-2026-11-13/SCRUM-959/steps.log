=== 2026-11-12T21:46:38.962Z clean up: sales read-back, End of Day, member, code, sign-outs, till
S.phase = 'clean up: sales read-back, End of Day, member, code, sign-outs, till';
const out = {};
let sales = await S.stationSales();
for (const s of sales.filter(x => ['tendering', 'open'].includes(x.status))) {
  const r = await S.call('POST', `/sales/${s.id}/void`, { reason: 'ZZ TEST SCRUM-959 proof clean-up' });
  out.voidedAtCleanup = (out.voidedAtCleanup ?? []).concat({ id: s.id.slice(-6), status: r.status });
}
sales = await S.stationSales();
out.sales = sales.map(s => ({ receipt: s.receiptNumber, status: s.status, gross: s.totals.grossSatang / 100, refunded: (s.totals.refundedSatang ?? 0) / 100 }));
// End of Day: nothing of this till still open or part-paid
const eodOut = {};
for (const d of ['2026-11-12', '2026-11-13']) {
  const eod = await S.call('GET', `/branches/${S.branchId}/end-of-day?date=${d}`);
  const rows = eod.body?.openSales?.rows ?? null;
  eodOut[d] = { status: eod.status, openSalesOfThisTill: rows ? rows.filter(x => x.stationName === S.fixtureName).length : 'no openSales field', strandedOfThisRun: (eod.body?.stranded?.rows ?? eod.body?.stranded ?? []).filter?.(x => /ZZ TEST .*959/.test(x.childName ?? '')).length ?? null };
}
out.endOfDay = eodOut;
// the board: none of this run's families waiting or in the park
const board = await S.boardApi();
out.boardZz959 = board.families.filter(f => /ZZ TEST 959/.test(f.guardianName)).map(f => ({ guardian: f.guardianName, children: f.children.map(c => c.status) }));
// members on this run's numbers
out.members = [];
for (const [key, phone] of Object.entries(S.receipt.numbers)) {
  const m = (await S.call('GET', `/members/lookup?phone=${encodeURIComponent(phone)}`)).body?.member ?? null;
  if (m) {
    const named = `${m.nickname ?? ''} ${m.name ?? ''}`;
    if (named.includes('ZZ TEST')) { const d = await S.call('DELETE', `/members/${m.id}`); const after = (await S.call('GET', `/members/lookup?phone=${encodeURIComponent(phone)}`)).body?.member ?? null; out.members.push({ key, archived: d.status, lookupAfter: after ? 'still found' : 'gone' }); }
    else out.members.push({ key, member: 'found, not ZZ TEST named: left alone' });
  } else out.members.push({ key, member: null });
}
// the code
const row = (await S.call('GET', '/menu/discounts?includeArchived=true')).body.discounts.find(d => d.id === S.codeId);
S.assert.ok(row && row.code === S.CODE && /^ZZ TEST SCRUM-959/.test(row.label), 'only this run\'s own code');
const del = row.archivedAt ? null : (await S.call('DELETE', `/menu/discounts/${S.codeId}`)).status;
const after = (await S.call('GET', '/menu/discounts?includeArchived=true')).body.discounts.find(d => d.id === S.codeId);
out.code = { code: S.CODE, archive: del, archived: Boolean(after.archivedAt), active: after.active, usedCount: after.usedCount, inLiveList: (await S.call('GET', '/menu/discounts')).body.discounts.some(d => d.id === S.codeId) };
// sign the browser sessions out
out.signOuts = {};
for (const label of Object.keys(S.pages)) out.signOuts[label] = await S.signOut(label);
S.till = null; S.mgr = null; S.ph = null;
// retire the own till
S.assert.equal((await S.call('GET', `/stations/${S.station.id}`)).body.station.name, S.fixtureName);
out.devicesCleared = (await S.call('PATCH', `/stations/${S.station.id}`, { devices: [] })).status;
out.retired = (await S.call('DELETE', `/stations/${S.station.id}`)).status;
const st = (await S.call('GET', `/branches/${S.branchId}/stations?includeArchived=true`)).body.stations.find(s => s.id === S.station.id);
out.station = { archived: Boolean(st.archived), devices: st.devices.length };
const g = {};
for (const e of S.receipt.pageErrors) { const k = `${e.page} | ${e.kind} | ${e.text}`; g[k] = g[k] ?? { n: 0, at: [] }; g[k].n++; if (g[k].at.length < 2 && !g[k].at.includes(e.at)) g[k].at.push(e.at); }
S.receipt.pageErrorsGrouped = g;
Object.assign(S.receipt.cleanup, { sales: out.sales, voidedAtCleanup: out.voidedAtCleanup ?? [], endOfDay: out.endOfDay, boardAfter: out.boardZz959, members: out.members, code: out.code, signOutsFinal: out.signOuts, retire: { devicesCleared: out.devicesCleared, retired: out.retired }, station: out.station });
await S.admin.post('/api/auth/sign-out', { headers: { 'idempotency-key': S.randomUUID() } });
out.adminMe = (await S.admin.get('/api/me')).status();
S.receipt.cleanup.adminMe = out.adminMe;
S.receipt.finishedAt = new Date().toISOString();
S.save();
return { ...out, errors: g };

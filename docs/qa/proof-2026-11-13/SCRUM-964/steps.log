try { await expect.poll(async () => !/Regular Socks/i.test(await d.locator('body').innerText()) && /1040/.test(await d.locator('body').innerText()), { timeout: 30000, intervals: [200] }).toBe(true); ok = true; } catch {}
r.socksOff = { displayFollowed: ok, msToDisplay: ok ? Date.now() - t0 : null, step: S.flat(await S.paymentStep(till).innerText().catch(() => '')).slice(0, 300) };
await till.getByRole('heading', { name: 'PromptPay', exact: true }).first().click().catch(() => {});
await till.waitForTimeout(800);
reqs.length = 0;

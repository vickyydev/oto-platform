=== 2026-11-13T04:15:57.400Z clean-up 1: every own finalised sale on the two own ZZ TEST tills refunded whole by the staging manager (in the manager's till session); every own open sale voided; read back
S.phase = 'clean-up 1: every own finalised sale on the two own ZZ TEST tills refunded whole by the staging manager (in the manager\'s till session); every own open sale voided; read back';
const mgr = S.mgr;
await S.unlockShared('mgr');
const out = { refunds: [], voids: [], salesAfter: {} };
for (const st of [S.station, S.partyStation].filter(Boolean)) {
  for (const s of await S.stationSales(st)) {
    S.assert.equal(s.stationId, st.id);
    if (s.status === 'finalised') {
      const r = await mgr.evaluate(async (id) => {
        const actionId = crypto.randomUUID();
        const res = await fetch(`/api/sales/${id}/refunds`, { method: 'POST', credentials: 'include', headers: { 'content-type': 'application/json', 'idempotency-key': crypto.randomUUID(), 'x-oto-action-id': actionId },
          body: JSON.stringify({ mode: 'whole', reason: 'Service recovery', note: 'ZZ TEST SCRUM-964 proof clean-up', actionId }) });
        const b = await res.json().catch(() => null);
        return { status: res.status, refundStatus: b?.refundStatus ?? null, code: b?.error?.code ?? null, message: b?.error?.message ?? null };
      }, s.id);
      out.refunds.push({ receipt: s.receiptNumber, gross: (s.totals?.grossSatang ?? 0) / 100, ...r });
    } else if (['open', 'tendering'].includes(s.status)) {
      const v = await S.call('POST', `/sales/${s.id}/void`, { reason: 'ZZ TEST SCRUM-964 proof clean-up' });
      out.voids.push({ id: s.id.slice(-6), status: v.status, code: v.body?.error?.code ?? null });
    }
  }
  out.salesAfter[st.name] = (await S.stationSales(st)).map(s => `${s.receiptNumber ?? 'no receipt'} ${s.status} ${(s.totals?.grossSatang ?? 0) / 100}${s.refundStatus ? ' ' + s.refundStatus : ''}`);
}
S.receipt.cleanup.refunds = out.refunds; S.receipt.cleanup.voids = out.voids; S.receipt.cleanup.salesAfter = out.salesAfter; S.save();
return out;

S.phase = 'hunt: the 1440 split F&B category row: wheel, shift+wheel, keyboard';
const till = S.till;
await S.unlock('till');
await till.setViewportSize({ width: 1440, height: 900 });
await till.goto('/'); await till.waitForTimeout(1500);
await S.toggleDisplay(till, true).catch(() => {});
await till.locator('nav').getByRole('button', { name: 'F&B', exact: true }).click();
await till.waitForTimeout(2000);
const guest = till.getByRole('button', { name: /continue as guest/i });
if (await guest.count()) { await guest.first().click(); await till.waitForTimeout(1500); }
const rowSel = '[class*="@container/menu"] div[class*="overflow-x-auto"]';
const rowBox = await till.locator(rowSel).first().boundingBox();
const left = () => till.locator(rowSel).first().evaluate(e => e.scrollLeft);
const r = { rowBox };
await till.mouse.move(rowBox.x + rowBox.width / 2, rowBox.y + rowBox.height / 2);
await till.mouse.wheel(0, 400); await till.waitForTimeout(600);
r.afterVerticalWheel = await left();
await till.keyboard.down('Shift'); await till.mouse.wheel(0, 400); await till.keyboard.up('Shift'); await till.waitForTimeout(600);
r.afterShiftWheel = await left();
await till.locator(rowSel).first().evaluate(e => { e.scrollLeft = 0; });
await till.mouse.wheel(400, 0); await till.waitForTimeout(600);
r.afterSidewaysWheel = await left();
await till.locator(rowSel).first().evaluate(e => { e.scrollLeft = 0; });
// keyboard: focus Breakfast, then Tab along the row
await till.locator(rowSel).first().locator('button').first().focus();
for (let i = 0; i < 9; i++) await till.keyboard.press('Tab');
await till.waitForTimeout(500);
r.afterNineTabs = { scrollLeft: await left(), focused: await till.evaluate(() => document.activeElement?.innerText?.trim() ?? null) };
// a hint that the row scrolls: a fade, an arrow, a scrollbar
r.hint = await till.locator(rowSel).first().evaluate(e => { const cs = getComputedStyle(e); return { scrollbarPx: e.offsetHeight - e.clientHeight, scrollbarWidth: cs.scrollbarWidth, maskImage: cs.maskImage || cs.webkitMaskImage, siblings: [...e.parentElement.children].length }; });
// the drinks: how far to the right is Coffee
r.coffee = await till.evaluate((sel) => { const row = document.querySelector(sel); const b = [...row.querySelectorAll('button')].find(x => x.innerText.trim() === 'Coffee'); return b ? { offsetLeft: b.offsetLeft, rowWidth: row.clientWidth, screensAway: Math.round(b.offsetLeft / row.clientWidth * 10) / 10 } : null; }, rowSel);
await till.locator(rowSel).first().evaluate(e => { e.scrollLeft = 0; });
S.receipt.reads.huntRow = r; S.save();
return r;

  `  attempt ids of this run or of point 1 in the health answer: ${JSON.stringify(S.receipt.reads.p6api.ourIdsInHealth)}`,
  `the Console Health page: ${JSON.stringify(ph.cardText)}; ids of this run on the page: ${JSON.stringify(ph.ourIdsOnPage)}`,
  '',
  `GET /api/sales?branchId=<Central Floresta>&status=tendering -> ${r.listStatus}, ${r.tenderingSales} tendering sales; those holding an attempt in sent_to_terminal / unknown / inquiring:`,
  JSON.stringify(r.candidates, null, 1),
].join('\n');
await S.txtShot(text, '06c-api-health-pending-alert-after-run.png', 'Point 6: the payments-with-no-outcome alert after the sweeps');

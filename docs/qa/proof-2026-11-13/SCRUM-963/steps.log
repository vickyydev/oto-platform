S.pp = { tag: 'shop', pfx: '09', item: 'Merch Blue Emoji Toy', search: null, digits: null };
const { expect } = S;
// args: S.pp = { tag: 'shop' | 'fnb', pfx, item (exact name), search (or null), digits (F&B pickup code) }
const P = S.pp;
S.phase = `9: ${P.tag} at 1440x900 split: one item, ฿50 cash part paid, Save as partly paid: the dialog's words`;
const till = S.till;
await S.unlock('till');
const out = { pics: [] };
const pic = async n => { await S.shot(till, n); out.pics.push(n); };
await till.goto('/'); await till.waitForTimeout(1500);
await S.toggleDisplay(till, true).catch(() => {});
await till.locator('nav').getByRole('button', { name: P.tag === 'shop' ? 'Shop' : 'F&B', exact: true }).click();
await till.waitForTimeout(2500);
const guest = till.getByRole('button', { name: /continue as guest/i });
if (await guest.count()) { await guest.first().click(); await till.waitForTimeout(1500); }
if (P.tag === 'shop') await till.locator('[data-testid="category-row"]').getByRole('button', { name: 'All', exact: true }).click().catch(() => {});
if (P.search) { await till.getByPlaceholder(/Search/).first().fill(P.search); await till.waitForTimeout(1200); }
const tile = till.getByText(P.item, { exact: true }).first();
await tile.scrollIntoViewIfNeeded(); await tile.click(); await till.waitForTimeout(1500);
const sheetAdd = till.getByRole('dialog').getByRole('button', { name: /^Add/ });
if (await sheetAdd.count()) { await sheetAdd.first().click(); await till.waitForTimeout(800); }
const charge = till.getByRole('button', { name: /^Charge ฿/ });
await expect(charge).toBeEnabled({ timeout: 20000 });
out.charge = S.flat(await charge.innerText());
await charge.click();
await till.waitForTimeout(1500);
const dialog = till.getByRole('dialog').last();
if (P.digits && await dialog.count()) {
  for (const d of P.digits) await dialog.getByRole('button', { name: d, exact: true }).click();
  await till.waitForTimeout(500);
  await dialog.getByRole('button', { name: /^Continue to Payment/ }).click();
}
await till.waitForTimeout(3000);
await till.getByRole('button', { name: /^Cash / }).first().click();
await till.getByRole('button', { name: 'Partial payment', exact: true }).click();
await till.locator('#payment-part-amount').fill('50.00'); await till.locator('#payment-cash-received').fill('50.00'); await till.waitForTimeout(800);
await pic(`${P.pfx}a-1440x900-split-${P.tag}-partial-payment-50-cash.png`);
await till.getByRole('button', { name: /^Record/ }).first().click();
await till.getByTestId('item-part-paid').waitFor({ timeout: 45000 });
await till.waitForTimeout(2500);
const mine = (await S.stationSales()).find(s => !S.knownSales.has(s.id) && ['tendering', 'open', 'finalised'].includes(s.status));
if (mine) { S.knownSales.add(mine.id); P.saleId = mine.id; S.receipt.created.push({ kind: `${P.tag}-part-paid-sale`, id: mine.id }); S.save(); }
out.sale = mine ? { status: mine.status, gross: mine.totals?.grossSatang / 100, partPaid: mine.partPaid ?? null } : null;
await till.getByTestId('item-part-paid').getByRole('button', { name: 'Save as partly paid', exact: true }).click();
const dlg = till.getByTestId('item-part-paid-dialog');
await dlg.waitFor({ timeout: 10000 });
await till.waitForTimeout(600);
out.dialog = { title: S.flat(await dlg.getByRole('heading').first().innerText().catch(() => '')), words: S.flat(await dlg.locator('p').first().innerText().catch(() => '')), buttons: await dlg.getByRole('button').allInnerTexts() };
await pic(`${P.pfx}b-1440x900-split-${P.tag}-save-as-partly-paid-dialog-words.png`);
const db = await dlg.boundingBox();
await S.shot(till, `${P.pfx}c-1440x900-split-${P.tag}-dialog-close-up.png`, [], { clip: { x: db.x - 10, y: db.y - 10, width: db.width + 20, height: db.height + 20 } }); out.pics.push(`${P.pfx}c-1440x900-split-${P.tag}-dialog-close-up.png`);
await dlg.getByRole('button', { name: 'Save as partly paid', exact: true }).click();
await till.waitForTimeout(1500);
out.toast = S.flat(await till.locator('li[role="status"], [role="status"]').allInnerTexts().then(a => a.join(' | ')).catch(() => '')).slice(0, 200);
await pic(`${P.pfx}d-1440x900-split-${P.tag}-saved-counter-starts-a-new-${P.tag === 'shop' ? 'sale' : 'order'}.png`);

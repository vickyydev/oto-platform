S.phase = '6: what the platform health read and the alerts hold about payments with no outcome';
const r = { closedTill: await S.close('rec5') };
const h = await S.call('GET', '/ops/health');
r.healthStatus = h.status;
r.healthKeys = h.body ? Object.keys(h.body) : null;
const str = JSON.stringify(h.body ?? {});
r.mentionsPending = /payments\.pending|no outcome/i.test(str);
const ids = [S.HELD_ATTEMPT, S.p2.attempt, S.p4.attempt, S.receipt.hunt.doublePress.attempts[0]?.id, S.receipt.hunt.reload.start.attempt, S.receipt.hunt.phone.start.attempt, S.p5.attempt].filter(Boolean);
r.ourIdsInHealth = ids.filter(id => str.includes(id));
const find = (o, path = '') => { const hits = []; const walk = (v, p) => { if (!v || typeof v !== 'object') return; if (Array.isArray(v)) { v.forEach((x, i) => walk(x, `${p}[${i}]`)); return; } if (typeof v.category === 'string' && /payments/.test(v.category)) hits.push({ path: p, v }); if (typeof v.key === 'string' && /payments\.pending/.test(v.key)) hits.push({ path: p, v }); for (const [k, x] of Object.entries(v)) walk(x, `${p}.${k}`); }; walk(o, path); return hits; };
r.pendingAlerts = find(h.body).map(x => ({ path: x.path, key: x.v.key ?? null, subject: x.v.subject ?? x.v.title ?? null, summary: x.v.summary ?? null, status: x.v.status ?? x.v.state ?? null, branch: x.v.branchName ?? x.v.branchId ?? null, detail: x.v.detail ?? null, openedAt: x.v.openedAt ?? x.v.createdAt ?? null, resolvedAt: x.v.resolvedAt ?? null }));
const pa = await S.call('GET', '/platform/alerts');
r.platformAlertsStatus = pa.status;
r.platformAlerts = (pa.body?.alerts ?? pa.body?.items ?? []).filter(a => /payments/.test(a.category ?? a.key ?? '')).map(a => ({ key: a.key, subject: a.subject, summary: a.summary, status: a.status ?? a.state ?? null, detail: a.detail ?? null, openedAt: a.openedAt ?? a.createdAt ?? null, resolvedAt: a.resolvedAt ?? null, lastSeenAt: a.lastSeenAt ?? null }));
const runs = await S.call('GET', '/ops/runs?fingerprint=job:payments.pending&limit=5');
r.runs = runs.status === 200 ? (runs.body?.runs ?? []).map(x => ({ at: x.startedAt ?? x.at ?? x.createdAt, status: x.status ?? x.outcome ?? null, detail: x.detail ?? null })) : { status: runs.status, code: runs.body?.error?.code ?? null };
S.receipt.reads.p6api = r;
return r;

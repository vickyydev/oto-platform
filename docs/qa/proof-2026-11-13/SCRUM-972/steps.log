=== 2026-11-13T01:54:24.164Z 1b: the ordinary read of the held attempt; then the void of the held sale
S.phase = '1b: the ordinary read of the held attempt; then the void of the held sale';
const r = {};
const cmds0 = (await S.commands(S.box.id, 100)).filter(c => c.payload?.attemptId === S.HELD_ATTEMPT);
const devId = cmds0[0]?.payload?.deviceId ?? null;
const devs = await S.devicesOnBox(S.box.id);
const term = devs.find(d => d.id === devId);
r.terminalOfCommand = term ? { label: term.label, archived: Boolean(term.archived), transport: term.transport } : '(not on Virtual box 1)';
r.readAt = new Date().toISOString();
const a = await S.attempt(S.HELD_ATTEMPT);
r.read = { status: a.status, attemptStatus: a.body?.attempt?.status ?? null, route: a.body?.route ?? null, responseText: a.body?.responseText ?? null, outstanding: a.body?.outstandingSatang != null ? a.body.outstandingSatang / 100 : null, code: a.body?.error?.code ?? null, keys: a.body ? Object.keys(a.body) : null };
const s = await S.sale(S.HELD_SALE);
r.saleAfterRead = { status: s.sale.status, attempts: (s.attempts ?? []).map(x => ({ id: x.id, status: x.status, responseText: x.responseText ?? null })) };
const au = await S.audit(S.HELD_ATTEMPT);
r.audit = { status: au.status, entries: (au.body?.entries ?? []).map(e => ({ at: e.createdAt, action: e.action, before: e.before ?? null, after: e.after ?? null })) };
S.receipt.reads.p1read = r;
const text = [
  `GET /api/payments/attempts/${S.HELD_ATTEMPT}   (the till's ordinary read; signed-in admin session)   read ${r.readAt}`,
  `  -> HTTP ${r.read.status}`,
  `  attempt.status: ${r.read.attemptStatus}`,
  `  route: ${r.read.route}`,
  `  responseText: ${JSON.stringify(r.read.responseText)}`,
  `  outstanding: ฿${r.read.outstanding}`,
  '',
  `GET /api/sales/${S.HELD_SALE} right after`,
  `  sale.status: ${r.saleAfterRead.status}; attempts: ${JSON.stringify(r.saleAfterRead.attempts)}`,
  '',
  `GET /api/audit?entityType=payment_attempt&entityId=${S.HELD_ATTEMPT} -> HTTP ${r.audit.status}`,
  JSON.stringify(r.audit.entries, null, 1),
  '',
  `the command's terminal (payload.deviceId) on Virtual box 1: ${JSON.stringify(r.terminalOfCommand)}`,
].join('\n');
await S.txtShot(text, '01b-api-held-attempt-read-declined.png', 'Point 1: the ordinary read of the held attempt');
return r;

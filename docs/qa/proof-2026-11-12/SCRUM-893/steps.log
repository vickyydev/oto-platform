S.phase = 'clean up: credit grant of the ordinary sale, members on the numbers, displays, the two tills retired, sessions signed out';
const res = {};
const o = await S.sale(S.fam.O.sale);
res.ordinarySaleKeys = Object.keys(o);
const grantish = Object.fromEntries(Object.entries(o).filter(([k]) => /grant|credit|wallet|voucher/i.test(k)).map(([k, v]) => [k, JSON.stringify(v).slice(0, 300)]));
res.ordinaryGrants = grantish;
res.members = [];
for (const n of S.free.slice(0, 12)) {
  const m = (await S.call('GET', `/members/lookup?phone=${n}`)).body?.member ?? null;
  res.members.push({ n, member: m ? m.id : null });
}
res.displaysOpen = Object.keys(S.displays);
for (const label of Object.keys(S.displays)) await S.dropDisplay(label);
const createdDisplays = S.receipt.created.filter(x => x.kind === 'display');
res.displays = createdDisplays.map(dp => ({ label: dp.label, revoked: (S.receipt.cleanup.displays ?? []).some(c => c.id === dp.id && c.revoked) }));
res.sessions = [];
for (const label of Object.keys(S.pages)) res.sessions.push(await S.signOutPage(label));
res.stations = [];
for (const st of [S.station, S.phoneStation]) {
  const p = await S.call('PATCH', `/stations/${st.id}`, { devices: [] });
  const d = await S.call('DELETE', `/stations/${st.id}`);
  const back = (await S.call('GET', `/branches/${S.branchId}/stations?includeArchived=true`)).body.stations.find(s => s.id === st.id);
  res.stations.push({ id: st.id, patch: p.status, del: d.status, archived: back?.archived ?? null, devices: back?.devices?.length ?? null });
}
S.receipt.cleanup.rest = res; S.save();
return res;

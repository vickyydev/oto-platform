await S.walkIn(till, S.free[5]);
await S.ticket(till, 1, 1);
const sale = await S.saleWritten('p5-card-sale');
S.p5 = { sale: sale.id };
await expect(S.paymentStep(till)).toBeVisible({ timeout: 30000 });
await till.getByRole('heading', { name: 'Card', exact: true }).first().click();
const startResp = till.waitForResponse(rr => rr.request().method() === 'POST' && new URL(rr.url()).pathname === '/api/payments/attempts', { timeout: 30000 });
const t0 = Date.now();
await till.getByRole('button', { name: 'Start card payment', exact: true }).click();
const sr = await startResp; const sb = await sr.json().catch(() => null);
r.start = { status: sr.status(), route: sb?.route ?? null, attempt: sb?.attempt?.id ?? null, attemptStatus: sb?.attempt?.status ?? null };
S.p5.attempt = r.start.attempt;
r.paymentSuccessful = await till.getByText('Payment Successful', { exact: true }).waitFor({ timeout: 120000 }).then(() => true).catch(() => false);
r.secondsToPaid = Math.round((Date.now() - t0) / 100) / 10;
await till.waitForTimeout(2500);
await S.shot(till, '05a-till-card-paid-simulator.png', [till.locator('span.font-mono'), till.locator('img')]);
await expect.poll(async () => { const j = (await S.sale(sale.id)).printJobs ?? []; return j.length > 0 && j.every(x => ['printed', 'failed', 'skipped'].includes(x.status)); }, { timeout: 120000, intervals: [3000] }).toBe(true).catch(() => {});
await S.sleep(4000);
const s = await S.sale(sale.id);
r.sale = { receipt: s.sale.receiptNumber, status: s.sale.status, gross: s.sale.totals.grossSatang / 100, attempts: (s.attempts ?? []).map(a => ({ id: a.id, method: a.method, status: a.status, provider: a.provider ?? null })) };
r.printJobs = (s.printJobs ?? []).map(j => ({ kind: j.kind, status: j.status }));
const after = await S.printoutsFull(S.dev.receipt.id);
r.newReceiptPrintouts = after.printouts.filter(p => !seenKeys.includes(S.keyOf(p))).length;
// exactly one terminal_sale per attempt, the paid one and every refused one
const all = (await S.commands(S.box.id, 200)).filter(c => c.kind === 'terminal_sale');
const ids = { p5: S.p5.attempt, p2: S.p2.attempt, p4: S.p4.attempt, h2: S.receipt.hunt.doublePress.attempts[0]?.id, h3: S.receipt.hunt.reload.start.attempt, h4: S.receipt.hunt.phone.start.attempt };
r.saleCommandsPerAttempt = Object.fromEntries(Object.entries(ids).map(([k, id]) => [k, all.filter(c => c.payload?.attemptId === id && (c.payload?.mode ?? 'sale') === 'sale').map(c => ({ state: c.state, errorCode: c.errorCode ?? null, outcome: c.result?.outcome ?? null }))]));
r.commandsListed = all.length;
S.receipt.created.push({ kind: 'sale-card', id: sale.id, receipt: s.sale.receiptNumber }); S.save();
S.receipt.reads.p5 = r;
return r;

S.phase = '6: the release, read back through the api (audit trail, print record), never the database';
const from = '2026-11-12T13:05:00.000Z';
const audit = async (action) => {
  const r = await S.call('GET', `/audit?action=${encodeURIComponent(action)}&from=${from}&limit=200&count=true`);
  return { status: r.status, total: r.body?.total ?? null, entries: (r.body?.entries ?? []).map(e => ({ at: e.createdAt ?? e.at, bangkok: S.bkk(e.createdAt ?? e.at), branchIsFloresta: e.branchId === S.branchId, entityType: e.entityType, after: e.after ?? null })) };
};
const r = {};
r.scheduleStart = await audit('party.slips_schedule_start');
r.rebase = await audit('party.slips_rebase');
r.change = await audit('party.slips_change');
r.print = await audit('party.slips_print');
// every kitchen and bar job queued at the park since the platform release went live (13:11:38Z)
const jobs = (await S.call('GET', `/branches/${S.branchId}/print-jobs?limit=200`)).body?.jobs ?? [];
r.parkJobsSinceApi = jobs.filter(j => Date.parse(j.queuedAt) >= Date.parse('2026-11-12T13:11:00Z')).map(j => ({ bangkok: S.bkk(j.queuedAt), kind: j.kind, status: j.status }));
r.parkKitchenBarJobsSinceApi = r.parkJobsSinceApi.filter(j => /kitchen|bar/.test(j.kind));
const branches = (await S.call('GET', '/branches')).body.branches;
r.otherParks = [];
for (const b of branches) {
  if (b.id === S.branchId) continue;
  const jb = (await S.call('GET', `/branches/${b.id}/print-jobs?limit=200`));
  const ks = (jb.body?.jobs ?? []).filter(j => Date.parse(j.queuedAt) >= Date.parse('2026-11-12T13:11:00Z') && /kitchen|bar/.test(j.kind));
  r.otherParks.push({ park: b.name, status: jb.status, kitchenBarJobsSinceApi: ks.length });
}
(S.receipt.reads.release ??= []).push({ at: new Date().toISOString(), ...r });
return r;

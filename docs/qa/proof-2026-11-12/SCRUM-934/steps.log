S.receipt.pageErrorsGrouped = g;
S.receipt.cleanup.station = out.station; S.receipt.cleanup.boardAfter = out.boardZz934; S.receipt.cleanup.retire = { devicesCleared: out.devicesCleared, retired: out.retired };
S.receipt.cleanup.signOutsFinal = out.signOuts;
await S.admin.post('/api/auth/sign-out', { headers: { 'idempotency-key': S.randomUUID() } });
out.adminMe = (await S.admin.get('/api/me')).status();

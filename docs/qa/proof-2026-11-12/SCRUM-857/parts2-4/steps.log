// Staff present at the counter: a keydown on the till's window every 40 s keeps its 2-minute idle lock from closing
// the till while only the display is used (the hunt for the lock itself stops this first).
S.keepAlive = () => S.till.evaluate(() => window.dispatchEvent(new KeyboardEvent('keydown', { key: 'Shift' }))).catch(() => null);
clearInterval(S.alive);
S.alive = setInterval(S.keepAlive, 40000);
await S.keepAlive();
await S.unlock('till');
return { alive: true };

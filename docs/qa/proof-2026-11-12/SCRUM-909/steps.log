=== 2026-11-12T10:42:08.904Z clean up
S.phase = 'clean up';
const out = { registrations: [], sales: null, members: [], station: null };
// every own registration: release the children in the park, cancel anything still waiting and unpaid
for (const item of S.receipt.created.filter(i => i.kind === 'registration')) {
  let reg = await S.registration(item.id);
  S.assert.equal(reg.guardianName, item.guardian, 'only this run\'s own booking');
  S.assert.ok(S.isZz(reg.guardianName) && reg.children.every(c => S.isZz(c.childName)));
  const released = reg.children.some(c => c.status === 'in_park') ? await S.releaseOwn(item.id, item.guardian) : [];
  reg = await S.registration(item.id);
  let cancelled = null;
  if (reg.children.some(c => c.status === 'registered')) {
    const r = await S.call('POST', `/checkin/registrations/${item.id}/cancel`, { reason: 'ZZ TEST SCRUM-909 proof cleanup' });
    cancelled = r.status;
    reg = await S.registration(item.id);
  }
  out.registrations.push({ guardian: item.guardian, released, cancelled, children: reg.children.map(c => c.status) });
}
// sales at the own till: none left open; read back
let sales = await S.stationSales();
for (const s of sales.filter(x => ['tendering', 'open'].includes(x.status))) {
  const r = await S.call('POST', `/sales/${s.id}/void`, { reason: 'ZZ TEST SCRUM-909 proof cleanup' });
  out.voidedAtCleanup = (out.voidedAtCleanup ?? []).concat(r.status);
}
sales = await S.stationSales();
out.sales = sales.map(s => ({ receipt: s.receiptNumber, status: s.status, gross: s.totals.grossSatang / 100, refunded: (s.totals.refundedSatang ?? 0) / 100 }));
// print jobs of the finalised sales all printed
out.printJobs = {};
for (const s of sales.filter(x => x.status === 'finalised')) out.printJobs[s.receiptNumber] = (await S.sale(s.id)).printJobs.map(j => j.status);
// members made for the test numbers
for (const [key, phone] of Object.entries(S.receipt.numbers)) {
  const m = (await S.call('GET', `/members/lookup?phone=${encodeURIComponent(phone)}`)).body?.member ?? null;
  if (m) {
    S.assert.ok(`${m.nickname ?? ''} ${m.name ?? ''}`.includes('ZZ TEST'), 'only own named test members');
    const d = await S.call('DELETE', `/members/${m.id}`);
    const after = (await S.call('GET', `/members/lookup?phone=${encodeURIComponent(phone)}`)).body?.member ?? null;
    out.members.push({ key, archived: d.status, lookupAfter: after ? 'still found' : null });
  } else out.members.push({ key, member: null });
}
S.receipt.cleanup.registrations = out.registrations; S.receipt.cleanup.sales = out.sales; S.receipt.cleanup.members = out.members; S.receipt.cleanup.printJobs = out.printJobs;
return out;

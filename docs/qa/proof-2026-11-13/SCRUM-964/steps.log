S.assert.match(S.bizDate, /^\d{4}-\d{2}-\d{2}$/);
const ev0 = (await S.call('GET', `/events?branchId=${S.branchId}&type=party`)).body;
for (const e of ev0?.events ?? []) if (!S.isZz(e.title)) S.hidden.push(String(e.title).trim());
S.menu = (await S.call('GET', `/branches/${S.branchId}/menu`)).body;
await S.openApp();
const prod = code => S.menu.products.find(p => p.code === code && p.active && !p.archivedAt);
S.prods = { calamari: prod('CF-14'), hummus: prod('CF-13'), fries: prod('CF-11'), water: prod('CF-65-6') };

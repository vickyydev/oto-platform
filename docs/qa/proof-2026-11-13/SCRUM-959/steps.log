S.phase = 'clean up: the manager refunds the paid sales; Nok cancelled';
const mgr = S.mgr;
await S.unlock('mgr');
const out = { refunds: [] };
for (const s of (await S.stationSales()).filter(x => x.status === 'finalised')) {
  S.assert.equal(s.stationId, S.station.id);
  const r = await mgr.evaluate(async (id) => {
    const actionId = crypto.randomUUID();
    const res = await fetch(`/api/sales/${id}/refunds`, { method: 'POST', credentials: 'include', headers: { 'content-type': 'application/json', 'idempotency-key': crypto.randomUUID(), 'x-oto-action-id': actionId },
      body: JSON.stringify({ mode: 'whole', reason: 'Service recovery', note: 'ZZ TEST SCRUM-959 proof clean-up', actionId }) });
    const b = await res.json().catch(() => null);
    return { status: res.status, refundStatus: b?.refundStatus ?? null, code: b?.error?.code ?? null };
  }, s.id);
  out.refunds.push({ receipt: s.receiptNumber, gross: s.totals?.grossSatang / 100, ...r });
}
let reg = await S.registration(S.fam.H.reg);
S.assert.equal(reg.guardianName, S.GH);
const waiting = reg.children.filter(c => c.status === 'registered');
S.assert.ok(waiting.every(c => S.isZz(c.childName)));
if (waiting.length) { const c = await S.call('POST', `/checkin/registrations/${S.fam.H.reg}/cancel`, { reason: 'ZZ TEST SCRUM-959 proof clean-up', checkinIds: waiting.map(w => w.id) }); out.cancel = { status: c.status, code: c.body?.error?.code ?? null }; }
reg = await S.registration(S.fam.H.reg);
out.children = reg.children.map(x => `${x.childName}: ${x.status}`);
S.receipt.cleanup.refunds = out.refunds; S.receipt.cleanup.family.cancelAfterRefund = out.cancel ?? null; S.receipt.cleanup.family.childrenAfter = out.children; S.save();
return out;

const r = {};
if (!(await till.getByRole('heading', { name: 'Tourist', exact: true }).first().isVisible().catch(() => false))) await till.getByRole('button', { name: 'Show all rates', exact: true }).first().click();
await till.getByRole('heading', { name: 'Tourist', exact: true }).first().click();
await till.getByRole('heading', { name: 'Add to Sale', exact: true }).waitFor({ timeout: 20000 });
await till.waitForTimeout(1500);
// the ticket list
r.list = await till.evaluate(() => {
  const h = [...document.querySelectorAll('h2,h1')].find(e => e.innerText.trim() === 'Add to Sale');
  const step = h.closest('[class*="@container/step"]') ?? h.parentElement.parentElement;
  const sb = step.getBoundingClientRect();
  const cards = [...step.querySelectorAll('h3')].map(x => { const c = x.closest('[class*="cursor-pointer"]') ?? x.closest('button') ?? x.parentElement; const b = c.getBoundingClientRect(); return { name: x.innerText.trim(), left: Math.round(b.left), top: Math.round(b.top), width: Math.round(b.width), height: Math.round(b.height) }; });
  const rows = [...new Set(cards.map(c => c.top))].length;
  return { stepWidth: Math.round(sb.width), cards, oneARow: cards.length > 0 && new Set(cards.map(c => c.left)).size === 1, rows };
});
r.addDropOff = await S.boxOf(till, 'Add drop-off child');
r.doneAdding = await S.boxOf(till, 'Done Adding');
r.fitList = await S.fit(till);
await S.shot(till, `${pfx}a-${S.W}-split-tourist-ticket-list.png`);
// 1 Hour Play: the configure step with its add-ons
await till.getByRole('heading', { name: '1 Hour Play', exact: true }).first().click();
await till.waitForTimeout(1500);
await S.quantity(till, 'Kids', 1); await S.quantity(till, 'Adults', 1);
await till.waitForTimeout(1200);
r.captions = await till.evaluate(() => {
  const out = [];
  for (const lab of ['Kids', 'Adults']) {
    const add = document.querySelector(`button[aria-label="Add one ${lab}"]`);
    if (!add) { out.push({ lab, found: false }); continue; }
    let card = add.parentElement; while (card && !/rounded/.test(card.className)) card = card.parentElement;
    const texts = [...card.querySelectorAll('*')].filter(e => e.children.length === 0 && (e.innerText || '').trim()).map(e => ({ t: e.innerText.trim(), whole: e.scrollWidth <= e.clientWidth + 1, b: e.getBoundingClientRect() }));
    const cb = card.getBoundingClientRect();
    out.push({ lab, card: [cb.left, cb.top, cb.width, cb.height].map(Math.round), texts: texts.map(x => ({ t: x.t, whole: x.whole, inside: x.b.left >= cb.left - 1 && x.b.right <= cb.right + 1 })) });
  }
  return out;
});
r.addons = await till.evaluate(() => {
  const grid = document.querySelector('[class*="@container/addons"] > div');
  if (!grid) return null;
  const gb = grid.getBoundingClientRect();
  const cards = [...grid.children].map(c => {
    const b = c.getBoundingClientRect();
    const name = c.querySelector('.font-medium.text-lg');
    const oos = [...c.querySelectorAll('*')].find(e => e.children.length === 0 && /Out of stock/i.test(e.innerText || ''));
    const ob = oos?.getBoundingClientRect();
    const lh = oos ? parseFloat(getComputedStyle(oos).lineHeight) || 16 : null;
    return { name: name?.innerText.trim() ?? null, nameWhole: name ? name.scrollWidth <= name.clientWidth + 1 : null, nameEndsDots: name ? /(\.\.|…)$/.test(name.innerText.trim()) : null,
      left: Math.round(b.left), top: Math.round(b.top), width: Math.round(b.width),
      outOfStock: oos ? { text: oos.innerText.trim(), lines: Math.round(ob.height / lh), height: Math.round(ob.height) } : null, text: c.innerText.replace(/\s+/g, ' ').trim().slice(0, 100) };
  });
  return { gridWidth: Math.round(gb.width), cards, oneARow: new Set(cards.map(c => c.left)).size === 1 };
});
r.addAnother = await S.boxOf(till, 'Add Another Ticket');
r.continue = await S.boxOf(till, 'Continue');
r.fitConfig = await S.fit(till);
await S.shot(till, `${pfx}b-${S.W}-split-1-hour-play-addons-and-buttons.png`);
// scroll the column to show the add-ons and the buttons at the foot
await till.getByRole('button', { name: 'Add Another Ticket', exact: true }).scrollIntoViewIfNeeded().catch(() => {});
await till.waitForTimeout(500);
await S.shot(till, `${pfx}c-${S.W}-split-addons-scrolled-to-the-buttons.png`);
for (const k of ['fitList', 'fitConfig']) r[k].truncated = r[k].truncated.filter(t => t.cw > 2);
S.receipt.reads[`tickets-${S.W}`] = r; S.save();
return r;

S.phase = '2: a second ZZ TEST till for the simulator card sale (the first is blocked by the stuck attempt)';
const { expect } = S;
const r = {};
const stations = (await S.call('GET', `/branches/${S.branchId}/stations?includeArchived=true`)).body.stations;
const prefix = Array.from({ length: 99 }, (_, i) => `Z952${String(i + 1).padStart(2, '0')}`).find(p => !stations.some(s => s.codePrefix === p));
const name = 'ZZ TEST 952 card till';
S.assert.ok(!stations.some(s => s.name === name && !s.archived));
const devices = [['receipt', 'receipt'], ['kids_band', 'band'], ['adult_band', 'band'], ['card_terminal', 'card']].map(([role, key]) => ({ role, deviceId: S.dev[key].id }));
const made = await S.call('POST', `/branches/${S.branchId}/stations`, { name, kind: 'till', boxId: S.box.id, codePrefix: prefix, accessScope: 'all_staff', paymentRouting: { card: 'card_terminal', qr: 'none' }, capabilities: [], devices });
r.create = { status: made.status, code: made.body?.error?.code ?? null, roles: S.rolesOf(made.body?.station) };
S.assert.equal(made.status, 200);
S.station2 = { id: made.body.station.id, name, prefix };
S.receipt.created.push({ kind: 'station', id: S.station2.id, name, prefix }); S.save();
const createdAt = Date.now();
// two heartbeats of the box after the station exists, so its bundle carries the station and its terminal
let beats = 0, last = null;
await expect.poll(async () => {
  const b = (await S.call('GET', `/branches/${S.branchId}/boxes`)).body.boxes.find(x => x.id === S.box.id);
  const at = Date.parse(b.lastHeartbeatAt ?? 0);
  if (at > createdAt + 2000 && at !== last) { beats += 1; last = at; }
  return beats;
}, { timeout: 240000, intervals: [5000] }).toBeGreaterThanOrEqual(2);
r.heartbeatsAfter = beats;
r.waitedS = Math.round((Date.now() - createdAt) / 1000);
return r;

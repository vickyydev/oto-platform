=== 2026-11-12T11:39:47.723Z harness: mask the credit-grant QR codes on 10b (drawn over the saved picture) and mask QR svgs from now on
S.phase = 'harness: mask the credit-grant QR codes on 10b (drawn over the saved picture) and mask QR svgs from now on';
const { readFileSync, writeFileSync } = await import('node:fs');
const file = S.resolve(S.out, '10b-ordinary-sale-paid-cash.png');
const b64 = readFileSync(file).toString('base64');
const page = await S.browser.newPage({ viewport: { width: 1680, height: 1050 } });
const out = await page.evaluate(async (src) => {
  const img = new Image(); img.src = src; await img.decode();
  const c = document.createElement('canvas'); c.width = img.width; c.height = img.height;
  const x = c.getContext('2d'); x.drawImage(img, 0, 0); x.fillStyle = '#18181b';
  x.fillRect(466, 620, 72, 72); x.fillRect(982, 662, 78, 78);
  return c.toDataURL('image/png').split(',')[1];
}, 'data:image/png;base64,' + b64);
await page.close();
writeFileSync(file, Buffer.from(out, 'base64'));
const oldMasks = S.masks;
S.masks = p => [...oldMasks(p), p.locator('svg:not(.lucide)')];
return { ok: true };

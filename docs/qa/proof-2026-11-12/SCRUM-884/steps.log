  return { cards: out, column: col ? { scrollH: col.scrollHeight, clientH: col.clientHeight, scrolls: col.scrollHeight > col.clientHeight + 1, top: col.scrollTop } : null };
});
await S.shot(till, `${pfx}b-${S.W}-split-show-all-rates-three-cards.png`);

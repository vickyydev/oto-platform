r.edit = await S.editThroughForm({ key: 'receipt', change: async f => { await f.getByLabel(/^Address/).fill('192.0.2.73:9100'); },
  formPic: '01a-console-edit-receipt-printer-address-only-form.png', afterPic: '01c-console-receipt-printer-row-after-address-save.png' });
S.dev.receipt.address = r.edit.after.address;
// point 8b: straight after the save
r.rightAfterApi = await S.apiReadings('receipt printer: straight after its address was changed');
r.rightAfterTill = await S.stationPrinterReadings();
r.rightAfterHealth = await S.consoleHealth(c, '08b1-console-health-zz-printers-right-after-receipt-address-change.png');
const sent = r.edit.requests;
const text = [
  `ZZ TEST 971 receipt printer, Virtual box 1 (Central Floresta); Console ${S.CONSOLE}; ${new Date().toISOString()}`,
  '',
  `The row before:   address ${r.edit.before.address}   model ${r.edit.before.model}   protocol ${r.edit.before.protocol}   settings ${JSON.stringify(r.edit.before.settings)}`,
  `The form showed:  ${JSON.stringify(r.edit.shownInForm)}`,
  'Typed: the address only, 192.0.2.73:9100. Pressed Save.',
  '',
  `Requests the page sent to PATCH /api/devices/<id> (captured in the browser): ${sent.length}`,
  ...sent.map(s => `  ${s.method} ${s.path}\n  body: ${s.body}`),
  `Answer: ${JSON.stringify(r.edit.response)}`,
  `Form still open after Save: ${r.edit.formStillOpen}`,
  '',
  `Read back (GET /api/boxes/<Virtual box 1>/devices): address ${r.edit.after.address}   settings ${JSON.stringify(r.edit.after.settings)}   model ${r.edit.after.model}   protocol ${r.edit.after.protocol}`,
  `Reading straight after: ${JSON.stringify(r.edit.after.reading)}`,
].join('\n');
await S.txtShot(text, '01b-console-edit-receipt-printer-address-only-request.png', 'Point 1: the body of PATCH /api/devices/<ZZ receipt printer> after changing only the address');
r.p1a = { exactlyAddress: sent.length === 1 && sent[0].body === JSON.stringify({ address: '192.0.2.73:9100' }), settingsNull: r.edit.after.settings === null, addressSaved: r.edit.after.address === '192.0.2.73:9100' };
S.receipt.reads.p1a = r;
return r;

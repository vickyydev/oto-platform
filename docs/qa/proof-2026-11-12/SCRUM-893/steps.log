S.phase = 'read-back picture, then sign the admin out';
const rows = [];
for (const [fam, v] of Object.entries(S.fam)) {
  if (v.reg) { const r = await S.registration(v.reg); rows.push([`registration ${fam}`, r.children.map(c => `${c.childName}: ${c.status}`).join(', ')]); }
  if (v.sale) { const s = await S.sale(v.sale); rows.push([`sale ${fam}`, `${s.sale.receiptNumber} ${s.sale.status} refund ${s.refundStatus} refundable ${s.refundableSatang}`]); }
}
const st = (await S.call('GET', `/branches/${S.branchId}/stations?includeArchived=true`)).body.stations.filter(s => [S.station.id, S.phoneStation.id].includes(s.id));
for (const s of st) rows.push([`till ${s.codePrefix}`, `archived ${s.archived}, devices ${s.devices.length}`]);
rows.push(['displays', (S.receipt.cleanup.displays ?? []).map(d => `${d.label}: revoked`).join(', ')]);
rows.push(['members on own numbers', (S.receipt.cleanup.members ?? []).map(m => `${m.n} archived (lookup ${m.afterLookup ?? 'none'})`).join('; ')]);
rows.push(['sessions', (S.receipt.cleanup.sessions ?? []).map(x => `${x.label} ${x.before}->${x.after}`).join(', ')]);
rows.push(['credit wallet of the ordinary sale', 'active ฿350 after the whole refund (ticket give-back credit is kept by rule OD-W4), expires 05:00 Bangkok 13 Nov']);
await S.facts('99-cleanup-read-back.png', 'SCRUM-893 family form lane proof — clean-up read back', rows);
const out = await S.admin.post('/api/auth/sign-out', { headers: { 'idempotency-key': S.randomUUID() } });
const me = (await S.admin.get('/api/me')).status();
S.receipt.cleanup.admin = { signOut: out.status(), me }; S.receipt.finishedAt = new Date().toISOString(); S.save();
return { rows, admin: S.receipt.cleanup.admin, pageErrors: S.receipt.pageErrors.length, pageErrorKinds: [...new Set(S.receipt.pageErrors.map(e => `${e.page} ${e.kind} ${e.text}`.slice(0, 140)))].slice(0, 25) };

S.heldRead = pg => pg.evaluate(() => {
  const nav = [...document.querySelectorAll('nav')].find(n => /Tickets/.test(n.innerText) && /F&B/.test(n.innerText));
  const inertUp = el => { for (let e = el; e; e = e.parentElement) if (e.inert || e.hasAttribute?.('inert')) return true; return false; };
  const tabs = nav ? [...nav.querySelectorAll('button, a')].filter(b => b.getBoundingClientRect().width > 0) : [];
  const back = [...document.querySelectorAll('button')].filter(b => /^\s*Back\s*$/.test(b.innerText) && b.getBoundingClientRect().width > 0 && !b.closest('[role="dialog"]')).at(-1);

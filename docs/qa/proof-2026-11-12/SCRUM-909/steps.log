S.phase = '6: Thai — the PromptPay tile at a 576-pixel payment panel';
const till = S.till;
const width = () => till.evaluate(() => Math.round(document.querySelector('[data-testid="payment-step"]').getBoundingClientRect().width * 10) / 10);
const at1680 = await width();
let vw = 1680, w = at1680;
for (let i = 0; i < 8 && Math.abs(w - 576) > 0.5; i++) {
  // the panel grows half as fast as the window in the split view
  vw = Math.round(vw + (576 - w) * 2);
  await till.setViewportSize({ width: vw, height: 1050 });
  await till.waitForTimeout(700);
  w = await width();
}
const measure = () => till.evaluate(() => {
  const tiles = [...document.querySelectorAll('[data-testid="payment-step"] h3')].filter(h => h.closest('[class*="cursor-pointer"]'));
  return tiles.map(h => {
    const range = document.createRange(); range.selectNodeContents(h);

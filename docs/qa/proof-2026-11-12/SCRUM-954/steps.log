for (const fam of ['D', 'C']) {
  await ph.goto('/history'); await ph.waitForTimeout(5000);
  await S.markMine(ph, S.mine());
  await ph.locator('button[data-zz]').filter({ hasText: S.fam[fam].receipt }).first().click(); await ph.waitForTimeout(3500);
  const toggle = ph.getByRole('button', { name: /TICKET LINES/i }).first();
  const before = await toggle.getAttribute('aria-expanded');
  const before2 = await ph.evaluate(() => document.body.innerText.includes('1 Hour Play'));
  if (!before2) { await toggle.click(); await ph.waitForTimeout(1200); }
  const lines = await ph.evaluate(() => { const all = document.body.innerText.split('\n').map(s => s.trim()).filter(Boolean); const i = all.findIndex(s => /^TICKET LINES/i.test(s)); const j = all.findIndex(s => /^Total paid/i.test(s)); return i >= 0 ? all.slice(i, j + 2) : null; });
  const toN = s => Number(String(s).replace(/[฿,−-]/g, '')) * (/^[−-]/.test(s) ? -1 : 1);
  const heads = await ph.evaluate(() => [...document.querySelectorAll('div')].filter(d => d.children.length === 2 && /1 Hour Play/.test(d.children[0].textContent) && /^฿/.test(d.children[1].textContent.trim()) && d.children[1].tagName === 'SPAN').map(d => [d.children[0].textContent.replace(/\s+/g, ' ').trim(), d.children[1].textContent.trim()]));
  const sum = heads.reduce((s, h) => s + toN(h[1]), 0);
  out[fam] = { ariaExpandedBefore: before, linesShownBefore: before2, lines, cardHeads: heads, sumOfCards: Math.round(sum * 100) / 100 };
  await S.shot(ph, fam === 'D' ? '16d-phone-390x844-coded-sale-ticket-lines-open.png' : '16e-phone-390x844-no-code-sale-ticket-lines-open.png', [], { fullPage: true });
}
S.receipt.reads.p7phoneLines = out; S.save();
return out;

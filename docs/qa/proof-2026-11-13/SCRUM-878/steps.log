const now = await p.evaluate(() => Date.now());
await p.clock.setFixedTime(new Date(now + 12 * 3600000 + 60000));
await p.waitForTimeout(1500);
const lockedFirst = await p.getByText('still signed in', { exact: false }).count();
const rv = await S.revoke('A');
const k = await S.kick('phone');
const line = await S.waitEnded(p);
await S.shot(p, '13a-phone-twelve-hour-words.png');
await S.formSignIn(p, 'A');
const after = await S.afterSignIn(p);
await p.waitForTimeout(3000);
const configure = await p.getByRole('heading', { name: /^Configure:/ }).count();
const cartAfter = S.flat(await p.getByRole('button', { name: /^Open cart/ }).textContent().catch(() => ''));
await S.shot(p, '13b-phone-after-twelve-hours-sign-in.png');
S.receipt.reads.hunt12h = { cartBefore: before, lockedByInactivityAfterClockMove: lockedFirst, revoke: rv, kick: k, line, ...after, configureAfter: configure, cartAfter };
S.save();
return S.receipt.reads.hunt12h;

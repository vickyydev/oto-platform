S.phase = '2 + 8b: readings after the box\'s next report; the Controls picker on the ZZ till; Test print on the drop-off and the kids entries';
const { expect } = S;
const r = {};
r.reports = await S.waitReports(1);
r.afterReportApi = await S.apiReadings('after the box\'s next report since both address changes');
r.afterReportTill = await S.stationPrinterReadings();
const c = S.pages.console.page;
r.afterReportHealth = await S.consoleHealth(c, '08b3-console-health-zz-printers-after-next-box-report.png');
const box = await S.goBox(c, S.branchId, S.box.name);
r.afterReportDrawer = await S.drawerRows(c, box);
const controls = box.locator('section').filter({ has: c.getByRole('heading', { name: 'Controls', exact: true }) }).first();
await controls.scrollIntoViewIfNeeded();
await controls.getByLabel('Station a test print goes to').selectOption(S.station.id);
await c.waitForTimeout(800);
const sel = controls.getByLabel('Printer it comes out of');
const opts = await sel.locator('option').evaluateAll(os => os.map(o => ({ value: o.value, label: o.textContent })));
const devKey = id => Object.entries(S.dev).find(([, d]) => d.id === id)?.[0] ?? 'other';
r.options = opts.map(o => ({ label: o.label, printer: devKey(o.value.split(':')[0]), job: o.value.split(':')[1] }));
r.selectedAtStart = await sel.locator('option:checked').innerText();
// the native list drawn open for the picture (size = number of entries), then put back
await sel.evaluate((e, n) => { e.setAttribute('size', String(n)); e.style.height = 'auto'; }, opts.length);
await controls.scrollIntoViewIfNeeded();
await S.shot(c, '02a-console-controls-picker-zz-till-four-entries.png');
await sel.evaluate(e => { e.removeAttribute('size'); e.style.height = ''; });
const testPrint = async (endsWith, tag) => {
  const o = opts.find(x => x.label.endsWith(endsWith));
  S.assert.ok(o, `an entry ending ${endsWith}`);
  await sel.selectOption(o.value);
  await c.waitForTimeout(300);
  const before = (await S.printoutsFull(S.dev.band.id)).printouts.map(S.keyOf);
  const [res] = await Promise.all([
    c.waitForResponse(rr => rr.request().method() === 'POST' && new RegExp(`^/api/stations/${S.station.id}/test-print$`).test(new URL(rr.url()).pathname), { timeout: 30000 }),
    controls.getByRole('button', { name: 'Test print', exact: true }).click(),
  ]);
  const body = await res.json().catch(() => null);
  const one = { chose: o.label, sent: res.request().postDataJSON?.() ?? null, status: res.status(), job: body?.printJob ? { id: body.printJob.id, kind: body.printJob.kind, role: body.printJob.role, status: body.printJob.status, device: S.devName(body.printJob.deviceId) } : body };
  await c.waitForTimeout(800);
  one.note = S.flat(await controls.locator('p').filter({ hasText: /queued|Nothing printed/ }).first().innerText().catch(() => ''));
  await S.shot(c, `02${tag}1-console-controls-chose-${endsWith.toLowerCase().replace(/[^a-z]+/g, '-').replace(/^-|-$/g, '')}-test-print-queued.png`);
  let fresh = [];
  await expect.poll(async () => { fresh = (await S.printoutsFull(S.dev.band.id)).printouts.filter(p => !before.includes(S.keyOf(p))); return fresh.length; }, { timeout: 150000, intervals: [3000] }).toBeGreaterThan(0);
  const p = fresh[fresh.length - 1];
  one.printout = { seq: p.seq, widthDots: p.widthDots, heightDots: p.heightDots, truncated: p.truncated };
  one.preview = await S.preview(S.dev.band.id, p.seq, S.resolve(S.scratch, 'raw', `p2-${tag}-band-${p.seq}.png`));
  const j = (await S.jobs(S.box.id, 15)).find(x => x.id === one.job?.id);
  one.jobOnPlatform = j ? S.jobFacts(j) : null;
  const cmds = await S.commands(S.box.id, 10);
  const cmd = cmds.find(x => x.payload?.printJobId === one.job?.id || x.payload?.jobId === one.job?.id);
  one.command = cmd ? { kind: cmd.kind, state: cmd.state, payloadKind: cmd.payload?.kind ?? null, role: cmd.payload?.role ?? null } : null;
  // the Printing panel: the band printer's jobs, newest first
  const printing = box.locator('section').filter({ has: c.getByRole('heading', { name: 'Printing', exact: true }) }).first();
  await printing.scrollIntoViewIfNeeded();
  await printing.getByRole('button', { name: S.dev.band.label, exact: true }).click();
  await printing.getByRole('button', { name: 'Refresh', exact: true }).click();
  await c.waitForTimeout(2500);
  one.panelJobs = S.flat(await printing.locator('ul').first().innerText()).slice(0, 400);
  const firstJob = printing.locator('ul').first().locator('li').first();
  await firstJob.evaluate(e => e.scrollIntoView({ block: 'center' })).catch(() => {});
  await S.shot(c, `02${tag}2-console-printing-panel-band-printer-job-role.png`);
  return one;
};
r.dropoff = await testPrint("Drop-off band printer", 'b');
r.kids = await testPrint("Kids' band printer", 'c');

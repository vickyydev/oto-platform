S.phase='Retire exact final fixtures and synthetic staff';const out={at:new Date().toISOString(),stations:[],accounts:[],sessions:[]};for(const st of S.finalStations){S.assert.ok(st.name.startsWith('ZZ TEST SCRUM-982 final '));S.assert.equal((await S.call('PATCH',`/stations/${st.id}`,{devices:[]})).status,200);S.assert.equal((await S.call('DELETE',`/stations/${st.id}`)).status,200);const row=(await S.call('GET',`/branches/${S.branchId}/stations?includeArchived=true`)).body.stations.find(x=>x.id===st.id);S.assert.ok(row.archived&&row.devices.length===0);out.stations.push({id:row.id,name:row.name,archived:row.archived,devices:0});}const before=(await S.call('GET',`/boxes/${S.box.id}/devices?includeArchived=true`)).body.devices.find(x=>x.id===S.cardDevice.id);S.assert.ok(before.label===S.cardDevice.label&&before.transport==='simulated');S.assert.equal((await S.call('DELETE',`/devices/${S.cardDevice.id}`)).status,200);const terminal=(await S.call('GET',`/boxes/${S.box.id}/devices?includeArchived=true`)).body.devices.find(x=>x.id===S.cardDevice.id);S.assert.equal(terminal.archived,true);out.terminal={id:terminal.id,label:terminal.label,archived:true,transport:terminal.transport};for(const who of ['A','B']){const expected=S.acct[who];const row=(await S.call('GET','/accounts')).body.accounts.find(x=>x.id===expected.id);S.assert.ok(row.phone===expected.phone&&row.employee.name===expected.name&&row.employee.name.startsWith('ZZ TEST 964 '));await S.revoke(who);S.assert.equal((await S.call('PATCH',`/accounts/${expected.id}`,{status:'inactive'})).status,200);const actual=(await S.call('GET','/accounts')).body.accounts.find(x=>x.id===expected.id);const sessions=(await S.call('GET',`/accounts/${expected.id}/sessions?limit=50`)).body;S.assert.equal(actual.status,'inactive');S.assert.ok(sessions.total<=50&&sessions.sessions.every(x=>x.status==='ended'));const signIn=await S.trySignIn(who);S.assert.equal(signIn.status,401);out.accounts.push({id:actual.id,name:actual.employee.name,status:actual.status,liveSessions:0,totalSessions:sessions.total,signInStatus:signIn.status});}S.keepAlive(false);for(const label of Object.keys(S.pages)){const read=await S.signOutLabel(label);S.assert.equal(read.meAfter,401);out.sessions.push({label,...read});}S.receipt.cleanup.finalFixtures=out;S.receipt.cleanup.retainedForFinalSource=null;S.save();return out;

// every look the display root shows from the first paint after a navigation
S.looksInit = () => {
  const w = window; w.__looks = []; const t0 = performance.now();
  const seen = () => { const el = document.querySelector('[data-testid="separate-display"]'); if (!el) return; const c = el.className; const l = /(^|\s)light(\s|$)/.test(c) ? 'light' : /(^|\s)dark(\s|$)/.test(c) ? 'dark' : 'other'; if (w.__looks.at(-1)?.look !== l) w.__looks.push({ ms: Math.round(performance.now() - t0), look: l }); };
  new MutationObserver(seen).observe(document, { subtree: true, childList: true, attributes: true, attributeFilter: ['class'] });
};
await S.displays.A.ctx.addInitScript(S.looksInit);
let d = S.displays.A.page;
await d.reload();
await d.getByTestId('separate-display').waitFor();
await d.getByTestId('language-choice').or(d.getByRole('heading', { name: 'Welcome to OTO Park' })).first().waitFor({ timeout: 30000 });
await S.sleep(3000);
const reload = { looks: await d.evaluate(() => window.__looks), lookNow: await S.look(d), stored: await S.stored(d) };
await S.watchFlips(d);
await S.both('03a-display-reloaded-still-light.png', `Point 3: the display page reloaded: light from its first paint (looks seen: ${reload.looks.map(l => l.look + '@' + l.ms + 'ms').join(', ')})`, till, d);
// a browser restart: the same storage in a new context, the old one closed
const state = await S.displays.A.ctx.storageState();
await S.displays.A.ctx.close();
d = await S.displayContext('A', state);
await S.displays.A.ctx.addInitScript(S.looksInit);
await d.goto(`${S.pos}/display`);
await d.getByTestId('separate-display').waitFor();
await d.getByTestId('language-choice').or(d.getByRole('heading', { name: 'Welcome to OTO Park' })).first().waitFor({ timeout: 30000 });
await S.sleep(3000);
const restart = { looks: await d.evaluate(() => window.__looks), lookNow: await S.look(d), stored: await S.stored(d), session: await S.sessionTheme(d) };
await S.watchFlips(d);
await S.both('03b-display-browser-restart-still-light.png', `Point 3: the display's browser closed and opened again with the same storage: light (looks seen: ${restart.looks.map(l => l.look + '@' + l.ms + 'ms').join(', ')})`, till, d);
S.receipt.reads.p3 = { reload, restart };
return S.receipt.reads.p3;

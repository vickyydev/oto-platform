  const tabs = await ph.evaluate(() => [...document.querySelectorAll('button')].map(b => b.innerText.replace(/\s+/g, ' ').trim()).filter(t => /^(In Park|Upcoming|Out)\s*\d+$/.test(t)));
  const card = S.phoneCards(ph).filter({ hasText: S.GG }).first();
  const listed = await card.count();
  const text = listed ? S.flat(await card.innerText()) : null;
  let name = `13${l}1-phone-390x844-board-family-g-under-${tag}.png`;
  // keep my own card readable: mark it so the shot does not cover it
  await S.shot(ph, name);
  const o = { tabs, listed, text, pics: [name] };
  if (listed) {
    await card.click(); await ph.waitForTimeout(2500);
    o.buttons = await ph.evaluate(() => [...document.querySelectorAll('button')].filter(b => b.getBoundingClientRect().width > 0 && /^(Check|Mark|Cancel)/.test(b.innerText.trim()) && b.getBoundingClientRect().top < window.innerHeight - 90 || /^(Check In|Check Out|Mark Arrived)$/.test(b.innerText.trim())).map(b => ({ text: b.innerText.replace(/\s+/g, ' ').trim(), enabled: !b.disabled })));
    o.detail = S.flat(await ph.locator('body').innerText()).replace(/^.*?Couldn't reach/, '').slice(0, 400);
    name = `13${l}2-phone-390x844-family-g-screen-from-${tag}.png`;
    const b = ph.getByRole('button', { name: /^(Check Out|Check In|Mark Arrived)$/ }).first();
    if (await b.count()) { await b.evaluate(e => e.scrollIntoView({ block: 'center' })); await ph.waitForTimeout(500); }
    await S.shot(ph, name); o.pics.push(name);
  }
  out[tag] = o;
}
S.receipt.reads.p8phone = out; S.save();
return out;

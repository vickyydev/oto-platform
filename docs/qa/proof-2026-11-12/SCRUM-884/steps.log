  const text = S.flat(await page.locator('main').innerText().catch(async () => await page.locator('body').innerText()));
  const amounts = S.money(text);
  r[tag] = { amounts: amounts.slice(0, 60), satang: amounts.filter(a => /\.\d/.test(a)), oneDecimal: S.oneDecimal(text), dotZeroZero: amounts.filter(a => /\.00$/.test(a)), grouped: amounts.filter(a => /,/.test(a)).slice(0, 10), ungroupedBig: amounts.filter(a => /฿\d{4,}/.test(a)).slice(0, 10) };

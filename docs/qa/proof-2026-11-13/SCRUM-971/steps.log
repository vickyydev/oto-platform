=== 2026-11-13T02:46:11.696Z hunt: a ZZ TEST till with a Thai name (receipt + drop-off band only): the picker when a printer does one job; test pages on both printers
S.phase = 'hunt: a ZZ TEST till with a Thai name (receipt + drop-off band only): the picker when a printer does one job; test pages on both printers';
const { expect } = S;
const r = {};
const name = 'ZZ TEST 971 เคาน์เตอร์ ญี่ปุ่น น้ำ';
const stations = (await S.call('GET', `/branches/${S.branchId}/stations?includeArchived=true`)).body.stations;
const prefix = S.prefixFree.find(p => !stations.some(s => s.codePrefix === p));
S.prefixFree = S.prefixFree.filter(p => p !== prefix);
const made = await S.call('POST', `/branches/${S.branchId}/stations`, { name, kind: 'till', boxId: S.box.id, codePrefix: prefix, accessScope: 'all_staff', paymentRouting: { card: 'manual', qr: 'none' }, capabilities: [], devices: [{ role: 'receipt', deviceId: S.dev.receipt.id }, { role: 'dropoff_band', deviceId: S.dev.band.id }] });
S.assert.equal(made.status, 200, 'till B');
S.tillB = { id: made.body.station.id, name, prefix };
S.receipt.created.push({ kind: 'station', id: S.tillB.id, name, prefix }); S.save();
r.tillB = { prefix, configVersion: made.body.station.configVersion, roles: S.rolesOf(made.body.station) };
await S.waitReports(1);
const c = S.pages.console.page;
await c.goto(S.CONSOLE + '/overview');
const box = await S.goBox(c, S.branchId, S.box.name);
const controls = box.locator('section').filter({ has: c.getByRole('heading', { name: 'Controls', exact: true }) }).first();
await controls.scrollIntoViewIfNeeded();
await controls.getByLabel('Station a test print goes to').selectOption(S.tillB.id);
await c.waitForTimeout(800);
const sel = controls.getByLabel('Printer it comes out of');
const opts = await sel.locator('option').evaluateAll(os => os.map(o => ({ value: o.value, label: o.textContent })));
r.options = opts.map(o => ({ label: o.label, job: o.value.split(':')[1] }));
const bandOpt = opts.find(o => o.value.startsWith(S.dev.band.id));
await sel.selectOption(bandOpt.value);
await controls.locator('div.grid').first().evaluate(e => { e.dataset.zzCols = e.style.gridTemplateColumns; e.style.gridTemplateColumns = '1fr'; });
await sel.evaluate((e, n) => { e.setAttribute('size', String(n)); e.style.height = 'auto'; }, opts.length);
await controls.scrollIntoViewIfNeeded();
await S.shot(c, 'h1a-console-controls-picker-printer-with-one-job-thai-till.png');
await sel.evaluate(e => { e.removeAttribute('size'); e.style.height = ''; });
await controls.locator('div.grid').first().evaluate(e => { e.style.gridTemplateColumns = e.dataset.zzCols || ''; });
const out = {};
for (const [key, want] of [['band', bandOpt.value], ['receipt', opts.find(o => o.value.startsWith(S.dev.receipt.id)).value]]) {
  await sel.selectOption(want);
  const before = (await S.printoutsFull(S.dev[key].id)).printouts.map(S.keyOf);
  const [res] = await Promise.all([
    c.waitForResponse(rr => rr.request().method() === 'POST' && new RegExp(`^/api/stations/${S.tillB.id}/test-print$`).test(new URL(rr.url()).pathname), { timeout: 30000 }),
    controls.getByRole('button', { name: 'Test print', exact: true }).click(),
  ]);
  const body = await res.json().catch(() => null);
  let fresh = [];
  await expect.poll(async () => { fresh = (await S.printoutsFull(S.dev[key].id)).printouts.filter(p => !before.includes(S.keyOf(p))); return fresh.length; }, { timeout: 150000, intervals: [3000] }).toBeGreaterThan(0);
  const p = fresh[fresh.length - 1];
  const file = `h1${key === 'band' ? 'b' : 'c'}-test-page-thai-station-name-${key}-printer-preview.png`;
  out[key] = { sent: res.request().postDataJSON?.() ?? null, status: res.status(), role: body?.printJob?.role ?? null, printout: { seq: p.seq, widthDots: p.widthDots, heightDots: p.heightDots, truncated: p.truncated }, preview: await S.preview(S.dev[key].id, p.seq, S.resolve(S.out, file)), file };
}
r.testPages = out;
S.receipt.reads.huntThai = r;
return r;

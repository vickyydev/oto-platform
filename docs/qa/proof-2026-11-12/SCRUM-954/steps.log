=== 2026-11-12T17:38:58.480Z clean up: sessions signed out, the two own tills retired, displays read back, the read-back picture, the admin signed out
S.phase = 'clean up: sessions signed out, the two own tills retired, displays read back, the read-back picture, the admin signed out';
const out = { signOuts: {} };
for (const label of Object.keys(S.pages)) out.signOuts[label] = await S.signOut(label);
S.till = null; S.mgr = null;
out.stations = [];
for (const st of [S.station, S.phoneStation]) {
  S.assert.ok(/^ZZ TEST SCRUM-954/.test((await S.call('GET', `/stations/${st.id}`)).body.station.name));
  const p = await S.call('PATCH', `/stations/${st.id}`, { devices: [] });
  const d = await S.call('DELETE', `/stations/${st.id}`);
  const back = (await S.call('GET', `/branches/${S.branchId}/stations?includeArchived=true`)).body.stations.find(s => s.id === st.id);
  out.stations.push({ prefix: back?.codePrefix, patch: p.status, del: d.status, archived: back?.archived ?? null, devices: back?.devices?.length ?? null });
}
S.receipt.cleanup.stations = out.stations;
out.displays = (S.receipt.cleanup.displays ?? []).map(d => `${d.label}: revoked`);
const board = await S.boardApi();
out.boardZz954 = board.families.filter(f => /954|Zz Test (Parent|Aya|Thai)/i.test([f.guardianName, ...f.children.map(c => c.childName)].join(' '))).map(f => ({ guardian: f.guardianName, children: f.children.map(c => c.status) }));
const rows = [];
for (const [fam, v] of Object.entries(S.fam)) {
  if (v.reg) { const r = await S.registration(v.reg); rows.push([`registration ${fam}`, r.children.map(c => `${c.childName}: ${c.status}`).join(', ')]); }
  if (v.sale) { const s = await S.sale(v.sale); rows.push([`sale ${fam}`, `${s.sale.receiptNumber} ${s.sale.status}, refund ${s.refundStatus}, refundable ${s.refundableSatang}`]); }
}
const ss = await S.sale(S.settleSale);
rows.push(['party settlement sale', `${ss.sale.status}, refund ${ss.refundStatus} (the 100 refunded by the manager in History)`]);
rows.push(['ZZ TEST parties', `first (13 Nov) ${S.receipt.cleanup.party1?.delete} → read ${S.receipt.cleanup.party1?.readBack}; second (12 Nov) deleted ${S.receipt.cleanup.party.delete} → app ${S.receipt.cleanup.party.readBack.app}, till ${S.receipt.cleanup.party.readBack.till}`]);
for (const s of out.stations) rows.push([`till ${s.prefix}`, `archived ${s.archived}, devices ${s.devices}`]);
rows.push(['displays', out.displays.join(', ')]);
rows.push(['members on own numbers', (S.receipt.cleanup.members ?? []).filter(m => m.archive).map(m => `${m.n} archived (lookup ${m.lookupAfter})`).join('; ')]);
rows.push(['code', `${S.receipt.cleanup.code.code} archived ${S.receipt.cleanup.code.archived}, active ${S.receipt.cleanup.code.active}, in live list ${S.receipt.cleanup.code.inLiveList}`]);
rows.push(['sessions', Object.entries({ ...(S.receipt.cleanup.signOuts ?? {}) }).map(([k, v]) => `${k} ${v.signOut}→me ${v.meAfter}`).join(', ')]);
rows.push(['credit wallet of the ordinary sale', 'active ฿350 after the whole refund (ticket give-back credit is kept by rule OD-W4, as in the SCRUM-893 proof), expires 05:00 Bangkok 13 Nov']);
rows.push(['own families left on the board', JSON.stringify(out.boardZz954)]);
await S.facts('99-cleanup-read-back.png', 'SCRUM-954 / 956 / 953 small-points lane proof — clean-up read back', rows);
const g = {};
for (const e of S.receipt.pageErrors) { const k = `${e.page} | ${e.kind} | ${e.text}`; g[k] = g[k] ?? { n: 0, at: [] }; g[k].n++; if (g[k].at.length < 2 && !g[k].at.includes(e.at)) g[k].at.push(e.at); }
S.receipt.pageErrorsGrouped = g;
const so = await S.admin.post('/api/auth/sign-out', { headers: { 'idempotency-key': S.randomUUID() } });
const me = (await S.admin.get('/api/me')).status();
S.receipt.cleanup.admin = { signOut: so.status(), me };
S.receipt.finishedAt = new Date().toISOString(); S.save();
return { ...out, rows, admin: S.receipt.cleanup.admin, errors: g };

S.phase = 'hunt: a copy of the ZZ test page (POST /print-jobs/:id/reprint, the route History uses); its name in the command history';
const { expect } = S;
const r = {};
const before = (await S.printoutsFull(S.dev.receipt.id)).printouts.map(S.keyOf);
const rp = await S.call('POST', `/print-jobs/${S.p1aJob}/reprint`, { reason: 'ZZ TEST SCRUM-952 proof: copy of a test page' });
r.reprint = { status: rp.status, code: rp.body?.error?.code ?? null, message: rp.body?.error?.message ?? null, job: rp.body?.printJob ? { kind: rp.body.printJob.kind, role: rp.body.printJob.role, status: rp.body.printJob.status } : null };
if (rp.status === 200) {
  let fresh = [];
  await expect.poll(async () => { fresh = (await S.printoutsFull(S.dev.receipt.id)).printouts.filter(p => !before.includes(S.keyOf(p))); return fresh.length; }, { timeout: 120000, intervals: [3000] }).toBeGreaterThan(0).catch(() => {});
  if (fresh[0]) { r.printout = { seq: fresh[0].seq, heightDots: fresh[0].heightDots }; r.preview = await S.preview(S.dev.receipt.id, fresh[0].seq, S.resolve(S.out, '06b-test-page-copy-preview.png')); }
  const cmds = await S.commands(S.box.id, 10);
  const cmd = cmds.find(c => c.payload?.reprintOf);
  r.command = cmd ? { kind: cmd.kind, state: cmd.state, payloadKind: cmd.payload.kind, document: cmd.payload.document ?? null, hasReprintOf: Boolean(cmd.payload.reprintOf) } : null;
  const c = S.pages.console.page;
  await c.reload();
  const box = await S.goBox(c, S.branchId, S.box.name);
  const history = box.locator('section').filter({ has: c.getByRole('heading', { name: 'Command history', exact: true }) }).first();
  await history.getByRole('button', { name: 'Refresh', exact: true }).click();
  await c.waitForTimeout(2500);
  await history.scrollIntoViewIfNeeded();
  r.history = (await history.locator('li').allInnerTexts()).slice(0, 3).map(S.flat);
  await S.shot(c, '06c-console-command-history-test-page-copy.png');
}
S.receipt.reads.huntReprint = r;
return r;

=== 2026-11-13T03:38:16.986Z 1: B changes the continued sale on the till (a sock, a payment method, a simulator QR); the display follows each change
S.phase = '1: B changes the continued sale on the till (a sock, a payment method, a simulator QR); the display follows each change';
const { expect } = S;
const till = S.till, d = S.d;
const r = { changes: [] };
const timeTo = async (label, act, seen, picture, caption) => {
  const t0 = Date.now();
  await act();
  let ok = false;
  try { await expect.poll(seen, { timeout: 30000, intervals: [250] }).toBe(true); ok = true; } catch {}
  const ms = Date.now() - t0;
  await till.waitForTimeout(600);
  const entry = { change: label, displayFollowed: ok, msToDisplay: ok ? ms : null, display: S.flat(await d.locator('body').innerText()).slice(0, 300), notice: await S.notice(till), amountDue: await S.amountDue(till) };
  r.changes.push(entry);
  if (picture) await S.both(picture, caption, till, d);
  return entry;
};

=== 2026-11-13T04:14:56.932Z hunt: the party page when the plan read fails — the manager's browser answers the party read 503 itself (as a restarting platform would; nothing on staging is touched); what the bill and Take balance read; then the read is let through again
S.phase = 'hunt: the party page when the plan read fails — the manager\'s browser answers the party read 503 itself (as a restarting platform would; nothing on staging is touched); what the bill and Take balance read; then the read is let through again';
const mgr = S.mgr;
const t = S.pages.mgr;
await S.unlockShared('mgr');
const r = { before: { bill: await S.cardText(mgr, 'Party bill'), take: await S.takeBalance(mgr) } };
const pattern = new RegExp(`/api/parties/${S.p1}(\\?|$)`);
let failed = 0;
await t.ctx.route(u => pattern.test(new URL(u).pathname + new URL(u).search), async route => {
  if (route.request().method() === 'GET') { failed += 1; await route.fulfill({ status: 503, contentType: 'text/plain', body: 'Service Unavailable' }); }
  else await route.continue();
});
const samples = [];
const t0 = Date.now();
for (let i = 0; i < 8; i++) {
  await mgr.evaluate(() => { window.dispatchEvent(new Event('focus')); document.dispatchEvent(new Event('visibilitychange')); });
  await mgr.waitForTimeout(2500);
  samples.push({ s: Math.round((Date.now() - t0) / 1000), failedReads: failed, take: await S.takeBalance(mgr), bill: (await S.cardText(mgr, 'Party bill')).replace(/^Party bill /, '') });
}
r.whileFailing = samples;
await mgr.mouse.wheel(0, -3000); await mgr.waitForTimeout(300);
await S.shot(mgr, 'h3a-party-page-plan-read-failing.png');
// a reload while it fails
await mgr.reload(); await mgr.waitForTimeout(6000);
r.reloadWhileFailing = { url: new URL(mgr.url()).pathname + new URL(mgr.url()).search, take: await S.takeBalance(mgr), bill: (await S.cardText(mgr, 'Party bill')).replace(/^Party bill /, ''), body: S.flat(await mgr.locator('body').innerText()).slice(0, 400), failedReads: failed };
await S.shot(mgr, 'h3b-party-page-reloaded-while-plan-read-fails.png');
await t.ctx.unroute(u => pattern.test(new URL(u).pathname + new URL(u).search)).catch(async () => { await t.ctx.unrouteAll({ behavior: 'ignoreErrors' }); });
await t.ctx.unrouteAll({ behavior: 'ignoreErrors' }).catch(() => {});
await mgr.waitForTimeout(500);
await S.openParty(mgr, S.p1, S.P1).catch(() => {});
await mgr.waitForTimeout(5000);
r.afterLetThrough = { take: await S.takeBalance(mgr), bill: (await S.cardText(mgr, 'Party bill')).replace(/^Party bill /, '') };
S.receipt.reads.h3 = r; S.save();
return r;

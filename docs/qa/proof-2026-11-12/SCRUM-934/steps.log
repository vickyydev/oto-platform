  const r = await S.call('GET', t);
  const arr = r.body?.products ?? r.body?.items ?? (Array.isArray(r.body) ? r.body : null);
  out[t] = { status: r.status, n: arr?.length ?? null, odd: arr ? arr.filter(p => !p.archivedAt && p.active !== false).map(p => ({ name: p.name, price: p.priceSatang ?? p.price ?? p.unitSatang, cat: p.categoryName ?? p.category ?? p.revenueCategory ?? null })).filter(p => typeof p.price === 'number' && p.price % 1000 !== 0).slice(0, 15) : null };
}
// the drop-off service fee rule
const rule = await S.call('GET', `/branches/${S.branchId}/dropoff-pricing`);
out.dropoff = { status: rule.status, body: rule.status === 200 ? rule.body : null };
return out;

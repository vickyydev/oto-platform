=== 2026-11-12T17:38:36.853Z clean up: the ZZ TEST party deleted in the OTO App; members on the own numbers archived; the code archived; the credit wallet of the ordinary sale read
S.phase = 'clean up: the ZZ TEST party deleted in the OTO App; members on the own numbers archived; the code archived; the credit wallet of the ordinary sale read';
const out = {};
const p = (await S.call('GET', `/parties/${S.partyId}?branchId=${S.branchId}`)).body;
S.assert.equal(p?.event?.title, S.PARTY);
out.party = { settlementBefore: p?.event?.party?.settlement?.state ?? null, depositBefore: p?.event?.party?.depositSatang / 100 };
out.party.delete = (await S.appCall('DELETE', `/admin/events/${S.partyId}`)).status;
out.party.readBack = { app: (await S.appCall('GET', `/admin/events/${S.partyId}`)).status, till: (await S.call('GET', `/parties/${S.partyId}?branchId=${S.branchId}`)).status };
const so = await S.appCtx.request.post(S.LAUNCHER + '/api/auth/sign-out', { data: {}, headers: { 'Idempotency-Key': S.randomUUID() } });
out.party.appSignOut = so.status();
await S.appCtx.close(); S.appCtx = null;
S.receipt.cleanup.party = out.party; S.save();
out.members = [];
for (const n of S.free.slice(0, 10)) {
  const m = (await S.call('GET', `/members/lookup?phone=${n}`)).body?.member ?? null;
  if (!m) { out.members.push({ n, member: null }); continue; }
  const label = `${m.nickname ?? ''} ${m.name ?? ''}`;
  if (!/ZZ TEST/i.test(label)) { out.members.push({ n, member: 'found, not ZZ TEST named: left alone', empty: !label.trim() }); continue; }
  const del = await S.call('DELETE', `/members/${m.id}`);
  const again = (await S.call('GET', `/members/lookup?phone=${n}`)).body?.member ?? null;
  out.members.push({ n, name: label.trim(), archive: del.status, lookupAfter: again ? 'still found' : 'gone' });
}
S.receipt.cleanup.members = out.members; S.save();
const row = (await S.call('GET', '/menu/discounts?includeArchived=true')).body.discounts.find(d => d.id === S.codeId);
S.assert.ok(row && row.code === S.CODE && /^ZZ TEST SCRUM-954/.test(row.label), 'only this run\'s own code');
const del = row.archivedAt ? null : (await S.call('DELETE', `/menu/discounts/${S.codeId}`)).status;
const after = (await S.call('GET', '/menu/discounts?includeArchived=true')).body.discounts.find(d => d.id === S.codeId);
const live = (await S.call('GET', '/menu/discounts')).body.discounts.some(d => d.id === S.codeId);
out.code = { code: S.CODE, archive: del, archived: Boolean(after.archivedAt), active: after.active, usedCount: after.usedCount, inLiveList: live };
S.receipt.cleanup.code = out.code; S.save();
const o = await S.sale(S.fam.O.sale);
const walletId = o.grants?.[0]?.walletId;
const w = walletId ? await S.call('GET', `/wallets/${walletId}`) : null;
out.creditWallet = w ? { status: w.status, state: w.body ? JSON.stringify(w.body).match(/"(status|state|balanceSatang|expiresAt)":[^,}]*/g)?.slice(0, 5) ?? null : null } : null;
S.receipt.cleanup.creditWallet = out.creditWallet; S.save();
return out;

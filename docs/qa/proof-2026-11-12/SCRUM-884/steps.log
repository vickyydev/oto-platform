const walk = (o, out = [], path = '') => { if (o && typeof o === 'object') for (const [k, v] of Object.entries(o)) { if (typeof v === 'number' && /Satang$/.test(k) && v % 100 !== 0) out.push(path + k + '=' + v); else if (typeof v === 'object') walk(v, out, path + k + '.'); } return out; };

=== 2026-11-12T21:30:37.690Z 960: part-paid shop on till 1440x900-split: code, partial 50, QR in flight, dialog
S.pp = { page: S.till, label: 'till', pfx: '12', W: '1440x900-split', tag: 'shop', digits: null, code: false, split: true, qr: false, words: ['Merch Blue Emoji Toy', 'Discount code', '−฿16.50', 'Total', '฿148.50'] };
// args: S.pp = { page, label, pfx, W, tag, digits (pickup, F&B only), code (bool) } ; the item is in the cart
const P = S.pp;
S.phase = `960: part-paid ${P.tag} on ${P.label} ${P.W}: code, partial 50, QR in flight, dialog`;
const { expect } = S;
const page = P.page;
await S.unlock(P.label);
const r = { pics: [] };
const pic = async n => { await S.shot(page, n); r.pics.push(n); return n; };
const cust = async () => S.flat(await S.customerHalf(page).innerText().catch(() => ''));
S.orderOf = (t, words) => { const at = words.map(w => ({ w, i: t.indexOf(w) })); return { at, inOrder: at.every(x => x.i >= 0) && at.every((x, k) => k === 0 || x.i > at[k - 1].i) }; };
if (P.code) {
  const promo = page.getByPlaceholder(/Promo code/i).first();
  await promo.fill(S.CODE);
  await page.getByRole('button', { name: 'Apply', exact: true }).first().click();
  await page.waitForTimeout(2500);
}
const charge = page.getByRole('button', { name: /^Charge ฿/ });
await expect(charge).toBeEnabled({ timeout: 20000 });
r.cart = { charge: S.flat(await charge.innerText()) };
if (P.split) { r.cart.customer = (await cust()).slice(0, 400); r.cart.customerOrder = S.orderOf(r.cart.customer, P.words); }
await pic(`${P.pfx}a-${P.W}-${P.tag}-code-applied-cart.png`);
await charge.click();
await page.waitForTimeout(1500);
const dialog = page.getByRole('dialog').last();
if (P.digits && await dialog.count()) {
  for (const d of P.digits) await dialog.getByRole('button', { name: d, exact: true }).click();
  await page.waitForTimeout(500);
  await dialog.getByRole('button', { name: /^Continue to Payment/ }).click();
}
await page.waitForTimeout(3000);
const before = new Set((await S.stationSales()).map(s => s.id));
r.payment = { amountDue: S.flat(await page.locator('body').innerText()).match(/Amount due\s*฿[0-9,.]+/)?.[0] ?? null };
if (P.split) { r.payment.customer = (await cust()).slice(0, 400); r.payment.customerOrder = S.orderOf(r.payment.customer, P.words); }
await pic(`${P.pfx}b-${P.W}-${P.tag}-payment-screen-discount-row.png`);
// Cash, Partial payment, 50
await page.getByRole('button', { name: /^Cash / }).first().click();
await page.getByRole('button', { name: 'Partial payment', exact: true }).click();

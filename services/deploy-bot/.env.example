# Deploy bot — every variable it reads. Copy to .env for local runs; on Render
# these are set on the oto-deploy-bot service. Nothing here is a real value.
#
# Local runs read two files: this folder's .env first, then the repository's
# main .env for anything not set here. Keys that already live in the main one
# (RENDER_API_KEY, ANTHROPIC_API_KEY, TWILIO_*) do not need repeating.

# --- Required -----------------------------------------------------------------

# The Postgres the bot keeps its state in. It creates and uses only the schema
# named by DB_SCHEMA; the platform's schemas are never read or written.
#
# On Render this is supplied by the blueprint (fromDatabase: oto-db-staging).
# Locally, use the compose database — the staging one only accepts connections
# from inside Render:  postgres://oto:oto@localhost:5433/oto
DATABASE_URL=postgres://user:password@host:5432/dbname
DB_SCHEMA=deploybot

# Guards /send and /admin/*. At least 24 characters. Anyone holding it can post
# to the group, so treat it like a password:  openssl rand -hex 32
ADMIN_TOKEN=

# Reads the deploy history. Dashboard → Account settings → API keys.
RENDER_API_KEY=

# The bot's own WhatsApp number, international format, used to request a
# pairing code. Digits, spaces and a leading + are all accepted.
WHATSAPP_PHONE=

# The group the digest is posted to, e.g. 120363012345678901@g.us. Leave empty
# until the bot is paired, then read it from GET /admin/groups.
WHATSAPP_GROUP_ID=

# --- The digest ---------------------------------------------------------------

# Heading of every message.
ENV_LABEL=OTO staging
# The clock the schedule below is read on, and the date shown in the message.
DIGEST_TZ=Asia/Bangkok
# Sent once a day at DIGEST_TIME, and only if something new went live. If the
# bot was down at that moment it still sends on return, but never after
# DIGEST_LATEST; the next morning's digest then covers both days.
DIGEST_TIME=09:00
DIGEST_LATEST=12:00
# A digest longer than PART_MAX_CHARS is split between bullets into at most
# MAX_PARTS messages, sent PART_INTERVAL_MIN minutes apart.
PART_MAX_CHARS=1500
PART_INTERVAL_MIN=30
MAX_PARTS=4
# A message that could not be delivered within this long is dropped.
MESSAGE_TTL_HOURS=6

# Service names to report on, comma-separated. Empty means every service the
# API key can see. IGNORE_SERVICES removes names from whichever list applies.
WATCH_SERVICES=
IGNORE_SERVICES=

# --- Optional: better content --------------------------------------------------

# With a key, the commits are rewritten as a short plain-English summary.
# Without one, the digest lists the commit subjects as they are.
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-opus-5

# --- Optional: tell the owner when WhatsApp drops the session --------------------

# That one alert cannot go over WhatsApp, so it goes by SMS through Twilio.
# Either the API key pair or the auth token works.
OWNER_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Rarely changed -------------------------------------------------------------

PORT=8790
LOG_LEVEL=info

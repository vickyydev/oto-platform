await till.waitForTimeout(1500);
out.doorDialog = await till.getByRole('dialog').filter({ hasText: /Check in the drop-off/ }).count();
out.success = await till.evaluate(() => { const h = [...document.querySelectorAll('h2')].find(x => x.textContent.trim() === 'Payment Successful'); return h?.nextElementSibling?.textContent.trim() ?? null; });
await S.both('20b-ordinary-sale-paid-till-and-display.png', 'Point 10 — the ordinary sale paid in cash: no door dialog; the success line as before', till, d);

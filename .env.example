# --- Database -----------------------------------------------------------
# Postgres 16 connection string. `docker compose -f infra/docker-compose.yml up -d`
# serves it on 5433 with these credentials.
DATABASE_URL=postgres://oto:oto@localhost:5433/oto

# --- API server ---------------------------------------------------------
API_PORT=3001
# Session lifetime (server-side row + cookie maxAge).
SESSION_TTL_HOURS=12
# Set true behind HTTPS in production; false for local http dev.
COOKIE_SECURE=false
# Sign-in throttling: failures per phone/IP before a cooldown applies.
AUTH_MAX_FAILURES=5
AUTH_COOLDOWN_SECONDS=300
# Idempotency-key retention.
IDEMPOTENCY_TTL_HOURS=24

# --- POS dev server -----------------------------------------------------
# Vite port for apps/pos (proxies /api to the API server).
POS_PORT=25741

# --- Object storage (MinIO locally, any S3 API in production) -----------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=oto
MINIO_SECRET_KEY=otosecret123
MINIO_BUCKET=oto-files

# --- SMS (verification / reset codes) ------------------------------------
# `console` logs codes to the API log — the dev adapter. Real providers plug
# in behind the same adapter interface.
SMS_ADAPTER=console

# --- Error reporting ------------------------------------------------------
# Leave empty for a no-op error hook; set a DSN to enable Sentry.
SENTRY_DSN=

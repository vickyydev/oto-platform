S.phase = '1/8: helpers for the edit form and the readings';
/** The till's light reading of the ZZ till's printers (GET /stations/:id/printers). */
S.stationPrinterReadings = async () => { const r = await S.call('GET', `/stations/${S.station.id}/printers`); return (r.body?.printers ?? []).map(p => ({ label: p.label, role: p.role, reachability: p.reachability, paperStatus: p.paperStatus, lastError: p.lastError ?? null })); };
/** The Console Health page, The boxes, the Virtual box 1 row: each ZZ printer's own item. */
S.consoleHealth = async (c, pic) => {
  await c.goto(S.CONSOLE + '/health');
  await c.getByText('The boxes', { exact: true }).first().waitFor({ timeout: 30000 });
  await c.waitForTimeout(2500);
  const row = c.getByRole('listitem').filter({ has: c.getByRole('link', { name: S.box.name, exact: true }) }).first();
  await row.scrollIntoViewIfNeeded();
  const per = {};
  for (const [key, d] of Object.entries(S.dev)) {
    const item = row.locator('span.inline-flex').filter({ has: c.getByText(d.label, { exact: true }) }).first();
    per[key] = (await item.count()) ? { text: S.flat(await item.innerText()), notSetUp: /not set up/i.test(await item.innerText()) } : 'not listed';
  }
  if (pic) {
    const first = row.locator('span.inline-flex').filter({ has: c.getByText(S.dev.receipt.label, { exact: true }) }).first();
    if (await first.count()) await first.evaluate(e => e.scrollIntoView({ block: 'center' }));
    await c.waitForTimeout(400);
    await S.shot(c, pic);
  }
  return per;
};
/** The box drawer's row of each ZZ printer: its words, and whether it reads not set up. */
S.drawerRows = async (c, box) => {
  const per = {};
  for (const [key, d] of Object.entries(S.dev)) {
    const row = S.deviceRow(c, box, d.label);
    per[key] = (await row.count()) ? { text: S.flat(await row.innerText()).slice(0, 220), notSetUp: /not set up/i.test(await row.innerText()) } : 'not listed';
  }
  return per;
};
/** Edits one ZZ printer in the Virtual box 1 drawer through the Console form; `change` types into the open form. */
S.editThroughForm = async ({ key, change, formPic, afterPic, settle = 2500 }) => {
  const c = S.pages.console.page;
  await c.reload();
  const box = await S.goBox(c, S.branchId, S.box.name);
  const d = S.dev[key];
  const before = (await S.devicesOnBox()).find(x => x.id === d.id);
  const row = S.deviceRow(c, box, d.label);
  await row.scrollIntoViewIfNeeded();
  await row.getByRole('button', { name: 'Edit', exact: true }).click();
  const editing = S.editing(c, box);
  await expect(editing).toHaveCount(1);
  const shown = { address: await editing.getByLabel(/^Address/).inputValue(), model: await editing.getByLabel(/^Model/).inputValue(), protocol: await editing.getByLabel(/^Protocol/).inputValue() };
  if (d.kind === 'receipt_printer') shown.paperWidth = await editing.getByLabel(/^Paper width/).locator('option:checked').innerText();
  if (d.kind === 'band_printer') shown.sensing = await editing.getByLabel(/^Sensing/).locator('option:checked').innerText();
  await change(editing);
  await c.waitForTimeout(300);
  if (formPic) { await editing.scrollIntoViewIfNeeded(); await S.shot(c, formPic); }
  let response = null;
  const sent = await S.capture(c, 'PATCH', new RegExp(`^/api/devices/${d.id}$`), async () => {
    const resp = c.waitForResponse(r => r.request().method() === 'PATCH' && new URL(r.url()).pathname === `/api/devices/${d.id}`, { timeout: 6000 }).catch(() => null);
    await editing.getByRole('button', { name: 'Save', exact: true }).click();
    const res = await resp;
    if (res) { const b = await res.json().catch(() => null); response = { status: res.status(), settings: b?.device?.settings ?? null, address: b?.device?.address ?? null, reading: S.readingOf(b?.device) }; }
  }, settle);
  const formOpen = await editing.count();
  const rowAfter = S.deviceRow(c, box, d.label);
  await rowAfter.scrollIntoViewIfNeeded().catch(() => {});
  const drawer = await S.drawerRows(c, box);
  if (afterPic) await S.shot(c, afterPic);
  const after = (await S.devicesOnBox()).find(x => x.id === d.id);
  return { label: d.label, shownInForm: shown, before: { address: before.address, settings: before.settings ?? null, model: before.model ?? null, protocol: before.protocol ?? null, label: before.label },
    requests: sent.map(s => ({ method: s.method, path: s.path, body: s.body })), response, formStillOpen: formOpen > 0,
    after: { address: after.address, settings: after.settings ?? null, model: after.model ?? null, protocol: after.protocol ?? null, label: after.label, reading: S.readingOf(after) }, drawerRowsRightAfter: drawer };
};
return 'defined';

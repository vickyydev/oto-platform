await pic(`${P.pfx}g-${P.W}-${P.tag}-save-as-partly-paid-dialog.png`);
if (P.saleId) { const s = await S.sale(P.saleId); r.saleApi = { status: s.sale.status, gross: s.sale.totals.grossSatang / 100, total: (s.sale.totals.totalSatang ?? null) / 100, outstanding: (s.outstandingSatang ?? null) / 100, payments: (s.payments ?? []).map(p => `${p.method} ${p.amountSatang / 100} ${p.status}`) }; }

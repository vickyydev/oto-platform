S.phase = '5: Devices > Stations > New station "ZZ TEST 971 display" on Virtual box 1: the Code prefix field by kind; created as a Customer display; opened again and saved';
const { expect } = S;
const r = { kinds: {} };
const c = S.pages.console.page;
await c.keyboard.press('Escape').catch(() => {});
await c.goto(S.CONSOLE + '/overview');
await S.goStations(c);
await c.getByRole('button', { name: 'New station', exact: true }).click();
const d = S.drawerOf(c);
await expect(d).toBeVisible();
await d.getByLabel('Box', { exact: true }).selectOption(S.box.id);
await d.getByLabel('Name', { exact: true }).fill('ZZ TEST 971 display');
r.kindAtStart = await d.getByLabel('Kind', { exact: true }).locator('option:checked').innerText();
r.prefixAtStart = await d.getByLabel('Code prefix', { exact: true }).count();
const look = async (kind, pic) => {
  await d.getByLabel('Kind', { exact: true }).selectOption(kind);
  await c.waitForTimeout(400);
  const field = d.getByLabel('Code prefix', { exact: true });
  const n = await field.count();
  const words = S.flat(await d.getByLabel('Kind', { exact: true }).locator('option:checked').innerText());
  await d.getByLabel('Kind', { exact: true }).scrollIntoViewIfNeeded();
  if (pic) await S.shot(c, pic);
  r.kinds[kind] = { shownAs: words, codePrefixFields: n, placeholder: n ? await field.getAttribute('placeholder') : null };
};
await look('display', '05a-console-new-station-customer-display-no-code-prefix.png');
await look('gate', '05b-console-new-station-gate-no-code-prefix.png');
await look('till', '05c-console-new-station-till-code-prefix-back.png');
await look('kiosk', '05d-console-new-station-kiosk-code-prefix.png');
await look('booth', '05e-console-new-station-booth-code-prefix.png');
await look('display', null);
// create it as a Customer display
let created = null;
const sent = await S.capture(c, 'POST', new RegExp(`^/api/branches/${S.branchId}/stations$`), async () => {
  const resp = c.waitForResponse(x => x.request().method() === 'POST' && new URL(x.url()).pathname === `/api/branches/${S.branchId}/stations`, { timeout: 20000 });
  await d.getByRole('button', { name: 'Create the station', exact: true }).click();
  const res = await resp; created = { status: res.status(), body: await res.json().catch(() => null) };
}, 1500);
r.create = { sent: sent.map(s => JSON.parse(s.body ?? '{}')), status: created?.status, station: created?.body?.station ? { id: created.body.station.id, name: created.body.station.name, kind: created.body.station.kind, codePrefix: created.body.station.codePrefix ?? null, configVersion: created.body.station.configVersion } : created?.body };
if (created?.body?.station?.id) { S.display = { id: created.body.station.id, name: 'ZZ TEST 971 display' }; S.receipt.created.push({ kind: 'station', id: S.display.id, name: 'ZZ TEST 971 display', stationKind: 'display' }); S.save(); }
await c.waitForTimeout(1500);

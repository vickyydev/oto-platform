  const conf = btns.find(b => b.innerText.trim() === 'Confirm Payment Received');
  let sc = step; while (sc && sc !== document.body) { const cs = getComputedStyle(sc); if (/(auto|scroll)/.test(cs.overflowY) && sc.scrollHeight > sc.clientHeight + 1) break; sc = sc.parentElement; }
  const box = e => { if (!e) return null; const b = e.getBoundingClientRect(); return [Math.round(b.left), Math.round(b.top), Math.round(b.width), Math.round(b.height)]; };
  const foot = conf?.parentElement; const fcs = foot ? getComputedStyle(foot) : null;
  return { viewportH: window.innerHeight, back: box(back), confirm: box(conf), confirmEnabled: conf ? !conf.disabled : null,
    confirmBottomGap: conf ? Math.round(window.innerHeight - conf.getBoundingClientRect().bottom) : null,
    confirmTextInside: conf ? (() => { const rg = document.createRange(); rg.selectNodeContents(conf); const t = rg.getBoundingClientRect(); const b = conf.getBoundingClientRect(); return t.left >= b.left - 1 && t.right <= b.right + 1 && t.top >= b.top - 1 && t.bottom <= b.bottom + 1; })() : null,
    foot: fcs ? { position: fcs.position, bottom: fcs.bottom, background: fcs.backgroundColor, image: fcs.backgroundImage.slice(0, 80) } : null,
    scroller: sc && sc !== document.body ? { top: sc.scrollTop, max: sc.scrollHeight - sc.clientHeight, box: box(sc) } : null };
});

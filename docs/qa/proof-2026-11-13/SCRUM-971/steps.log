  `Chose "${r.dropoff.chose}", pressed Test print: POST /api/stations/<ZZ till>/test-print ${JSON.stringify(r.dropoff.sent)} -> ${r.dropoff.status}; job ${JSON.stringify(r.dropoff.job)}`,
  `  on the platform: ${JSON.stringify(r.dropoff.jobOnPlatform)}; box command ${JSON.stringify(r.dropoff.command)}; printout #${r.dropoff.printout.seq} ${r.dropoff.printout.widthDots}x${r.dropoff.printout.heightDots} dots`,

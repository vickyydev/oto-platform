S.phase = 'masks: the simulator QR is an SVG (not a canvas): every large square SVG is masked from now on; 08a and 08b redrawn with the QRs covered';
const { readFileSync, writeFileSync } = await import('node:fs');
if (!S.captureBase) S.captureBase = S.capture;
S.capture = async (page, opts = {}, extra = []) => {
  await page.evaluate(() => { for (const s of document.querySelectorAll('svg')) { const r = s.getBoundingClientRect(); if (r.width >= 90 && r.height >= 90 && Math.abs(r.width - r.height) < 12) s.setAttribute('data-zz-qr', '1'); } }).catch(() => {});
  try { return await S.captureBase(page, opts, [...extra, page.locator('[data-zz-qr]')]); }
  finally { await page.evaluate(() => { for (const s of document.querySelectorAll('[data-zz-qr]')) s.removeAttribute('data-zz-qr'); }).catch(() => {}); }
};
const cover = async (name, boxes) => {
  const file = S.resolve(S.out, name);
  const b64 = readFileSync(file).toString('base64');
  const page = await S.browser.newPage({ viewport: { width: 2000, height: 1000 } });
  await page.setContent(`<html><body style="margin:0"><div style="position:relative;display:inline-block"><img id="i" src="data:image/png;base64,${b64}">${boxes.map(([x, y, w, h]) => `<div style="position:absolute;left:${x}px;top:${y}px;width:${w}px;height:${h}px;background:#18181b"></div>`).join('')}</div></body></html>`);
  const size = await page.evaluate(() => { const i = document.getElementById('i'); return [i.naturalWidth, i.naturalHeight]; });
  await page.setViewportSize({ width: size[0], height: size[1] });
  await page.locator('div').first().screenshot({ path: file });
  await page.close();
  return size;
};

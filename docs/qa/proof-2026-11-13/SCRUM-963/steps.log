}
await p.setViewportSize({ width: 390, height: 844 }); await p.waitForTimeout(1500);
out.final390 = await textOf();
out.sales = (await S.stationSales(S.phoneStation)).map(s => ({ status: s.status, gross: s.totals?.grossSatang / 100 }));
S.receipt.reads.p6sideways = out; S.save();
return out;

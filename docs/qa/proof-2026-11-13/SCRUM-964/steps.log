S.phase = 'pictures: h1c\'s caption was written before the read and claimed the QR was read back; the caption strip redrawn with what the picture shows and the file renamed; 08c (masked whole by the first demo-wristband rule) and the look pictures removed';
const fs = await import('node:fs');
const src = S.resolve(S.out, 'h1c-B-continued-qr-read-back-display-held.png');
const dst = S.resolve(S.out, 'h1c-B-continued-qr-not-read-back-display-held.png');

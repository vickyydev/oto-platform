=== 2026-11-12T23:59:23.463Z hunt: the form's eyebrow line against the language button, each language at 600 wide
S.phase = 'hunt: the form\'s eyebrow line against the language button, each language at 600 wide';
const d = S.d;
const out = {};
for (const [label, code] of [['Français', 'fr'], ['Русский', 'ru'], ['中文', 'zh'], ['ไทย', 'th'], ['English', 'en']]) {
  await S.chooseLang(d, label); await d.waitForTimeout(900);
  out[code] = await d.evaluate(() => {
    const r1 = v => Math.round(v * 10) / 10;
    const f = document.querySelector('[data-testid="display-consent"]');
    const h2 = f.querySelector('h2');
    // the eyebrow: the line above the heading
    let eb = h2?.previousElementSibling; while (eb && !eb.textContent.trim()) eb = eb.previousElementSibling;
    const lang = [...document.querySelectorAll('button')].find(b => /^(Change language|เปลี่ยนภาษา|更改语言|Сменить язык|Changer de langue)$/.test(b.getAttribute('aria-label') || '') && b.getBoundingClientRect().width > 0);
    if (!eb || !lang) return { eb: !!eb, lang: !!lang };
    const rg = document.createRange(); rg.selectNodeContents(eb); const tr = [...rg.getClientRects()].filter(x => x.width > 2);
    const words = { left: r1(Math.min(...tr.map(x => x.left))), right: r1(Math.max(...tr.map(x => x.right))), top: r1(Math.min(...tr.map(x => x.top))), bottom: r1(Math.max(...tr.map(x => x.bottom))) };
    const lr = lang.getBoundingClientRect();
    const ox = Math.min(words.right, lr.right) - Math.max(words.left, lr.left), oy = Math.min(words.bottom, lr.bottom) - Math.max(words.top, lr.top);
    return { eyebrow: eb.textContent.trim(), words, language: [r1(lr.left), r1(lr.top), r1(lr.right), r1(lr.bottom)], overlapPx: ox > 0 && oy > 0 ? [r1(ox), r1(oy)] : 0 };
  });
  if (out[code].overlapPx) await S.shot(d, `92${code}-hunt-600-form-eyebrow-under-language-button-${code}.png`, [], { clip: { x: 0, y: 0, width: 600, height: 130 } });
}
S.receipt.hunt.push({ what: 'the form eyebrow line against the language button at 600 wide', ...out }); S.save();
return out;

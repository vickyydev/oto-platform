const sales = (q.body?.sales ?? []).filter(s => s.status === 'tendering');
r.tenderingSales = sales.length;
r.candidates = [];
for (const s of sales.slice(0, 40)) {
  const d = await S.sale(s.id);
  const stuck = (d.attempts ?? []).filter(a => ['sent_to_terminal', 'unknown', 'inquiring'].includes(a.status));
  if (stuck.length) r.candidates.push({ sale: s.id, occurredAt: d.sale.occurredAt ?? d.sale.createdAt, station: d.sale.stationId, attempts: stuck.map(a => ({ id: a.id, status: a.status, method: a.method, provider: a.provider ?? null, createdAt: a.createdAt })) });
}
const stations = (await S.call('GET', `/branches/${S.branchId}/stations?includeArchived=true`)).body.stations;
for (const c of r.candidates) { const st = stations.find(x => x.id === c.station); c.stationName = st?.name ?? null; c.stationRetired = Boolean(st?.archived); }
S.receipt.reads.p6remaining = r;
const ph = S.receipt.reads.p6console;
const text = [
  `Point 6, read ${new Date().toISOString()}; job:payments.pending runs every 60 s (last run ${S.receipt.reads.p6api ? 'seen ok' : '?'}), the held attempt was freed at 01:54:24Z, the run's own attempts declined within 2-4 s`,
  '',

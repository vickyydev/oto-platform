S.phase = 'harness: relaunch the browser with a file-fed fake camera (generated colour bars, nobody\'s picture)';
const { writeFileSync } = await import('node:fs');
const SP = '<scratchpad>';
const W = 640, H = 480;
const bars = [[235,128,128],[210,16,146],[170,166,16],[145,54,34],[106,202,222],[81,90,240],[41,240,110],[16,128,128]];
const Y = Buffer.alloc(W * H), U = Buffer.alloc(W * H / 4), V = Buffer.alloc(W * H / 4);
for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) { const b = bars[Math.floor(x / (W / 8))]; Y[y * W + x] = y > H * 0.8 ? 16 + ((x >> 4) & 1) * 200 : b[0]; }
for (let y = 0; y < H / 2; y++) for (let x = 0; x < W / 2; x++) { const b = bars[Math.floor((x * 2) / (W / 8))]; const low = y * 2 > H * 0.8; U[y * W / 2 + x] = low ? 128 : b[1]; V[y * W / 2 + x] = low ? 128 : b[2]; }
const video = `${SP}/camera-bars.y4m`;
writeFileSync(video, Buffer.concat([Buffer.from(`YUV4MPEG2 W${W} H${H} F10:1 Ip A1:1 C420\nFRAME\n`), Y, U, V]));
clearInterval(S.alive);
const state = await S.pages.till.ctx.storageState();
await S.dropDisplay('nocam');
await S.browser.close();
S.browser = await S.pw.chromium.launch({ channel: 'msedge', args: ['--use-fake-ui-for-media-stream', '--use-fake-device-for-media-stream', `--use-file-for-fake-video-capture=${video}`] });
const ctx = await S.browser.newContext({ baseURL: S.pos, viewport: { width: 1680, height: 1050 }, timezoneId: 'Asia/Bangkok', locale: 'en-GB', permissions: ['camera'], storageState: state });
ctx.setDefaultTimeout(30000);
const page = await ctx.newPage(); S.watch(page, 'till'); S.watchTill(page);
await page.goto(S.pos);
await page.waitForTimeout(4000);
S.pages.till = { ctx, page, passwordKey: 'STAGING_RECEPTION_PASSWORD' };

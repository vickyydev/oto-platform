S.phase = 'masks: every square code-like element (an svg, img or canvas 90 px or more, or a square box of 20+ cells) is masked from now on';
S.capture = async (page, opts = {}, extra = []) => {
  await page.evaluate(() => {
    for (const s of document.querySelectorAll('svg, img, canvas, div')) {
      const r = s.getBoundingClientRect(); if (r.width < 40 || r.width > 320 || Math.abs(r.width - r.height) > 8) continue;
      const media = s.tagName !== 'DIV' && r.width >= 90;
      const grid = s.tagName === 'DIV' && s.querySelectorAll('*').length >= 20;
      const svgCells = s.tagName === 'svg' && s.querySelectorAll('rect, path').length >= 3 && r.width >= 60;
      if (media || grid || svgCells) s.setAttribute('data-zz-qr', '1');
    }
  }).catch(() => {});
  try { return await S.captureBase(page, opts, [...extra, page.locator('[data-zz-qr]')]); }
  finally { await page.evaluate(() => { for (const s of document.querySelectorAll('[data-zz-qr]')) s.removeAttribute('data-zz-qr'); }).catch(() => {}); }
};
await S.shot(S.till, '08f-A-paid-once-till-masked.png');
return 'ok';

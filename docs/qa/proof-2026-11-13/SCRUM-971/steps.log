const line = (k, what) => [`${S.dev[k].label}: changed ${what}; nothing else typed.`, `  requests sent: ${r[k].requests.length}`, ...r[k].requests.map(s => `  ${s.method} ${s.path}\n  body: ${s.body}`), `  answer: ${JSON.stringify(r[k].response)}`, `  read back: address ${r[k].after.address}  model ${r[k].after.model}  protocol ${r[k].after.protocol}  label ${r[k].after.label}  settings ${JSON.stringify(r[k].after.settings)}`];
await S.txtShot([`A settings section changed on purpose through the Console Edit form (${new Date().toISOString()})`, '', ...line('receipt', 'Paper width 576 -> 512 dots'), '', ...line('band', 'Sensing "Gap between labels" -> "Black mark on the band"')].join('\n'),
  '01l-console-edit-settings-on-purpose-requests.png', 'Point 1: a changed settings section is sent, and nothing else');

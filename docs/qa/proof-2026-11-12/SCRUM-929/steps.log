S.three = async (name, caption) => {
  const at = new Date();
  const [a, b, c] = await Promise.all([S.cap(till), S.cap(dA), S.cap(dB)]);
  const when = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Bangkok', hour: '2-digit', minute: '2-digit', second: '2-digit' }).format(at);
  const sheet = await S.tills.A.ctx.newPage(); await sheet.setViewportSize({ width: 2400, height: 700 });
  const fig = (label, buf, flex) => `<figure style="margin:0;flex:${flex}"><figcaption style="font-size:13px;margin-bottom:3px">${label}</figcaption><img style="width:100%;border:1px solid #888" src="data:image/png;base64,${buf.toString('base64')}"></figure>`;
  await sheet.setContent(`<html><body style="margin:0;background:#fff;font:15px system-ui;color:#111"><div style="padding:8px 12px"><b>SCRUM-929</b> · ${caption} · captured together at ${when} Bangkok</div><div style="display:flex;gap:10px;padding:0 10px 10px;align-items:flex-start">${fig('Till A (staff screen)', a, 1440)}${fig('Display A, paired to till A', b, 1280)}${fig('Display B, paired to ANOTHER ZZ TEST till (B)', c, 1280)}</div></body></html>`);
  await sheet.screenshot({ path: S.resolve(S.out, name), fullPage: true }); await sheet.close();

=== 2026-11-12T10:42:41.022Z clean up: retire the till, sign out
S.phase = 'clean up: retire the till, sign out';
const out = {};
S.assert.equal((await S.call('GET', `/stations/${S.station.id}`)).body.station.name, S.fixtureName);
out.devicesCleared = (await S.call('PATCH', `/stations/${S.station.id}`, { devices: [] })).status;
out.retired = (await S.call('DELETE', `/stations/${S.station.id}`)).status;
const st = (await S.call('GET', `/branches/${S.branchId}/stations?includeArchived=true`)).body.stations.find(s => s.id === S.station.id);
out.readBack = { archived: Boolean(st.archived), devices: st.devices.length };
const till = S.till;
const before = (await till.request.get('/api/me')).status();
if (before === 200) out.tillSignOut = (await till.request.post('/api/auth/sign-out', { headers: { 'idempotency-key': S.randomUUID() } })).status();
out.tillMe = (await till.request.get('/api/me')).status();
await S.pages.till.ctx.close(); delete S.pages.till; S.till = null;
const board = await S.boardApi();
out.boardZz909 = board.families.filter(f => /ZZ TEST 909/.test(f.guardianName)).map(f => ({ guardian: f.guardianName, children: f.children.map(c => c.status) }));
const party = await S.call('GET', `/parties/${S.partyId}?branchId=${S.branchId}`);
out.partyReadBack = party.status;
S.receipt.cleanup.station = out.readBack;
S.receipt.cleanup.tillSession = { signOut: out.tillSignOut ?? null, me: out.tillMe };
S.receipt.cleanup.boardAfter = out.boardZz909;
S.receipt.cleanup.leftover = 'The phone till context (reception account, own ZZ TEST till) was closed before it was signed out; that one session ends at its own expiry. Not force-ended: the account-wide revoke would also end the sessions of the other proofs using the same account.';
await S.admin.post('/api/auth/sign-out', { headers: { 'idempotency-key': S.randomUUID() } });
out.adminMe = (await S.admin.get('/api/me')).status();
S.receipt.cleanup.adminMe = out.adminMe;
S.receipt.finishedAt = new Date().toISOString();
S.receipt.passed = Object.values(S.receipt.points).every(p => p.pass);
S.save();
return out;

S.phase = 'clean up: the phone till signed out; the own ZZ TEST till retired; the display read back; A and B deactivated and read back; the read-back picture; the admin signed out';
const out = { signOuts: {} };
for (const label of Object.keys(S.pages)) out.signOuts[label] = await S.signOut(label);
S.phone = null;
// any own sale still open on the till? (none expected: three refunded, one voided)
out.salesNow = (await S.stationSales()).map(s => ({ receipt: s.receiptNumber, status: s.status }));
const st = (await S.call('GET', `/stations/${S.station.id}`)).body.station;
S.assert.ok(/^ZZ TEST SCRUM-878/.test(st.name));
const p = await S.call('PATCH', `/stations/${S.station.id}`, { devices: [] });
const del = await S.call('DELETE', `/stations/${S.station.id}`);
const back = (await S.call('GET', `/branches/${S.branchId}/stations?includeArchived=true`)).body.stations.find(s => s.id === S.station.id);
out.station = { prefix: back?.codePrefix, patch: p.status, del: del.status, archived: back?.archived ?? null, devices: back?.devices?.length ?? null };
S.receipt.cleanup.station = out.station;
const disp = (await S.call('GET', `/stations/${S.station.id}/displays`));
out.displays = { status: disp.status, connected: (disp.body?.displays ?? []).filter(x => x.connected).length, revokedEarlier: (S.receipt.cleanup.displays ?? []).map(x => `${x.label} revoked`) };
// A and B: sessions ended, then deactivated (the Login Users "Deactivate"), then read back
out.accounts = {};
for (const who of ['A', 'B']) {
  const a = S.acct[who];
  S.assert.ok(S.isZz(a.name));
  const rv = await S.call('POST', `/accounts/${a.id}/sessions/revoke`);
  const de = await S.call('PATCH', `/accounts/${a.id}`, { status: 'inactive' });
  const row = (await S.call('GET', `/accounts?q=${a.local.slice(1)}`)).body.accounts.find(x => x.id === a.id);
  const sessions = (await S.call('GET', `/accounts/${a.id}/sessions?limit=50`)).body;
  const attempt = await S.trySignIn(who);
  out.accounts[who] = { revoke: rv.status, deactivate: de.status, statusNow: row?.status, liveSessions: (sessions.sessions ?? []).filter(s => s.status !== 'ended').length, sessionsTotal: sessions.total, signInAttempt: attempt };
}
S.receipt.cleanup.accounts = out.accounts; S.save();
const rows = [];
rows.push(['login user ZZ TEST Session A', `inactive: ${out.accounts.A.statusNow}; live sessions ${out.accounts.A.liveSessions} of ${out.accounts.A.sessionsTotal}; sign-in with its own password → ${out.accounts.A.signInAttempt.status} ${out.accounts.A.signInAttempt.code ?? ''} "${out.accounts.A.signInAttempt.message ?? ''}"`]);
rows.push(['login user ZZ TEST Session B', `inactive: ${out.accounts.B.statusNow}; live sessions ${out.accounts.B.liveSessions} of ${out.accounts.B.sessionsTotal}; sign-in with its own password → ${out.accounts.B.signInAttempt.status} ${out.accounts.B.signInAttempt.code ?? ''} "${out.accounts.B.signInAttempt.message ?? ''}"`]);
for (const r of S.receipt.cleanup.refunds) rows.push([`sale ${r.receipt ?? '(rung up, point 9)'}`, r.skipped ? `${r.status} (no money taken)` : `refunded whole by the staging manager: ${r.status} → sale ${r.saleStatus}, refundable ${r.refundable}`]);
rows.push(['own ZZ TEST till', `${out.station.prefix}: archived ${out.station.archived}, devices ${out.station.devices}`]);
rows.push(['ZZ TEST display d1', `revoked; connected displays on the till now ${out.displays.connected}`]);
rows.push(['walk-in numbers used', `${(S.receipt.numbers.used ?? []).length}, no member made on any (${S.receipt.cleanup.members.filter(m => m.member).length} found)`]);
rows.push(['families on the board with an own number', JSON.stringify(S.receipt.cleanup.boardOwnNumbers)]);
rows.push(['browser sessions', Object.entries(S.receipt.cleanup.signOuts ?? {}).map(([k, v]) => `${k} ${v.signOut}→me ${v.meAfter}`).join(', ')]);

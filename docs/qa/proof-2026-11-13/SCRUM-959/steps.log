S.phase = 'clean up: the manager refunds the part-paid orders through History';
const mgr = S.pages.mgr?.page ?? await S.signIn('mgr', 'STAGING_MANAGER_PHONE', 'STAGING_MANAGER_PASSWORD', { width: 1440, height: 900 });
S.mgr = mgr;
await S.unlock('mgr');
const out = [];
const parts = (await S.stationSales()).filter(s => s.status === 'tendering' && s.partPaid);
let first = true;
for (const s of parts) {
  S.assert.equal(s.stationId, S.station.id);
  const hhmm = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Bangkok', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(s.occurredAt));
  const money = (s.totals.grossSatang / 100).toString().replace('.', '\\.');
  await mgr.goto('/history'); await mgr.waitForTimeout(4500);
  await S.markMine(mgr, [hhmm]);
  const card = mgr.locator('button[data-zz]').filter({ hasText: new RegExp(hhmm) }).filter({ hasText: /Partly paid/ }).filter({ hasText: new RegExp(`฿${money}`) }).first();
  if (!(await card.count())) { out.push({ id: s.id.slice(-6), hhmm, found: false }); continue; }
  await card.click(); await mgr.waitForTimeout(3500);
  const body = S.flat(await mgr.locator('body').innerText());
  S.assert.ok(body.includes(S.fixtureName), 'my own sale');
  await mgr.getByTestId('refund-sale').click();
  const dialog = mgr.getByRole('dialog');
  await dialog.getByRole('button', { name: 'Service recovery', exact: true }).click();
  await dialog.locator('textarea').first().fill('ZZ TEST SCRUM-959 proof clean-up: part-paid order refunded whole');
  const press = dialog.getByRole('button', { name: /^Refund ฿/ });
  const label = S.flat(await press.innerText());
  if (first) { await S.markMine(mgr, [hhmm]); await S.shot(mgr, '24a-manager-refund-dialog-part-paid-order.png'); first = false; }
  const resp = mgr.waitForResponse(x => new URL(x.url()).pathname === `/api/sales/${s.id}/refunds` && x.request().method() === 'POST', { timeout: 30000 }).catch(() => null);
  await press.click();
  const rr = await resp;
  await mgr.waitForTimeout(2500);
  const after = await S.sale(s.id);
  out.push({ id: s.id.slice(-6), hhmm, gross: s.totals.grossSatang / 100, label, status: rr ? rr.status() : null, saleAfter: after.sale.status, refundStatus: after.refundStatus ?? null });
}
S.receipt.cleanup.partPaidRefunds = out; S.save();
return out;

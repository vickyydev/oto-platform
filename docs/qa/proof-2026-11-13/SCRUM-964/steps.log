S.phase = '1: A\'s session ended (admin route on the own ZZ TEST account); B signs in on the same till; the offer (rung up: Continue only); B presses Continue; the display notice watched until the display follows';
const { expect } = S;
const till = S.till, d = S.d;
const rv = await S.revoke('A');
const k = await S.kick('desk');
const line = await S.waitEnded(till);
const lockText = S.flat(await S.bodyText(till)).slice(0, 500);
await S.both('01b-A-session-ended-sign-in-form-display-holds.png', 'point 1 — A\'s session ended at the payment step: the sign-in form; the display', till, d);
S.picks = []; S.pickAnswers = [];
const st = await S.formSignIn(till, 'B');
const after = await S.afterSignIn(till);
await till.getByRole('heading', { name: 'A sale is open on this till' }).waitFor({ timeout: 30000 });
await till.waitForTimeout(800);
const offerLine = S.flat(await till.getByTestId('kept-sale-offer').innerText());
const rungLine = S.flat(await till.getByTestId('kept-sale-rung-up').innerText().catch(() => ''));
const buttons = await till.getByRole('button').evaluateAll(bs => bs.map(b => b.innerText.replace(/\s+/g, ' ').trim()).filter(Boolean));
await S.shot(till, '01c-B-offer-rung-up-continue-only.png');
// watch the till's notice line from the press on
await till.evaluate(() => {
  window.__notes = []; let last = null;
  const look = () => { const el = [...document.querySelectorAll('*')].find(e => e.children.length <= 3 && /^Display (connection|connected)/.test((e.innerText || '').trim())); const t = el ? el.innerText.replace(/\s+/g, ' ').trim() : null; if (t !== last) { last = t; window.__notes.push({ at: Date.now(), t }); } };
  window.__noteObs = new MutationObserver(look); window.__noteObs.observe(document.body, { subtree: true, childList: true, characterData: true }); look();
});
const tCont = Date.now();
await till.getByRole('button', { name: 'Continue this sale', exact: true }).click();
await S.paymentStep(till).waitFor({ timeout: 30000 });
await till.waitForTimeout(2500);
const firstNotice = await S.notice(till);
await S.both('01d-B-continued-display-held-notice.png', 'point 1 — B pressed Continue: the payment step; the till says the display is still held under the ended session', till, d);
const samples = [];
let connectedAt = null;
for (let i = 0; i < 60; i++) {
  const n = await S.notice(till);
  const dt = S.flat(await d.locator('body').innerText()).slice(0, 220);
  samples.push({ sAfterContinue: Math.round((Date.now() - tCont) / 1000), sAfterEnd: Math.round((Date.now() - rv.atMs) / 1000), notice: n, display: dt });
  if (n.some(x => /^Display connected/.test(x))) { connectedAt = Date.now(); break; }
  await till.waitForTimeout(2000);
}
const notes = await till.evaluate(() => window.__notes.map(x => ({ ...x })));
await S.both('01e-B-notice-gone-display-connected.png', 'point 1 — the ended session\'s hold ran out: the notice is gone, the display is connected to B\'s till', till, d);
S.receipt.reads.p1b = { revoke: rv, kick: k, line, lockText, signIn: st, ...after, stationPicks: S.picks.length, pickAnswers: S.pickAnswers, offerLine, rungLine, buttons,
  continuedAt: new Date(tCont).toISOString(), firstNotice, notices: notes.map(x => ({ sAfterContinue: Math.round((x.at - tCont) / 100) / 10, sAfterEnd: Math.round((x.at - rv.atMs) / 100) / 10, text: x.t })),
  connectedSAfterContinue: connectedAt ? Math.round((connectedAt - tCont) / 100) / 10 : null, connectedSAfterEnd: connectedAt ? Math.round((connectedAt - rv.atMs) / 100) / 10 : null, samples };
S.save();
return S.receipt.reads.p1b;

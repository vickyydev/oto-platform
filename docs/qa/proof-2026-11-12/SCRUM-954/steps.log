const { expect } = S;
S.phase = '2: SCRUM-954 (4) sizes at 1024x600 (each step), the box and its keys above the bar (SCRUM-894), the language menu choices at both shapes';
const till = S.till, d = S.d;
const c = d.getByTestId('display-consent');
const out = {};
if (await S.keys(d).count()) await S.hideKeys(d);
// the language menu's choices at 600x1024
const langBtn = d.getByRole('button', { name: 'Change language' });
await langBtn.tap(); await d.waitForTimeout(500);
const menuSizes = () => d.evaluate(() => {
  const b = [...document.querySelectorAll('button')].find(x => x.getAttribute('aria-label') === 'Change language' || x.getAttribute('aria-label') === 'เปลี่ยนภาษา');
  const menu = b?.parentElement?.querySelector(':scope > div');

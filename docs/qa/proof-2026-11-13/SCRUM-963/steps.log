const { expect } = S;
S.phase = '1/4: family A on the counter display, 1 Kid no adult: child name with the keys, the age picker sizes at 600x1024, to Care details';
const till = S.till, d = S.d;
S.receipt.numbers.A = S.free[0];
const out = {};
await S.keypad(d.locator('body'), S.free[0], { tap: true });
await d.getByRole('button', { name: 'Continue', exact: true }).tap();
const offer = till.getByRole('dialog', { name: 'New member?', exact: true });
await expect(offer).toContainText(S.spaced(S.free[0]));
await offer.getByRole('button', { name: 'Continue as walk-in', exact: true }).click();
await S.ticket(till, 1, 0);
await till.getByRole('heading', { name: 'Children playing alone', exact: true }).waitFor({ timeout: 30000 });
const c = d.getByTestId('display-consent');
await c.waitFor({ timeout: 30000 });
await d.waitForTimeout(1500);
await S.shot(d, '01a-600-form-step1-opened.png');
await c.getByTestId('consent-child-name').tap();
await expect.poll(() => S.keys(d).count()).toBe(1);
await d.waitForTimeout(400);
out.namePlacing600 = await S.placing(d, 'consent-child-name');
await S.typeKeys(d, 'ZZ TEST AYA');
await S.hideKeys(d); await d.waitForTimeout(400);
// the age picker, step by step
const ageBtn = c.getByRole('button', { name: /Tap to set age|yrs/ }).first();
await ageBtn.tap();
const dlg = d.getByRole('dialog').last(); await dlg.waitFor(); await d.waitForTimeout(600);
out.pickerAge600 = await S.pickerSizes(d);
await S.shot(d, '04a-600x1024-age-picker-age-step-close-and-crumbs.png');
await dlg.getByRole('button', { name: '6', exact: true }).tap(); await d.waitForTimeout(500);
out.pickerMonth600 = await S.pickerSizes(d);
await S.shot(d, '04b-600x1024-age-picker-month-step-back-close-crumbs.png');
await dlg.getByRole('button', { name: /^Jan/ }).first().tap(); await d.waitForTimeout(500);
out.pickerDay600 = await S.pickerSizes(d);
await dlg.getByRole('button', { name: '1', exact: true }).first().tap(); await d.waitForTimeout(500);
out.pickerConfirm600 = await S.pickerSizes(d);
await dlg.getByRole('button', { name: /Confirm/ }).tap();
await dlg.waitFor({ state: 'hidden' });
await d.waitForTimeout(1200);
out.state = await S.displayState(d);
out.mirror = await S.mirrorState(till);
await c.getByRole('button', { name: 'Continue', exact: true }).tap();
await c.getByTestId('consent-allergies').waitFor();
await d.waitForTimeout(1000);
out.care = await S.displayState(d);
await S.shot(d, '01b-600-form-care-details-online.png');
S.receipt.reads.p1start = out; S.save();
return out;

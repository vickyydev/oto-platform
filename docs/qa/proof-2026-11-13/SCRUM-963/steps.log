const { expect } = S;
S.phase = '1: HIGH — Care details, the display cut off, ไทย chosen: no Retry, nothing pushed down, still typing; back after about 8 s, nothing pressed';
const till = S.till, d = S.d, ctx = S.displays.main.ctx;
const c = d.getByTestId('display-consent');
const out = {};
const WAIT = /Please wait for the team to confirm this change|กรุณารอทีมงานยืนยันการเปลี่ยนแปลงนี้/;
await c.getByTestId('consent-allergies').scrollIntoViewIfNeeded(); await d.waitForTimeout(300);
out.before = await S.geo(d);
await ctx.setOffline(true);
const off = Date.now();
for (let i = 0; i < 40; i++) { await d.waitForTimeout(200); if (await d.getByTestId('display-form-reconnecting').count()) break; }
out.lineSeenMs = Date.now() - off;
out.lineSeen = await S.geo(d);
await S.shot(d, '01c-600-care-offline-reconnecting-line-english.png');
await S.openLang(d);
await d.getByRole('button', { name: 'ไทย', exact: true }).last().tap();
out.thaiChosenMs = Date.now() - off;
await d.waitForTimeout(250);
out.atOnce = await S.geo(d);
out.atOnce.state = await S.displayState(d);
await S.shot(d, '01d-600-care-offline-thai-at-once-no-retry-not-pushed-down.png');
out.atOnceShotMs = Date.now() - off;
// a box still takes typing: allergies with the screen's own keys
const box = c.getByTestId('consent-allergies');
out.allergiesTap = await box.tap({ timeout: 3000 }).then(() => 'took the tap').catch(e => 'refused: ' + String(e.message).split('\n')[0].slice(0, 80));
await expect.poll(() => S.keys(d).count(), { timeout: 3000 }).toBe(1).catch(() => null);
out.keysOpen = await S.keys(d).count();
out.spaceKey = await d.evaluate(() => [...document.querySelectorAll('[data-testid="screen-keyboard"] button')].map(b => (b.getAttribute('aria-label') || b.textContent).trim()).filter(t => t.length > 1).slice(0, 6));
await S.typeKeys(d, 'ZZ TEST nuts');
out.typedMs = Date.now() - off;
out.typedValue = await box.inputValue();
out.whileTyped = await S.geo(d);
out.placingTyped = await S.placing(d, 'consent-allergies');
out.tillCopyWhileOffline = (await S.mirrorState(till)).allergies;
await S.both('01e-offline-thai-typed-with-the-keys-till-copy-not-yet.png', 'Point 1 — display cut off: ไทย chosen and "ZZ TEST nuts" typed with the screen keys; no Retry bar, the form free; the till copy has not heard yet', till, d);
out.offlineBeforeRestoreMs = Date.now() - off;
const restoreAt = 8000;
if (Date.now() - off < restoreAt) await d.waitForTimeout(restoreAt - (Date.now() - off));
out.offlineMs = Date.now() - off;
out.beforeRestore = await S.geo(d);
await ctx.setOffline(false);
const on = Date.now();
const frames = [];
let lineGone = null, tillHas = null;
for (let i = 0; i < 60; i++) {
  await d.waitForTimeout(250);
  const g = await S.geo(d); const m = await S.mirrorState(till);
  if (lineGone == null && !g.line) lineGone = Date.now() - on;
  if (tillHas == null && m.allergies === out.typedValue) tillHas = Date.now() - on;
  frames.push({ ms: Date.now() - on, line: !!g.line, alert: g.alert?.text ?? null, inert: g.formInert, status: g.status.join(' | '), tillAllergies: m.allergies });
  if (lineGone != null && tillHas != null && i > 8) break;
}
out.lineGoneMs = lineGone; out.tillHasAllergyMs = tillHas;
out.frames = frames.filter((f, i, a) => i === 0 || i === a.length - 1 || JSON.stringify({ ...f, ms: 0 }) !== JSON.stringify({ ...a[i - 1], ms: 0 }));
out.after = await S.geo(d);
out.afterState = await S.displayState(d);
out.mirror = await S.mirrorState(till);
out.tillLanguage = await till.evaluate(() => { const m = document.querySelector('[data-testid="consent-mirror"]'); const t = m?.innerText ?? ''; return { thaiInMirror: /[\u0E00-\u0E7F]/.test(t), heading: m?.querySelector('h2')?.textContent.trim() ?? null, langButtons: [...(m?.querySelectorAll('button') ?? [])].filter(b => /language|ภาษา/i.test(b.getAttribute('aria-label') || '')).map(b => b.textContent.trim()), languageWords: (t.match(/(ภาษา|Language)[^\n]{0,40}/) ?? [null])[0] }; });
out.noWaitLine = { atOnce: !out.atOnce.status.some(s => WAIT.test(s)), whileTyped: !out.whileTyped.status.some(s => WAIT.test(s)), after: !out.after.status.some(s => WAIT.test(s)) };
await S.both('01f-online-again-line-gone-till-copy-has-allergy-and-thai.png', `Point 1 — the connection back after ${Math.round(out.offlineMs / 100) / 10} s: the reconnecting line gone, nothing pressed; the till copy has the allergy and the form's language`, till, d);
await S.hideKeys(d).catch(() => {});
S.receipt.reads.p1offlineThai = out; S.save();
return out;

r.newPrintouts = fresh.map(p => ({ seq: p.seq, at: p.at, widthDots: p.widthDots, heightDots: p.heightDots, jobBytes: p.jobBytes, truncated: p.truncated }));
r.eventsSince = after.events.filter(e => Date.parse(e.at) >= t0 - 1000).filter(e => e.kind !== 'status.read').map(e => ({ at: e.at, kind: e.kind, detail: e.detail }));
r.drawerKicksSince = r.eventsSince.filter(e => e.kind === 'drawer.kick').length;
const cmds = await S.commands(S.box.id, 15);
r.commandsSince = cmds.filter(c => Date.parse(c.createdAt) >= t0 - 1000).map(c => ({ kind: c.kind, state: c.state, payloadKind: c.payload?.kind ?? null }));
S.receipt.reads.p2card = r;
return r;

# The OTO booth box: the agent, its printing and sync, and the booth page on
# http://127.0.0.1:8780/ for the television (SCRUM-223). Installed by
# scripts/pi/install.sh, which fills in @NODE@.
[Unit]
Description=OTO booth box (agent, printing, sync, booth page on 127.0.0.1:8780)
# Wanted, not required: a booth in a mall boots before the router has its
# line, and it must play (and print) from its own copy in the meantime.
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
# Never let a crash loop hammer the card or the api: at most 10 starts a
# minute. These are [Unit] settings; systemd ignores them under [Service].
# A box that hits the limit is not left dead: the watchdog timer starts it
# again a minute later.
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=oto-box
Group=oto-box
EnvironmentFile=/etc/oto-box/config
ExecStart=@NODE@ --disable-warning=ExperimentalWarning /opt/oto-box/current/oto-box.mjs run
# 75 is the runner asking for a fresh process after a claim gave it a new identity.
Restart=always
RestartSec=3
TimeoutStopSec=15
# What the box may touch: its own home, nothing else.
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/oto-box
PrivateTmp=yes
# Devices: the counter scanner only (SCRUM-700). Printing is over the network.
# The box reads the Zebra cradle itself — its input event node in HID mode, or
# /dev/ttyACM* in CDC mode — so /dev is the host's, and the device allow-list
# below lets the agent open the standard pseudo-devices, input event nodes and
# USB serial ports, read-only, and nothing else; of those, file permissions
# give its user the cradle alone (the udev rule the installer writes,
# 61-oto-box-scanner.rules). The serial driver is loaded at boot
# (modules-load.d) so its group is known when this starts.
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=char-input r
DeviceAllow=char-ttyACM r
CapabilityBoundingSet=~CAP_MKNOD CAP_SYS_RAWIO
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target

  S.assert.equal((await ctx.post('/api/auth/sign-in', { data: { phone: S.need('STAGING_ADMIN_PHONE'), password: S.need('STAGING_ADMIN_PASSWORD') } })).status(), 200);
  const get = async p => { const x = await ctx.get('/api' + p); return { status: x.status(), body: await x.json().catch(() => null) }; };
  const me = (await get('/me')).body;
  const oc = me?.operatorContext ?? {};
  r.contextKeys = Object.keys(oc);
  const ops = (await get('/operators')).body;
  const second = (ops.operators ?? ops).find(o => o.name === 'Second Operator');
  const rev = oc.revision ?? oc.epoch ?? oc.operatorRevision ?? 0;
  const sw = await ctx.put('/api/me/session/operator', { data: { operatorId: second.id, expectedRevision: rev }, headers: { 'idempotency-key': S.randomUUID() } });

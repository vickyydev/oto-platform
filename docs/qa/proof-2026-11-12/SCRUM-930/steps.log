=== 2026-11-12T14:16:47.301Z clean up: members, the till retired, the printers archived, read back
S.phase = 'clean up: members, the till retired, the printers archived, read back';
const out = { members: [] };
for (const [key, phone] of Object.entries(S.receipt.numbers)) {
  const m = (await S.call('GET', `/members/lookup?phone=${encodeURIComponent(phone)}`)).body?.member ?? null;
  if (m) {
    S.assert.ok(`${m.nickname ?? ''} ${m.name ?? ''}`.includes('ZZ TEST'), 'only own named test members');
    const d = await S.call('DELETE', `/members/${m.id}`);
    out.members.push({ key, archived: d.status, lookupAfter: (await S.call('GET', `/members/lookup?phone=${encodeURIComponent(phone)}`)).body?.member ? 'still found' : 'not found' });
  } else out.members.push({ key, member: 'none' });
}
const row = await S.stationRow();
S.assert.ok(row.name.startsWith('ZZ TEST 930 '), 'own till');
out.devicesCleared = (await S.call('PATCH', `/stations/${S.station.id}`, { devices: [] })).status;
out.retired = (await S.call('DELETE', `/stations/${S.station.id}`)).status;
const st = await S.stationRow();
out.stationReadBack = { name: st.name, archived: Boolean(st.archived), devices: st.devices.length };
out.printers = [];
for (const [role, d] of Object.entries(S.dev)) {
  const now = (await S.devicesOnBox()).find(x => x.id === d.id);
  S.assert.ok(now.label.startsWith('ZZ TEST 930 '), 'own printer');
  const del = now.archived ? { status: 'already' } : await S.call('DELETE', `/devices/${d.id}`);
  out.printers.push({ role, delete: del.status, stillAssignedTo: (del.body?.stillAssignedTo ?? []).length });
}
const after = (await S.devicesOnBox()).filter(x => Object.values(S.dev).some(d => d.id === x.id));
out.printersReadBack = after.map(x => ({ label: x.label, archived: Boolean(x.archived) }));
out.consoleA = await S.close('console');
out.openPages = Object.keys(S.pages);
S.receipt.cleanup.records = out;
return out;

await S.typePassword(till.locator('input[type="password"][autocomplete="current-password"]'), 'A');
const [u] = await Promise.all([
  till.waitForResponse(r => new URL(r.url()).pathname === '/api/auth/unlock' && r.request().method() === 'POST'),
  till.getByRole('button', { name: 'Unlock', exact: true }).click(),
]);
await S.landing(till).waitFor({ timeout: 30000 });
await till.waitForTimeout(800);
const back = await S.readLock(till);
await S.shot(till, '12b-2-ordinary-unlock-back.png');
const out = { lockedHeading: locked.heading, lockedText: locked.text.slice(0, 300), unlockStatus: u.status(), sessionEndedLineWhileLocked: await S.endedLine(till).count(), afterUnlockHeading: back.heading, landing: await S.landing(till).isVisible() };
S.receipt.reads.p12b = out; S.save();
return out;

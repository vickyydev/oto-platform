const { expect } = S;
S.phase = '7: SCRUM-953 (5) History on the desk: the coded sale D (cards add up to the Subtotal) and the no-code sale C (as before)';
const till = S.till;
const out = {};
await S.unlock('till');
S.mine = () => [S.fam.A?.receipt, S.fam.L?.receipt, S.fam.C?.receipt, S.fam.D?.receipt, S.fam.P?.receipt, S.fam.O?.receipt, S.fam.T?.receipt].filter(Boolean);
S.cardsRead = page => page.evaluate(() => {
  const money = t => (t.match(/[−-]?฿[0-9][0-9,]*(?:\.[0-9]+)?/g) ?? []);
  const toN = s => Number(String(s).replace(/[฿,−-]/g, '')) * (/^[−-]/.test(s) ? -1 : 1);
  const cards = [...document.querySelectorAll('div.rounded-xl.border.bg-background\/40')].map(c => {
    const head = c.firstElementChild; const rows = [...c.querySelectorAll(':scope > div:nth-child(2) > div')];
    return { head: head?.innerText.replace(/\s+/g, ' ').trim(), headAmount: money(head?.innerText ?? '').at(-1) ?? null, lines: rows.map(r => r.innerText.replace(/\s+/g, ' ').trim()) };
  });
  const text = document.body.innerText.replace(/\s+/g, ' ');
  const subtotal = text.match(/Subtotal (฿[0-9,.]+)/)?.[1] ?? null;
  const code = text.match(/ZZ TEST SCRUM-954 proof ZZTEST954A (−฿[0-9,.]+)/)?.[1] ?? null;
  const vat = text.match(/VAT \(included\) (฿[0-9,.]+)/)?.[1] ?? null;
  const total = text.match(/Total paid (฿[0-9,.]+)/)?.[1] ?? null;
  const sumCards = cards.reduce((s, c) => s + (c.headAmount ? toN(c.headAmount) : 0), 0);
  const payments = text.match(/Payment[s]? (.{0,200}?)(Reprint|Refund)/)?.[1] ?? null;
  return { cards, subtotal, code, vat, total, sumOfCards: Math.round(sumCards * 100) / 100, cardsEqualSubtotal: subtotal ? Math.abs(sumCards - toN(subtotal)) < 0.005 : null, payments };
});
await till.goto('/history'); await till.waitForTimeout(5000);

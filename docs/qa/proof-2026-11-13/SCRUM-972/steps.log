=== 2026-11-13T01:58:36.598Z 3: the manager refunds the cash sale (whole)
S.phase = '3: the manager refunds the cash sale (whole)';
S.mgrRefund = async (saleId, reason) => {
  const mgr = await S.pw.request.newContext({ baseURL: S.pos });
  const out = {};
  try {
    out.signIn = (await mgr.post('/api/auth/sign-in', { data: { phone: S.need('STAGING_MANAGER_PHONE'), password: S.need('STAGING_MANAGER_PASSWORD') } })).status();
    const s = await S.sale(saleId);
    S.assert.equal(s.sale.stationId, S.station.id, 'own ZZ TEST 972 till');
    S.assert.ok(String(s.sale.receiptNumber).startsWith('Z972'), 'own ZZ receipt series');
    const res = await mgr.post(`/api/sales/${saleId}/refunds`, { headers: { 'idempotency-key': S.randomUUID() }, data: { mode: 'whole', reason } });
    const b = await res.json().catch(() => null);
    out.refund = { status: res.status(), code: b?.error?.code ?? null, message: res.status() >= 400 ? (b?.error?.message ?? null) : null, amount: b?.refund?.amountSatang != null ? b.refund.amountSatang / 100 : null, refundStatus: b?.refund?.status ?? null, keys: b ? Object.keys(b) : null, slices: b?.refund?.slices ?? b?.refund?.tenders ?? b?.slices ?? null };
  } finally {
    const so = await mgr.post('/api/auth/sign-out', { headers: { 'idempotency-key': S.randomUUID() } });
    out.signOut = { status: so.status(), me: (await mgr.get('/api/me')).status() };
    await mgr.dispose();
  }
  return out;
};
const r = await S.mgrRefund(S.p2.sale, 'ZZ TEST SCRUM-972 proof: cash after a refused card');
const s = await S.sale(S.p2.sale);
r.after = { status: s.sale.status, refunded: (s.sale.totals.refundedSatang ?? 0) / 100, refundStatus: s.refundStatus ?? null, refunds: (s.refunds ?? []).map(x => ({ status: x.status, amount: (x.amountSatang ?? 0) / 100, mode: x.mode ?? null })) };
S.receipt.reads.p3refund = r;
const verdict = S.receipt.reads.p3.paymentSuccessful && !S.receipt.reads.p3.any409 && S.receipt.reads.p3.receiptJobs === 1 && S.receipt.reads.p3.newPrintouts.length === 1 && r.refund.status === 200;
S.point('3', verdict ? 'PASS' : 'FAIL', ['03a-till-cash-chosen-after-refusal.png', '03b-till-cash-payment-successful.png', '03c-api-cash-sale-one-receipt.png'], { paid: S.receipt.reads.p3.sale, any409: S.receipt.reads.p3.any409, receiptJobs: S.receipt.reads.p3.receiptJobs, printouts: S.receipt.reads.p3.newPrintouts.length, refund: r.refund, after: r.after });
const t = S.readFileSync(S.resolve(S.out, '03c-api-cash-sale-one-receipt.txt'), 'utf8').trim();
await S.txtShot(t + `\n\nTHE MANAGER'S REFUND (POST /api/sales/<id>/refunds { mode: "whole" }, manager session): HTTP ${r.refund.status} amount ฿${r.refund.amount}\nGET /api/sales/<id> after: ${JSON.stringify(r.after)}`, '03c-api-cash-sale-one-receipt.png', 'Point 3: the same sale paid by cash, no refusal, one receipt; refunded by the manager');
return r;

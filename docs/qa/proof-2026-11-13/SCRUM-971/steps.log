=== 2026-11-13T02:51:41.192Z hunt: End of Day's saved list on days already closed (READ ONLY, the last 21 days at Central Floresta): which band codes the saved rows carry
S.phase = 'hunt: End of Day\'s saved list on days already closed (READ ONLY, the last 21 days at Central Floresta): which band codes the saved rows carry';
const r = { days: [] };
const shortRe = /^[0-9A-Z]{1,6}-[0-9A-Z]{6}$/;
for (let i = 1; i <= 21; i++) {
  const d = new Date(Date.parse(S.today + 'T12:00:00+07:00') - i * 86400000);
  const date = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Asia/Bangkok' }).format(d);
  const e = await S.call('GET', `/branches/${S.branchId}/end-of-day?date=${date}`);
  const b = e.body ?? {};
  const saved = b.override?.stranded ?? [];
  const live = b.stranded ?? [];
  if (e.status !== 200) { r.days.push({ date, status: e.status }); continue; }
  const codes = saved.map(x => x.bandCode).filter(Boolean);
  r.days.push({ date, status: b.status ?? null, closed: Boolean(b.closedAt), overrideRows: saved.length, savedBandCodes: codes.length, savedShort: codes.filter(c => shortRe.test(c)).length, savedLong: codes.filter(c => !shortRe.test(c)).map(c => ({ length: c.length, startsWith: c.slice(0, 6) })), liveRows: live.length, liveLong: live.map(x => x.bandCode).filter(c => c && !shortRe.test(c)).length });
}
S.receipt.reads.huntEodSaved = r;
const withSaved = r.days.filter(x => x.overrideRows > 0);
await S.txtShot([`READ ONLY: GET /api/branches/<Central Floresta>/end-of-day?date=<day> for the 21 days before ${S.today} (${new Date().toISOString()})`, '',
  ...r.days.map(x => `  ${x.date}  ${x.status === 200 || x.closed !== undefined ? `${x.closed ? 'closed' : 'open  '}  saved rows still inside: ${x.overrideRows ?? '-'}  band codes in them: ${x.savedBandCodes ?? 0} (short ${x.savedShort ?? 0}, long ${x.savedLong?.length ?? 0}${x.savedLong?.length ? ' — lengths ' + x.savedLong.map(l => l.length).join(', ') : ''})` : `-> ${x.status}`}`), '',
  `Days closed with a saved list: ${withSaved.length}. The long codes are counted only (they are signed gate credentials), never written here.`].join('\n'), 'h5-api-end-of-day-saved-lists-band-codes.png', 'Hunt: End of Day\'s saved list on closed days');
return { withSaved, closedDays: r.days.filter(x => x.closed).map(x => x.date) };

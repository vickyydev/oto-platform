const out = {};
const phone = S.need('STAGING_RECEPTION_PHONE');
for (const q of [phone, phone.replace(/^\+66/, ''), phone.replace(/^\+66/, '0')]) {
  const r = await S.call('GET', `/accounts?q=${encodeURIComponent(q)}`);
  out[`len${q.length}`] = { status: r.status, n: r.body?.accounts?.length ?? null };
}
const all = (await S.call('GET', '/accounts')).body?.accounts ?? [];
out.all = all.length;
const acct = all.find(a => JSON.stringify(a).includes(phone) || JSON.stringify(a).includes(phone.replace(/^\+66/, '0')));
out.found = Boolean(acct);
if (acct) {
  const page = (await S.call('GET', `/accounts/${acct.id}/sessions?limit=50`)).body;
  out.total = page?.total ?? null;
  out.onOwnTill = (page?.sessions ?? []).filter(s => s.stationId === S.station.id).map(s => ({ status: s.status, ended: Boolean(s.endedAt) }));
}
await S.admin.post('/api/auth/sign-out', { headers: { 'idempotency-key': S.randomUUID() } });
out.adminMe = (await S.admin.get('/api/me')).status();
return out;

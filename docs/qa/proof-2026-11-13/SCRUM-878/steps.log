=== 2026-11-12T18:08:08.257Z 1: A signs in at the own desk till (1680x1050); GET /api/me carries sessionEnd
S.phase = '1: A signs in at the own desk till (1680x1050); GET /api/me carries sessionEnd';
const till = await S.openTill('desk', { width: 1680, height: 1050 });
S.till = till;
const st = await S.formSignIn(till, 'A');
const after = await S.afterSignIn(till);
await S.landing(till).waitFor({ timeout: 30000 });
const me = await S.me(till);
const answeredAt = Date.now();
S.walkNames(me.body);
const end = me.body?.sessionEnd ?? null;
const atStation = JSON.stringify(me.body ?? {}).includes(S.station.id);
S.receipt.reads.p1 = { signIn: st, ...after, meStatus: me.status, sessionEnd: end, atOwnStation: atStation, accountName: me.body?.employee?.name ?? me.body?.account?.name ?? null,
  endMinusNowHours: end ? Math.round((Date.parse(end.at) - answeredAt) / 36000) / 100 : null };
await S.shot(till, '01a-desk-A-signed-in-landing.png');
await S.facts('01b-get-me-sessionEnd.png', 'SCRUM-878 point 1 — GET /api/me as ZZ TEST Session A, read on the till right after sign-in', [
  ['account', 'ZZ TEST Session A (reception at the park)'],
  ['sessionEnd.at', end?.at], ['sessionEnd.inSeconds', end?.inSeconds], ['sessionEnd.afterHours', end?.afterHours],
  ['at minus now (hours)', S.receipt.reads.p1.endMinusNowHours], ['station', atStation ? 'the own ZZ TEST desk till' : 'NOT the own till']]);
const pass = me.status === 200 && end && end.afterHours === 12 && Math.abs(end.inSeconds - 43200) <= 120 && atStation;
S.point('1', !!pass, ['01a-desk-A-signed-in-landing.png', '01b-get-me-sessionEnd.png'], { sessionEnd: end });
S.keepAlive(true);
return S.receipt.reads.p1;

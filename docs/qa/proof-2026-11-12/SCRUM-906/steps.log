S.phase = '5: the staging manager refunds the settlement whole from History; the party is as before settlement';
const r = {};
// memory: one till context closed before the manager's opens
const ph = await S.signOutTill('phone');
r.phoneSignOut = ph;
const mgr = await S.signIn('mgr', 'STAGING_MANAGER_PHONE', 'STAGING_MANAGER_PASSWORD', { width: 1680, height: 1050 });
await mgr.goto('/history'); await mgr.waitForTimeout(5000);
const sale0 = await S.sale(S.settleSale);
const rn = sale0?.sale?.receiptNumber ?? null;
r.receipt = rn;
await mgr.evaluate((rn) => {
  for (const b of document.querySelectorAll('div.space-y-2 > button.w-full.text-left')) {
    const t = b.innerText.replace(/\s+/g, ' ');
    if ((rn && t.includes(rn)) || t.includes('Z90601-')) b.setAttribute('data-zz', 'mine'); else b.removeAttribute('data-zz');
  }
}, rn);
S.inPlace = page => [page.getByLabel('Lock screen').locator('..'), S.otherSales(page)];
const mine = mgr.locator('button[data-zz]');
r.listed = [];
for (let i = 0; i < await mine.count(); i++) r.listed.push(S.flat(await mine.nth(i).innerText()).slice(0, 160));
await S.shot(mgr, '05e-history-list-settlement.png');
await mine.filter({ hasText: rn ?? 'Z90601-' }).first().click();
await mgr.waitForTimeout(3500);
S.inPlace = page => [page.getByLabel('Lock screen').locator('..')];
r.detail = S.flat(await mgr.locator('body').innerText()).match(/(Paid|Refunded|Partly paid)[^]{0,900}/)?.[0]?.slice(0, 900) ?? null;
await S.shot(mgr, '05f-history-detail-settlement-lines.png', [], { fullPage: true });
await mgr.getByTestId('refund-sale').click();
const dialog = mgr.getByRole('dialog');
await dialog.waitFor();
r.dialog = S.flat(await dialog.innerText()).slice(0, 500);
await dialog.getByRole('button', { name: 'Service recovery', exact: true }).click();
await dialog.locator('textarea').first().fill('ZZ TEST SCRUM-906 proof: refund the whole settlement');
await S.shot(mgr, '05g-manager-refund-whole.png');
const press = dialog.getByRole('button', { name: /^Refund ฿/ });
r.press = S.flat(await press.innerText());
const resp = mgr.waitForResponse(rr => new URL(rr.url()).pathname === `/api/sales/${S.settleSale}/refunds` && rr.request().method() === 'POST', { timeout: 60000 });
await press.click();
const rr = await resp;
const rb = await rr.json().catch(() => null);
await mgr.waitForTimeout(3000);
await S.shot(mgr, '05h-history-detail-after-refund.png');
const sale = await S.sale(S.settleSale);
r.refund = { status: rr.status(), amount: (rb?.refund?.amountSatang ?? 0) / 100, refundStatus: rb?.refundStatus ?? null, saleStatus: sale?.sale?.status ?? null, saleRefund: sale?.refundStatus ?? null };
const party = (await S.party(S.p1)).body;
r.settlementAfter = party?.event?.party?.settlement ?? null;
// the till's party page after the refund
const till = S.pages.till.page;

S.menuCloseUp = async (name, caption) => {
  const till = S.tills.A.page;
  await S.openTheme(till);
  const menu = till.getByRole('menu');
  const img = await menu.screenshot({ animations: 'disabled' });
  const row = await till.getByRole('button', { name: /^Switch display theme to / }).getAttribute('data-theme-preference');
  const title = await till.getByRole('button', { name: /^Switch display theme to / }).getAttribute('title');
  const sheet = await S.tills.A.ctx.newPage(); await sheet.setViewportSize({ width: 700, height: 600 });
  await sheet.setContent(`<html><body style="margin:0;font:15px system-ui;background:#fff;color:#111"><div style="padding:8px 12px"><b>SCRUM-929</b> · ${caption}<br><span style="font-size:13px">Display row: data-theme-preference="${row}", its hover title "${title}"</span></div><img style="width:520px;margin:6px 12px;border:1px solid #888;image-rendering:auto" src="data:image/png;base64,${img.toString('base64')}"></body></html>`);
  await sheet.screenshot({ path: S.resolve(S.out, name), fullPage: true }); await sheet.close();
  return { row, title };
};
return await S.menuCloseUp('01b-till-theme-menu-close-up-display-dark.png', 'Point 1 close-up: the till\'s Theme menu with a fresh paired display (the Display row shows the moon, the display\'s look)');

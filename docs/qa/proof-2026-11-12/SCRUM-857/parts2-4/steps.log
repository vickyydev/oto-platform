=== 2026-11-12T11:47:02.524Z clean up: retire the own till, sign out, read back that nothing is left
S.phase = 'clean up: retire the own till, sign out, read back that nothing is left';
const res = {};
const own = (await S.call('GET', `/stations/${S.station.id}`)).body.station;
S.assert.equal(own.name, S.fixtureName);
res.devicesOff = (await S.call('PATCH', `/stations/${S.station.id}`, { devices: [] })).status;
res.deleted = (await S.call('DELETE', `/stations/${S.station.id}`)).status;
const stations = (await S.call('GET', `/branches/${S.branchId}/stations?includeArchived=true`)).body.stations;
const mine = stations.filter(s => /ZZ TEST SCRUM-857 p2-4/.test(s.name));
res.ownTills = mine.map(s => ({ id: s.id, prefix: s.codePrefix, archived: s.archived, devices: s.devices.length }));
// the till session
const t = S.pages.till.page;
const before = (await t.request.get('/api/me')).status();
if (before === 200) res.tillSignOut = (await t.request.post('/api/auth/sign-out', { headers: { 'idempotency-key': S.randomUUID() } })).status();
res.tillMeAfter = (await t.request.get('/api/me')).status();
// leftovers
const board = (await S.call('GET', `/checkin/board?branchId=${S.branchId}`)).body;
res.boardFamiliesOfThisProof = board.families.filter(f => /ZZ TEST 857/.test(f.guardianName ?? '') || f.children.some(c => /ZZ TEST 857/.test(c.childName ?? ''))).map(f => ({ reg: f.registrationId, tab: f.tab, children: f.children.map(c => c.status) }));
const regs = (await S.call('GET', `/checkin/registrations?branchId=${S.branchId}`)).body?.registrations ?? [];
res.waitingRegistrationsOfThisProof = regs.filter(r => /ZZ TEST 857/.test(r.guardianName ?? '')).map(r => r.id);
res.registrationsReadBack = [];
for (const [fam, v] of Object.entries(S.fam)) if (v.reg) { const r = await S.registration(v.reg); res.registrationsReadBack.push({ fam, children: r.children.map(c => c.status) }); }
res.membersOnNumbers = [];
for (const n of S.free.slice(0, 10)) { const m = (await S.call('GET', `/members/lookup?phone=${n}`)).body?.member; if (m) res.membersOnNumbers.push(n); }
res.displaysStillPaired = Object.keys(S.displays);
res.displaysRevoked = S.receipt.cleanup.displays;
S.receipt.cleanup.final = res; S.save();
return res;

// the lock screen keeps the account's phone in its field: mask phone inputs from now on, and box it on 04b
const base = S.masks;
S.masks = page => [...base(page), page.locator('input[inputmode="tel"],input[type="tel"]')];
const file = S.resolve(S.out, '04b-till-signed-out-display.png');
const fs = await import('node:fs');
const png = fs.readFileSync(file).toString('base64');
const sheet = await S.tills.A.ctx.newPage();
const outB64 = await sheet.evaluate(async (src) => {
  const img = new Image(); img.src = 'data:image/png;base64,' + src; await img.decode();
  const c = document.createElement('canvas'); c.width = img.width; c.height = img.height;
  const g = c.getContext('2d'); g.drawImage(img, 0, 0);
  g.fillStyle = '#18181b'; g.fillRect(444, 262, 254, 36);
  return c.toDataURL('image/png').split(',')[1];
}, png);
await sheet.close();
fs.writeFileSync(file, Buffer.from(outB64, 'base64'));
return { boxed: true };

=== 2026-11-12T15:58:42.452Z 1: a verified ZZ TEST member (made here), split 1440
S.phase = '1: a verified ZZ TEST member (made here), split 1440';
const { expect } = S;
const till = S.till;
await S.unlock('till');
S.receipt.numbers.M = S.free[0];
S.MEMBER = 'ZZ TEST 884 Expat Verified Member';
await till.goto('/');
await S.landing(till).waitFor();
if (await till.getByTestId('language-choice').isVisible()) await till.getByTestId('language-choice-en').click();
await till.getByTestId('identify-safety').waitFor();
let scope = S.halfOf(till.getByTestId('identify-safety'));
await S.keypad(scope, S.free[0]);
await scope.getByRole('button', { name: 'Continue', exact: true }).click();
const offer = till.getByRole('dialog', { name: 'New member?', exact: true });
await expect(offer).toContainText(S.spaced(S.free[0]));
await offer.getByPlaceholder('e.g. Mali').fill(S.MEMBER);
const [created] = await Promise.all([
  till.waitForResponse(r => new URL(r.url()).pathname === '/api/members' && r.request().method() === 'POST'),
  offer.getByRole('button', { name: 'Create member', exact: true }).click(),
]);
const cm = await created.json().catch(() => null);
S.memberId = cm?.member?.id ?? null;
S.receipt.created.push({ kind: 'member', name: S.MEMBER, number: S.free[0], id: S.memberId, status: created.status() }); S.save();
await offer.waitFor({ state: 'hidden' });
await till.getByRole('heading', { name: 'Select Customer Type', exact: true }).waitFor();
// the expat rate verified with a passport, from the till's own session (the till's own route)
const verify = await till.evaluate(async ({ id }) => {
  const r = await fetch(`/api/members/${id}/tier-verification`, { method: 'POST', credentials: 'include', headers: { 'content-type': 'application/json', 'idempotency-key': crypto.randomUUID() },
    body: JSON.stringify({ toTier: 'expat', evidenceType: 'Passport', evidenceExpiresAt: '2027-11-12' }) });
  const b = await r.json().catch(() => null);
  return { status: r.status, tier: b?.member?.tier ?? null, code: b?.error?.code ?? null };
}, { id: S.memberId });
// leave this sale and come back with the number so the till reads the verified member
await till.getByRole('button', { name: 'Cancel', exact: true }).first().click().catch(() => {});
await till.waitForTimeout(1500);
await till.goto('/');
await S.landing(till).waitFor();
if (await till.getByTestId('language-choice').isVisible()) await till.getByTestId('language-choice-en').click();
await till.getByTestId('identify-safety').waitFor();
scope = S.halfOf(till.getByTestId('identify-safety'));
await S.keypad(scope, S.free[0]);
await scope.getByRole('button', { name: 'Continue', exact: true }).click();
await till.getByRole('heading', { name: 'Select Customer Type', exact: true }).waitFor({ timeout: 30000 });
await till.waitForTimeout(2500);
return { created: created.status(), memberId: Boolean(S.memberId), verify, body: S.flat(await S.tillHalfText?.(till) ?? '') };

S.phase = 'clean up: the manager refunds the three ZZ sales; the stuck one is tried for a void again';
const out = { refunds: [] };
const mgr = await S.pw.request.newContext({ baseURL: S.pos });
const si = await mgr.post('/api/auth/sign-in', { data: { phone: S.need('STAGING_MANAGER_PHONE'), password: S.need('STAGING_MANAGER_PASSWORD') } });
out.mgrSignIn = si.status();
try {
  const ids = [...S.cashSales.map(s => s.id), S.cardSale2];
  for (const id of ids) {
    const s = await S.sale(id);
    S.assert.ok([S.station1?.id ?? S.station.id, S.station2.id].includes(s.sale.stationId), 'own ZZ till');
    S.assert.ok(String(s.sale.receiptNumber).startsWith('Z952'), 'own ZZ receipt series');
    const res = await mgr.post(`/api/sales/${id}/refunds`, { headers: { 'idempotency-key': S.randomUUID() }, data: { mode: 'whole', reason: 'ZZ TEST SCRUM-952 proof cleanup' } });
    const b = await res.json().catch(() => null);
    out.refunds.push({ receipt: s.sale.receiptNumber, status: res.status(), code: b?.error?.code ?? null, message: res.status() >= 400 ? (b?.error?.message ?? null) : null, amount: b?.refund?.amountSatang != null ? b.refund.amountSatang / 100 : null, refundStatus: b?.refund?.status ?? null });
  }
  const v = await mgr.post(`/api/sales/${S.cardSale}/void`, { headers: { 'idempotency-key': S.randomUUID() }, data: { reason: 'ZZ TEST SCRUM-952 proof cleanup: card attempt never reached a terminal' } });
  const vb = await v.json().catch(() => null);
  out.stuckVoid = { status: v.status(), code: vb?.error?.code ?? null };
} finally {
  const so = await mgr.post('/api/auth/sign-out', { headers: { 'idempotency-key': S.randomUUID() } });
  out.mgrSignOut = { status: so.status(), me: (await mgr.get('/api/me')).status() };
  await mgr.dispose();
}
const read = async id => { const s = await S.sale(id); return { receipt: s.sale.receiptNumber, status: s.sale.status, gross: s.sale.totals.grossSatang / 100, refunded: (s.sale.totals.refundedSatang ?? 0) / 100, refundStatus: s.refundStatus ?? null, attempts: (s.attempts ?? []).map(a => a.status) }; };
out.readBack = [];
for (const id of [...S.cashSales.map(s => s.id), S.cardSale2, S.cardSale]) out.readBack.push(await read(id));
S.receipt.cleanup.sales = out;
return out;

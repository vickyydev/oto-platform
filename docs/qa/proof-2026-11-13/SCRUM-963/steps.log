out.frames = frames.filter((f, i, a) => i === 0 || i === a.length - 1 || f.body !== a[i - 1].body || f.alert !== a[i - 1].alert);
out.backMs = frames.at(-1).ms;
out.langButtonsOnReview = await d.getByRole('button', { name: /^(Change language|เปลี่ยนภาษา)$/ }).count();
await S.shot(d, '93b-hunt-600-review-back-after-paused.png');

const d = await S.pairDisplay('main');
S.d = d;
const out = {};
out.facts = await d.evaluate(() => ({ url: location.pathname + location.search, touch: navigator.maxTouchPoints, w: innerWidth, h: innerHeight, theme: document.querySelector('[data-testid="separate-display"]')?.className.split(' ')[0] ?? null }));
await d.getByTestId('language-choice-en').tap();
await d.getByTestId('identify-safety').waitFor();
await d.waitForTimeout(800);
S.firstGeo = () => d.evaluate(() => {
  const r1 = v => Math.round(v * 10) / 10;
  const R = r => [r1(r.left), r1(r.top), r1(r.right), r1(r.bottom)];
  const numBox = [...document.querySelectorAll('div')].find(x => /h-16 flex-1 rounded-2xl/.test(x.className) && x.getBoundingClientRect().width > 0);
  const row = numBox?.parentElement;
  const lang = [...document.querySelectorAll('button')].find(b => /^(Change language|เปลี่ยนภาษา|更改语言|Сменить язык|Changer de langue)$/.test(b.getAttribute('aria-label') || '') && b.getBoundingClientRect().width > 0);
  let sc = numBox?.parentElement; while (sc && getComputedStyle(sc).overflowY !== 'auto') sc = sc.parentElement;
  if (!numBox || !lang || !sc) return { numBox: !!numBox, lang: !!lang, scroller: !!sc };
  const inter = (a, b) => { const l = Math.max(a.left, b.left), t = Math.max(a.top, b.top), r = Math.min(a.right, b.right), bt = Math.min(a.bottom, b.bottom); return r > l && bt > t ? { l, t, r, b: bt, area: (r - l) * (bt - t) } : null; };
  const read = () => { const rr = row.getBoundingClientRect(), nb = numBox.getBoundingClientRect(), lr = lang.getBoundingClientRect(), sr = sc.getBoundingClientRect();
    const vis = inter(rr, sr); const raw = inter(rr, lr); const seen = vis ? inter({ left: vis.l, top: vis.t, right: vis.r, bottom: vis.b }, lr) : null;
    return { scrollTop: r1(sc.scrollTop), numberRow: R(rr), numberBox: R(nb), language: R(lr), scroller: R(sr), rawOverlapPx2: raw ? r1(raw.area) : 0, seenOverlapPx2: seen ? r1(seen.area) : 0, topmostAtLangIsLang: (() => { const at = document.elementFromPoint(lr.left + lr.width / 2, lr.top + lr.height / 2); return !!at && (at === lang || lang.contains(at)); })() }; };
  const max = sc.scrollHeight - sc.clientHeight;
  const start = sc.scrollTop;
  const samples = []; let worstSeen = 0, worstRaw = 0;
  for (let st = 0; st <= max + 8; st += 8) { sc.scrollTop = Math.min(st, max); const x = read(); samples.push(x); worstSeen = Math.max(worstSeen, x.seenOverlapPx2); worstRaw = Math.max(worstRaw, x.rawOverlapPx2); }
  sc.scrollTop = 0; const top = read(); sc.scrollTop = max; const bottom = read(); sc.scrollTop = start;
  return { viewport: `${innerWidth}x${innerHeight}`, maxScroll: max, positionsRead: samples.length, worstSeenOverlapPx2: worstSeen, worstRawOverlapPx2: worstRaw, top, bottom, scrollerClass: String(sc.className).slice(0, 140) };
});
const setScroll = (where) => d.evaluate((where) => { const numBox = [...document.querySelectorAll('div')].find(x => /h-16 flex-1 rounded-2xl/.test(x.className) && x.getBoundingClientRect().width > 0); let sc = numBox?.parentElement; while (sc && getComputedStyle(sc).overflowY !== 'auto') sc = sc.parentElement; if (sc) sc.scrollTop = where === 'top' ? 0 : sc.scrollHeight; }, where);
for (const [w, h, tag] of [[600, 1024, '600x1024'], [1024, 600, '1024x600']]) {

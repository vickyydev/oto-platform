  await pic(`${S.pfx}-${S.dev}-today-${tag}.png`);
  // the page scrolled to its end, for what is below the fold
  await page.evaluate(() => { const els = [...document.querySelectorAll('*')].filter(e => { const cs = getComputedStyle(e); return /(auto|scroll)/.test(cs.overflowY) && e.scrollHeight > e.clientHeight + 40; }); for (const e of els) e.scrollTop = e.scrollHeight; window.scrollTo(0, document.body.scrollHeight); });
  await page.waitForTimeout(800);
  await pic(`${S.pfx}-${S.dev}-today-${tag}-scrolled.png`);
  await page.evaluate(() => { const els = [...document.querySelectorAll('*')].filter(e => { const cs = getComputedStyle(e); return /(auto|scroll)/.test(cs.overflowY); }); for (const e of els) e.scrollTop = 0; window.scrollTo(0, 0); });
}
S.receipt.reads[`p9-today-${S.dev}`] = r; S.save();
return r;

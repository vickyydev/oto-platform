=== 2026-11-13T14:26:50.442Z Clean only the exact old-source simulator sales before final-source proof
S.phase='Clean only the exact old-source simulator sales before final-source proof';
const manager=await S.pw.request.newContext({baseURL:S.pos});S.assert.equal((await manager.post('/api/auth/sign-in',{data:{phone:S.need('STAGING_MANAGER_PHONE'),password:S.need('STAGING_MANAGER_PASSWORD')}})).status(),200);const rows=[];
try{for(const st of S.stations??[]){S.assert.ok(/^ZZ TEST SCRUM-982 /.test(st.name));const sales=await S.stationSales(st);for(const row of sales){S.assert.ok(S.knownSales.has(row.id)&&S.receipt.created.some(x=>x.kind==='sale'&&x.id===row.id&&x.stationId===st.id),'exact own sale ledger');let detail=await S.sale(row.id);S.assert.equal(detail.sale.stationId,st.id);if(detail.sale.status==='finalised'){S.assert.ok(String(detail.sale.receiptNumber).startsWith(st.codePrefix+'-'));if(detail.refundStatus!=='refunded'){const r=await manager.post(`/api/sales/${row.id}/refunds`,{headers:{'idempotency-key':S.randomUUID()},data:{mode:'whole',reason:'ZZ TEST SCRUM-982 old-source simulator proof cleanup'}});S.assert.equal(r.status(),200);}detail=await S.sale(row.id);S.assert.equal(detail.refundStatus,'refunded');rows.push({id:row.id,stationId:st.id,status:detail.sale.status,refundStatus:detail.refundStatus,refundedSatang:detail.refunds.reduce((sum,r)=>sum+r.amountSatang,0)});}else if(detail.sale.status==='tendering'){S.assert.equal(detail.attempts.length,0,'no attempt was started on the card sale');S.assert.equal((await S.call('POST',`/sales/${row.id}/void`,{reason:'ZZ TEST SCRUM-982 unpaid old-source card setup cleanup'})).status,200);detail=await S.sale(row.id);S.assert.equal(detail.sale.status,'voided');rows.push({id:row.id,stationId:st.id,status:detail.sale.status});}else throw Error('Unexpected own sale state during exact cleanup');}}}finally{const signOut=await manager.post('/api/auth/sign-out');const me=await manager.get('/api/me');S.receipt.cleanup.oldSourceManager={signOut:signOut.status(),meAfter:me.status()};S.assert.equal(me.status(),401);await manager.dispose();}
S.receipt.cleanup.oldSourceSales=rows;S.save();return {rows,refundedTotalSatang:rows.reduce((sum,r)=>sum+(r.refundedSatang??0),0),managerSession:S.receipt.cleanup.oldSourceManager};

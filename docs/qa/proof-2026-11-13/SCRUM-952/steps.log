S.phase = 'clean up: members, the three ZZ stations retired, the ZZ devices archived, read back';
const out = { members: [], stations: [], devices: [] };
for (const [key, phone] of Object.entries(S.receipt.numbers)) {
  const m = (await S.call('GET', `/members/lookup?phone=${encodeURIComponent(phone)}`)).body?.member ?? null;
  if (m) {
    S.assert.ok(`${m.nickname ?? ''} ${m.name ?? ''}`.includes('ZZ TEST'), 'only own named test members');
    const d = await S.call('DELETE', `/members/${m.id}`);
    out.members.push({ key, archived: d.status });
  } else out.members.push({ key, member: 'none' });
}
const all = (await S.call('GET', `/branches/${S.branchId}/stations?includeArchived=true`)).body.stations;
for (const st of [S.station1 ?? S.station, S.station2, S.station3]) {
  const row = all.find(s => s.id === st.id);
  S.assert.ok(row.name.startsWith('ZZ TEST 952'), 'own station');
  const cleared = await S.call('PATCH', `/stations/${st.id}`, { devices: [] });
  const del = await S.call('DELETE', `/stations/${st.id}`);
  out.stations.push({ name: row.name, kind: row.kind, devicesCleared: cleared.status, clearCode: cleared.body?.error?.code ?? null, retired: del.status, retireCode: del.body?.error?.code ?? null, retireMessage: del.status >= 400 ? del.body?.error?.message ?? null : null });
}
const after = (await S.call('GET', `/branches/${S.branchId}/stations?includeArchived=true`)).body.stations;
out.stationsReadBack = [S.station1 ?? S.station, S.station2, S.station3].map(st => { const r = after.find(s => s.id === st.id); return { name: r.name, archived: Boolean(r.archived), devices: r.devices.length }; });
for (const [key, d] of Object.entries(S.dev)) {
  const now = (await S.devicesOnBox()).find(x => x.id === d.id);
  S.assert.ok(now.label.startsWith('ZZ TEST 952 '), 'own device');
  const del = now.archived ? { status: 'already' } : await S.call('DELETE', `/devices/${d.id}`);
  out.devices.push({ key, label: now.label, archive: del.status, stillAssignedTo: (del.body?.stillAssignedTo ?? []).length });
}
out.devicesReadBack = (await S.devicesOnBox()).filter(x => Object.values(S.dev).some(d => d.id === x.id)).map(x => ({ label: x.label, archived: Boolean(x.archived) }));
out.zzLiveOnBox = (await S.devicesOnBox()).filter(x => !x.archived && /^ZZ TEST 952/.test(x.label)).map(x => x.label);
S.receipt.cleanup.records = out;
return out;

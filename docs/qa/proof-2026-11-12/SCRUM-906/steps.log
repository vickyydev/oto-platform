for (const b of await phone.getByRole('button').all()) { const l = S.flat(await b.innerText().catch(() => '')); if (/Settlement open|Take balance|Fully paid|Resume/.test(l) && await b.isVisible()) pbtn.push({ l, enabled: await b.isEnabled() }); }
r.phone.buttons = pbtn;
await phone.mouse.wheel(0, -3000); await phone.waitForTimeout(400);

S.phase = 'clean up: the staging manager, signed in at the own ZZ TEST till, refunds every own cash sale whole';
const mgr = await S.signIn('manager', 'STAGING_MANAGER_PHONE', 'STAGING_MANAGER_PASSWORD', { width: 1440, height: 900 });
const out = [];
for (const st of [S.station, S.phoneStation]) {
  for (const s of await S.stationSales(st)) {
    S.assert.equal(s.stationId, st.id);
    S.assert.ok(S.knownSales.has(s.id), 'own sale only');
    if (s.status !== 'finalised') { out.push({ id: s.id, receipt: s.receiptNumber, status: s.status, skipped: true }); continue; }
    const res = await mgr.request.fetch(`/api/sales/${s.id}/refunds`, { method: 'POST', headers: { 'content-type': 'application/json', 'idempotency-key': S.randomUUID() }, data: { mode: 'whole', reason: 'ZZ TEST SCRUM-893 proof clean-up' } });
    const b = await res.json().catch(() => null);
    const after = await S.sale(s.id);
    out.push({ id: s.id, receipt: s.receiptNumber, gross: s.totals?.grossSatang, status: res.status(), errorCode: b?.error?.code ?? null, refund: b?.refund?.amountSatang ?? null, refundStatus: after.refundStatus ?? null, saleStatus: after.sale?.status, refundable: after.refundableSatang ?? null });
  }
}
S.receipt.cleanup.refunds = out; S.save();
return out;

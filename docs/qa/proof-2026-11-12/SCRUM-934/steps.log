S.phase = 'clean up: bookings, sales, members, code';
const out = { registrations: [], members: [] };
for (const item of S.receipt.created.filter(i => i.kind === 'registration')) {
  let reg = await S.registration(item.id);
  S.assert.equal(reg.guardianName, item.guardian, 'only this run\'s own booking');
  S.assert.ok(S.isZz(reg.guardianName) && reg.children.every(c => S.isZz(c.childName)));
  const released = reg.children.some(c => c.status === 'in_park') ? await S.releaseOwn(item.id, item.guardian) : [];
  reg = await S.registration(item.id);
  let cancelled = null;
  if (reg.children.some(c => c.status === 'registered')) {
    const r = await S.call('POST', `/checkin/registrations/${item.id}/cancel`, { reason: 'ZZ TEST SCRUM-934 proof clean-up' });
    cancelled = { status: r.status, code: r.body?.error?.code ?? null };
    reg = await S.registration(item.id);
  }
  out.registrations.push({ guardian: item.guardian, released, cancelled, children: reg.children.map(c => c.status) });
}
let sales = await S.stationSales();
for (const s of sales.filter(x => ['tendering', 'open'].includes(x.status))) {
  const r = await S.call('POST', `/sales/${s.id}/void`, { reason: 'ZZ TEST SCRUM-934 proof clean-up' });
  out.voidedAtCleanup = (out.voidedAtCleanup ?? []).concat(r.status);
}
sales = await S.stationSales();
out.sales = sales.map(s => ({ receipt: s.receiptNumber, status: s.status, gross: s.totals.grossSatang / 100, refunded: (s.totals.refundedSatang ?? 0) / 100 }));
out.printJobs = {};
for (const s of sales.filter(x => x.status === 'finalised')) out.printJobs[s.receiptNumber] = (await S.sale(s.id)).printJobs.map(j => `${j.kind} ${j.status}`);
for (const [key, phone] of Object.entries(S.receipt.numbers)) {
  const m = (await S.call('GET', `/members/lookup?phone=${encodeURIComponent(phone)}`)).body?.member ?? null;
  if (m) {
    const named = `${m.nickname ?? ''} ${m.name ?? ''}`;
    if (named.includes('ZZ TEST')) {
      const d = await S.call('DELETE', `/members/${m.id}`);
      const after = (await S.call('GET', `/members/lookup?phone=${encodeURIComponent(phone)}`)).body?.member ?? null;
      out.members.push({ key, archived: d.status, lookupAfter: after ? 'still found' : 'gone' });
    } else out.members.push({ key, member: 'found, not ZZ TEST named: left alone', nameEmpty: !named.trim() });
  } else out.members.push({ key, member: null });
}
// the code
const row = (await S.call('GET', '/menu/discounts?includeArchived=true')).body.discounts.find(d => d.id === S.codeId);
S.assert.ok(row && row.code === S.CODE && /^ZZ TEST SCRUM-934/.test(row.label), 'only this run\'s own code');
const del = row.archivedAt ? null : (await S.call('DELETE', `/menu/discounts/${S.codeId}`)).status;
const after = (await S.call('GET', '/menu/discounts?includeArchived=true')).body.discounts.find(d => d.id === S.codeId);
const live = (await S.call('GET', '/menu/discounts')).body.discounts.some(d => d.id === S.codeId);
out.code = { code: S.CODE, archive: del, archived: Boolean(after.archivedAt), active: after.active, usedCount: after.usedCount, inLiveList: live };
Object.assign(S.receipt.cleanup, { registrations: out.registrations, sales: out.sales, printJobs: out.printJobs, members: out.members, code: out.code, voidedAtCleanup: out.voidedAtCleanup ?? [] });
S.save();
return out;

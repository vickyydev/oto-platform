  const name = `12${tag === 'upcoming' ? 'a' : 'b'}-1440x900-board-family-g-under-${tag}.png`;
  await S.shot(till, name);
  out[tag] = { tabs, pic: name, buttons: card?.buttons.filter(b => /^(Check|Cancel)/.test(b.text)).map(b => ({ text: b.text, enabled: b.enabled, spill: b.textSpillsBy })), text: card?.text.replace(/^.*?Couldn't reach /, '').slice(0, 300), lines };
}
// the search cleared: is the family listed among the others under Upcoming (no filter)

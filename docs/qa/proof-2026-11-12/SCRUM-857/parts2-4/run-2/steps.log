  ]);
  const page = await S.browser.newPage({ viewport: { width: 2400, height: 1100 } });
  const img = buf => `data:image/png;base64,${buf.toString('base64')}`;
  await page.setContent(`<html><body style="margin:0;background:#111;color:#eee;font-family:Segoe UI,Arial"><div style="padding:6px 10px;font-size:18px">${(extra.caption ?? '').replace(/[<>&]/g, '')} — taken ${new Date().toISOString()}</div><div style="display:flex;gap:8px;align-items:flex-start;padding:0 8px 8px"><figure style="margin:0;flex:1.62"><figcaption style="font-size:15px;padding:2px 0">Till (desk, 1680×1050)</figcaption><img style="width:100%;border:1px solid #444" src="${img(a)}"></figure><figure style="margin:0;flex:1"><figcaption style="font-size:15px;padding:2px 0">Customer display (own context)</figcaption><img style="width:100%;border:1px solid #444" src="${img(b)}"></figure></div></body></html>`);
  await page.screenshot({ path: S.resolve(S.out, name), fullPage: true });
  await page.close(); S.shots.push(name); return name;
};

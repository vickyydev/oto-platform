=== 2026-11-13T01:58:02.172Z 3: the same sale paid by cash after the refusal; no 409; one receipt
S.phase = '3: the same sale paid by cash after the refusal; no 409; one receipt';
const { expect } = S;
const r = {};
const till = S.till;
await S.unlock('rec');
const before = await S.printoutsFull(S.dev.receipt.id);
const seenKeys = before.printouts.map(S.keyOf);
const calls = [];
const onResp = rr => { const u = new URL(rr.url()); if (/\/api\//.test(u.pathname) && rr.request().method() !== 'GET') calls.push({ method: rr.request().method(), path: u.pathname.replace(S.ID, ':id'), status: rr.status() }); };
till.on('response', onResp);
const t0 = Date.now();
await till.getByRole('heading', { name: 'Cash', exact: true }).first().click();
const confirm = till.getByRole('button', { name: 'Confirm Payment Received', exact: true });
await expect(confirm).toBeEnabled({ timeout: 20000 });
r.afterCash = S.flat(await S.paymentStep(till).innerText()).slice(0, 500);
await S.shot(till, '03a-till-cash-chosen-after-refusal.png');
await confirm.click();
r.paymentSuccessful = await till.getByText('Payment Successful', { exact: true }).waitFor({ timeout: 45000 }).then(() => true).catch(() => false);
r.secondsToPaid = Math.round((Date.now() - t0) / 100) / 10;
await till.waitForTimeout(2500);
await S.shot(till, '03b-till-cash-payment-successful.png', [till.locator('span.font-mono')]);
await expect.poll(async () => { const j = (await S.sale(S.p2.sale)).printJobs ?? []; return j.length > 0 && j.every(x => ['printed', 'failed', 'skipped'].includes(x.status)); }, { timeout: 120000, intervals: [3000] }).toBe(true).catch(() => {});
await S.sleep(6000);
till.off('response', onResp);
r.calls = calls;
r.any409 = calls.some(c => c.status === 409);
const s = await S.sale(S.p2.sale);
r.sale = { receipt: s.sale.receiptNumber, status: s.sale.status, gross: s.sale.totals.grossSatang / 100, attempts: (s.attempts ?? []).map(a => ({ id: a.id, method: a.method, status: a.status, amount: a.amountSatang / 100 })) };
r.printJobs = (s.printJobs ?? []).map(j => ({ kind: j.kind, role: j.role, status: j.status, error: j.errorCode ?? null, onZzPrinter: [S.dev.receipt.id, S.dev.band.id].includes(j.deviceId) }));
r.receiptJobs = r.printJobs.filter(j => j.kind === 'receipt').length;
const after = await S.printoutsFull(S.dev.receipt.id);
r.newPrintouts = after.printouts.filter(p => !seenKeys.includes(S.keyOf(p))).map(p => ({ seq: p.seq, at: p.at, heightDots: p.heightDots, truncated: p.truncated }));
S.receipt.created.push({ kind: 'sale-cash', id: S.p2.sale, receipt: s.sale.receiptNumber }); S.save();
S.receipt.reads.p3 = r;
const text = [
  `ZZ TEST 972 sale ${S.p2.sale} — the card the box refused (attempt ${S.p2.attempt}, declined), then Cash on the same sale`,
  '',
  `the till's own writes from the Cash press: ${JSON.stringify(r.calls)}`,
  `any 409: ${r.any409}`,
  '',
  `GET /api/sales/<id>: status ${r.sale.status}  receipt ${r.sale.receipt}  gross ฿${r.sale.gross}`,
  `  attempts: ${JSON.stringify(r.sale.attempts, null, 1)}`,
  `  printJobs: ${JSON.stringify(r.printJobs, null, 1)}`,
  '',
  `GET /api/devices/<ZZ TEST 972 receipt printer>/printouts -> new printouts since the press: ${JSON.stringify(r.newPrintouts)}`,
].join('\n');
await S.txtShot(text, '03c-api-cash-sale-one-receipt.png', 'Point 3: the same sale paid by cash, no refusal, one receipt');
return r;

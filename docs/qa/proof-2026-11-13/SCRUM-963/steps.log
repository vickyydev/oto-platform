S.phase = 'setup: numbers, own desk till, sign in the desk till (reception, 1680x1050), the lane in the bundle';
const r = await S.setup();
const till = await S.signIn('till', 'STAGING_RECEPTION_PHONE', 'STAGING_RECEPTION_PASSWORD', { width: 1680, height: 1050 });
S.till = till;
const bundle = await till.evaluate(async () => {
  const urls = [...new Set(performance.getEntriesByType('resource').map(e => e.name).filter(n => /\.(js|css)(\?|$)/.test(n)))];
  const found = { files: urls.length };
  const needles = { categoryRow: 'category-row', earlier: 'Earlier categories', more: 'More categories', cdMenu: '--cd-menu', badgeDone: '--cd-badge-done', gateScroll: 'gate-scroll', saleWord: 'this screen starts a new ', maxH520: 'max-height:519.98px' };
  for (const k of Object.keys(needles)) found[k] = 0;
  for (const url of urls) { const t = await (await fetch(url, { cache: 'no-store' })).text(); for (const [k, v] of Object.entries(needles)) found[k] += t.split(v).length - 1; }
  return found;
});
S.receipt.reads.bundle = bundle;
await S.landing(till).waitFor();
await S.shot(till, '00-desk-till-signed-in-landing.png');
clearInterval(S.aliveTimer);
S.aliveTimer = setInterval(() => { for (const l of Object.keys(S.pages)) S.alive(l); }, 40000);
S.fam = {};
return { r, bundle };

{
  "name": "@oto/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./seed": "./src/seed/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "seed": "tsx src/seed/index.ts",
    "seed:demo-day": "tsx src/seed/demo-day.ts",
    "platform:sync": "tsx src/seed/index.ts --platform-only",
    "snapshot": "tsx scripts/snapshot.ts",
    "verify-schema": "tsx scripts/verify-schema.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@oto/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "16.14.0-beta.17",
    "tsx": "catalog:",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}

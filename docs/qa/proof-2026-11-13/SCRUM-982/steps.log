S.phase='Independent cleanup readback and labelled final proof card';const money=[];for(const st of S.finalStations){for(const row of await S.stationSales(st)){const d=await S.sale(row.id);S.assert.ok(['refunded','voided'].includes(d.sale.status));if(d.sale.status==='refunded'){S.assert.equal(d.refundStatus,'refunded');S.assert.equal(d.refunds.reduce((s,r)=>s+r.amountSatang,0),d.sale.totals.grossSatang);}money.push({id:row.id,status:d.sale.status,refundStatus:d.refundStatus??null,refunds:(d.refunds??[]).map(x=>({id:x.id,status:x.status,amountSatang:x.amountSatang})),allocations:(d.refundAllocations??[]).map(x=>({status:x.status,amountSatang:x.amountSatang}))});}}const credentials=(await S.call('GET',`/branches/${S.branchId}/credentials?includeRevoked=true`)).body.credentials;const own=S.receipt.created.filter(x=>x.kind==='display');const display=own.map(x=>{const row=credentials.find(y=>y.id===x.id);return {id:x.id,found:!!row,revokedAt:row?.revokedAt??null};});const p=await S.browser.newPage({viewport:{width:1280,height:1050}});await p.setContent(`<html><head><style>body{font:22px Arial;background:#f1f5f9;color:#0f172a;padding:45px}article{background:white;border-radius:16px;padding:32px}h1{font-size:34px}li{margin:17px 0}code{font-size:16px}small{font-size:17px;color:#475569}</style></head><body><article><h1>SCRUM-982 staging proof and cleanup</h1><p>14 November 2026, ${S.bkk(new Date())}</p><p>Reviewed source: <code>${S.sha}</code></p><ul><li>Eight native cases passed across desktop ticket, F&B, Shop and phone ticket/F&B.</li><li>Same recorded sale and original seller survived a different staff sign-in.</li><li>Paid QR stayed PromptPay; cancelled QR allowed one Cash payment.</li><li>Late QR paid during lock recovered without a second tender.</li><li>Edited cart: 1,040 baht charge voided; corrected 1,390 baht sale paid.</li><li>Seven own simulated paid sales refunded: 4,925 baht. Two unpaid rows voided.</li><li>Three final stations and own simulated terminal archived. Display credential revoked.</li><li>Both synthetic staff inactive, zero live sessions; sign-in refused with 401.</li><li>All three native browser sessions signed out and read 401.</li></ul><small>Bounded staging proof. QR and terminal providers were simulated. No physical terminal, bank, printer or real-message acceptance. Owner-held SCRUM-981 choices remain open. Source CI is recorded separately.</small></article></body></html>`);await p.screenshot({path:S.resolve(S.out,'final/09-proof-cleanup-card.png')});await p.close();S.receipt.cleanup.independent={at:new Date().toISOString(),money,display};S.save();return {rows:money.length,statuses:money.map(x=>({id:x.id,status:x.status,refunds:x.refunds,allocations:x.allocations})),displayKinds:S.receipt.created.filter(x=>/display|credential/.test(x.kind)).map(x=>({kind:x.kind,id:x.id}))};

=== 2026-11-12T15:02:10.912Z 7d: SCRUM-943 the display offline a few seconds: the reconnecting line over the form, no Retry, no jump; a tick pressed then registers; the till catches up
const { expect } = S;
S.phase = '7d: SCRUM-943 the display offline a few seconds: the reconnecting line over the form, no Retry, no jump; a tick pressed then registers; the till catches up';
const till = S.till, d = S.displays.main.page, ctx = S.displays.main.ctx;
await S.keepAlive();
const c = d.getByTestId('display-consent');
const m = till.getByTestId('consent-mirror');
const consentTick = c.getByTestId('public-consent-ack');
await consentTick.scrollIntoViewIfNeeded();
await d.waitForTimeout(400);
const rect = () => consentTick.evaluate(e => { const r = e.getBoundingClientRect(); return [Math.round(r.top), Math.round(r.left)]; });
const formTop = () => c.evaluate(e => Math.round(e.getBoundingClientRect().top));
const staffConsent = async () => S.flat(await till.getByText(/^Supervision and photo consent/).first().innerText().catch(() => ''));
const out = { before: { tick: await rect(), formTop: await formTop(), staff: await staffConsent() } };
await ctx.setOffline(true);
const offAt = Date.now();
// wait for the display to notice
let seen = null;
for (let i = 0; i < 40 && !seen; i++) { await d.waitForTimeout(500); if (await d.getByTestId('display-form-reconnecting').count()) seen = Date.now() - offAt; }
out.reconnectingSeenMs = seen;
out.offline = { line: (await d.getByTestId('display-form-reconnecting').count()) ? S.flat(await d.getByTestId('display-form-reconnecting').innerText()) : null,
  retryButtons: await d.getByRole('button', { name: /^(Retry|ลองอีกครั้ง)$/ }).count(), alert: (await d.getByRole('alert').count()) ? S.flat(await d.getByRole('alert').first().innerText()) : null,
  tick: await rect(), formTop: await formTop() };
await S.shot(d, '07d1-display-offline-reconnecting-line-over-form.png');
// the family ticks consent while offline
await consentTick.tap();

S.phase = '2: a ZZ TEST simulated card terminal on the ZZ till; the till offers Card';
const { expect } = S;
const r = {};
const onBox = await S.devicesOnBox(S.box.id);
const label = 'ZZ TEST 952 card terminal';
let term = onBox.find(x => !x.archived && x.label === label);
if (!term) {
  const made = await S.call('POST', `/boxes/${S.box.id}/devices`, { id: S.randomUUID(), kind: 'terminal', label, transport: 'simulated', protocol: 'ghl_linkpos', model: 'NEXGO N5' });
  r.terminalCreate = made.status;
  S.assert.equal(made.status, 200);
  term = made.body.device;
  S.receipt.created.push({ kind: 'device', key: 'card', id: term.id, label }); S.save();
}
S.dev.card = { id: term.id, label, kind: 'terminal' };
const row = await S.stationRow();
const devices = row.devices.filter(d => d.role !== 'card_terminal').map(d => ({ role: d.role, deviceId: d.deviceId })).concat([{ role: 'card_terminal', deviceId: term.id }]);
const p = await S.call('PATCH', `/stations/${S.station.id}`, { devices, paymentRouting: { card: 'card_terminal', qr: 'none' } });
r.stationPatch = { status: p.status, code: p.body?.error?.code ?? null, roles: S.rolesOf(p.body?.station), paymentRouting: p.body?.station?.paymentRouting ?? null, readiness: p.body?.station?.sellingReadiness ?? null };
// wait for the box to know the terminal
await S.sleep(15000);
const till = S.till;
await S.unlock('rec');
await S.walkIn(till, S.free[2]);
S.receipt.numbers.card = S.free[2];
await S.ticket(till, 1, 1);
const sale = await S.saleWritten('card-sale');
S.cardSale = sale.id;
await expect(S.paymentStep(till)).toBeVisible({ timeout: 30000 });
r.methods = (await S.paymentStep(till).getByRole('heading', { level: 3 }).allInnerTexts()).map(S.flat);
await till.getByRole('heading', { name: 'Card', exact: true }).first().click();
await till.waitForTimeout(1500);
r.afterCard = S.flat(await S.paymentStep(till).innerText()).slice(0, 900);
r.buttons = (await S.paymentStep(till).getByRole('button').allInnerTexts()).map(S.flat).filter(Boolean);
await S.shot(till, '02b-till-card-selected-simulated-terminal.png', [till.locator('span.font-mono')]);
S.receipt.reads.p2cardSetup = r;
return r;

=== 2026-11-13T00:01:34.804Z harness: a pixel contrast reader (the badge as drawn: its most common colour as ground, its farthest colour as ink)
S.phase = 'harness: a pixel contrast reader (the badge as drawn: its most common colour as ground, its farthest colour as ink)';
S.pixelInk = async (page, loc) => {
  const bb = await loc.boundingBox();
  const buf = await page.screenshot({ clip: { x: bb.x, y: bb.y, width: bb.width, height: bb.height }, animations: 'disabled' });
  const sheet = await S.browser.newPage({ viewport: { width: 400, height: 200 } });
  try {
    return await sheet.evaluate(async (b64) => {
      const img = new Image(); img.src = 'data:image/png;base64,' + b64; await img.decode();
      const cv = document.createElement('canvas'); cv.width = img.width; cv.height = img.height; const cx = cv.getContext('2d'); cx.drawImage(img, 0, 0);
      const d = cx.getImageData(0, 0, img.width, img.height).data;
      const count = new Map();
      for (let i = 0; i < d.length; i += 4) { const k = (d[i] << 16) | (d[i + 1] << 8) | d[i + 2]; count.set(k, (count.get(k) ?? 0) + 1); }
      const bgK = [...count.entries()].sort((a, b) => b[1] - a[1])[0][0];
      const rgb = k => [(k >> 16) & 255, (k >> 8) & 255, k & 255];
      const lum = c => { const f = v => { v /= 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); }; return 0.2126 * f(c[0]) + 0.7152 * f(c[1]) + 0.0722 * f(c[2]); };
      const bg = rgb(bgK); const Lb = lum(bg);
      // the ink: the colour (seen at least 6 times, so not a stray edge pixel) whose contrast with the ground is greatest
      let best = null, bestR = 0;
      for (const [k, n] of count) { if (n < 6 || k === bgK) continue; const c = rgb(k); const L = lum(c); const r = (Math.max(L, Lb) + 0.05) / (Math.min(L, Lb) + 0.05); if (r > bestR) { bestR = r; best = c; } }
      const hex = c => '#' + c.map(v => v.toString(16).padStart(2, '0')).join('');
      return { ground: hex(bg), ink: best ? hex(best) : null, ratio: Math.round(bestR * 100) / 100, size: [img.width, img.height] };
    }, buf.toString('base64'));
  } finally { await sheet.close(); }
};
return 'ok';

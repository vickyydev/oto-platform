=== 2026-11-13T02:01:55.517Z scrub: the manager name the History detail carried; re-scrub the log and the receipt
S.phase = 'scrub: the manager name the History detail carried; re-scrub the log and the receipt';
const mgr = await S.pw.request.newContext({ baseURL: S.pos });
const r = {};
try {
  r.signIn = (await mgr.post('/api/auth/sign-in', { data: { phone: S.need('STAGING_MANAGER_PHONE'), password: S.need('STAGING_MANAGER_PASSWORD') } })).status();
  const me = await (await mgr.get('/api/me')).json().catch(() => null);
  const before = S.names.size;
  S.walkNames(me);
  r.namesAdded = S.names.size - before;
} finally {
  r.signOut = (await mgr.post('/api/auth/sign-out', { headers: { 'idempotency-key': S.randomUUID() } })).status();
  r.me = (await mgr.get('/api/me')).status();
  await mgr.dispose();
}
for (const n of ['VAT', 'Service', 'Charge']) S.names.delete(n);
const logPath = S.resolve(S.out, 'steps.log');
const raw = S.readFileSync(logPath, 'utf8');
const clean = S.scrub(raw);
S.writeFileSync(logPath, clean);
r.logChanged = raw !== clean;
S.save();
const rc = S.readFileSync(S.resolve(S.out, 'receipt.json'), 'utf8');
r.receiptStillHasDetail = /by \[staff\]/.test(rc);
return r;

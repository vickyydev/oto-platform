{
  // The unit tests and their runner config (SCRUM-408). `tsconfig.json` covers
  // `src/` and leaves every `*.test.ts` out, and vitest strips types without
  // checking them — so without this a test could assert on a shape the till
  // no longer has and still pass. `pnpm typecheck` runs both.
  // The Playwright specs and their config are here too (SCRUM-286): they run
  // only against a live stack, so without this nothing type-checked them and
  // a renamed field could leave them broken until the next driven run.
  "extends": "./tsconfig.json",
  "include": ["test/**/*.ts", "vitest.config.ts", "e2e/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "tsBuildInfoFile": ".test.tsbuildinfo"
  }
}

{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "NODE_ENV"]
    },
    // `@oto/print`'s suite holds the "one path from a layout to dots" guard,
    // and that test READS .ts and .tsx files under apps/ and packages/ at
    // runtime — everything except vendored and generated directories, which
    // its own SKIP set names. Hashed on the print package's own files alone, a
    // second drawing path added in apps/pos was a cache hit: the guard
    // replayed a stored pass and never ran. So this one task is hashed on what
    // it actually reads. Keep these globs matching that walk; a directory the
    // walk reads but these globs miss is a guard that goes stale silently.
    "@oto/print#test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "NODE_ENV"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/**/*.ts",
        "$TURBO_ROOT$/apps/**/*.tsx",
        "$TURBO_ROOT$/packages/**/*.ts",
        "$TURBO_ROOT$/packages/**/*.tsx"
      ]
    },
    // The seam walker (SCRUM-293) reads every .ts and .tsx under the four
    // front ends' src/ at runtime and resolves each api call against this
    // package's openapi.json. Hashed on its own package alone, a broken call
    // added in apps/pos would replay a stored pass — the failure `@oto/print`
    // measured above. Keep these globs matching FRONT_ENDS in
    // packages/api-types/test/seams.ts; `packages/shared` is where the
    // station bridge base it reads comes from.
    "@oto/api-types#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/pos/src/**",
        "$TURBO_ROOT$/apps/console/src/**",
        "$TURBO_ROOT$/apps/launcher/src/**",
        "$TURBO_ROOT$/apps/booth/src/**",
        "$TURBO_ROOT$/packages/shared/src/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

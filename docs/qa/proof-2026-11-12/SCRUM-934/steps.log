  await till.getByRole('button', { name: 'Close', exact: true }).last().click();
  const frames = [];
  for (let i = 0; i < 8; i++) { await S.sleep(500); const t = S.flat(await till.locator('body').innerText()); frames.push({ ms: (i + 1) * 500, bill: t.match(/Party bill[^]*?Outstanding[^฿—]*(฿[0-9,.]+|—)/)?.[0]?.slice(0, 300) ?? null, take: t.match(/Take balance (฿[0-9,.]+|—)/)?.[0] ?? null, resume: t.match(/Resume settlement (฿[0-9,.]+|—)/)?.[0] ?? null }); }
  till.off('framenavigated', onNav);
  const btns = [];
  for (const b of await till.getByRole('button').all()) { const l = S.flat(await b.innerText()); if (/Take balance|Fully paid|Resume settlement|Cancel settlement|Settle party/.test(l) && await b.isVisible()) btns.push({ l, e: await b.isEnabled() }); }
  await S.shot(till, '03i-party-page-after-x-no-reload-15800.png');
  const party = (await S.call('GET', `/parties/${S.partyId}?branchId=${S.branchId}`)).body;
  const st = party?.event?.party?.settlement ?? null;
  S.receipt.reads.p3.part = { finalise: fr.status(), after, navigationsAfterX: navs, urlSame: till.url() === urlBefore, frames: frames.filter((f, i, a) => i === 0 || JSON.stringify(f) .slice(10) !== JSON.stringify(a[i - 1]).slice(10)), btns,
    api: st ? { state: st.state, paid: st.paidSatang / 100, outstanding: st.outstandingSatang / 100 } : null };
  S.save();
  return S.receipt.reads.p3.part;
} finally { S.inPlace = keep; }

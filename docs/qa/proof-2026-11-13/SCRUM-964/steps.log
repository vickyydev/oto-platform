S.addFnb = async (page, search, name) => {
  const nav = page.locator('nav').getByRole('button', { name: 'F&B', exact: true });
  if (await nav.count()) { await nav.click(); await page.waitForTimeout(2000); }
  else if (!/order-station/.test(page.url())) { await page.locator('nav').getByText('F&B', { exact: true }).click(); await page.waitForTimeout(2000); }
  const guest = page.getByRole('button', { name: /continue as guest/i });
  if (await guest.count()) { await guest.first().click(); await page.waitForTimeout(1200); }
  await page.getByPlaceholder(/Search/).first().fill(search); await page.waitForTimeout(1200);
  await page.getByText(new RegExp(name, 'i')).first().click();
  await page.waitForTimeout(1200);
  const sheetAdd = page.getByRole('dialog').getByRole('button', { name: /^Add/ });
  if (await sheetAdd.count()) { await sheetAdd.first().click(); await page.waitForTimeout(800); }
  return S.flat(await page.getByRole('button', { name: /^Charge ฿/ }).first().innerText().catch(() => ''));
};

# The OTO booth box: the agent, its printing and sync, and the booth page on
# http://127.0.0.1:8780/ for the television (SCRUM-223). Installed by
# scripts/pi/install.sh, which fills in @NODE@.
[Unit]
Description=OTO booth box (agent, printing, sync, booth page on 127.0.0.1:8780)
# Wanted, not required: a booth in a mall boots before the router has its
# line, and it must play (and print) from its own copy in the meantime.
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
# The mirror drive, when there is one (install.sh --mirror-uuid). Wanted and not
# required, and never RequiresMountsFor: the counter must sell without it, and
# Health says it is gone. A box with no such drive has no such unit, and is fine.
Wants=mnt-oto\x2dmirror.mount
After=mnt-oto\x2dmirror.mount
# Never let a crash loop hammer the card or the api: at most 10 starts a
# minute. These are [Unit] settings; systemd ignores them under [Service].
# A box that hits the limit is not left dead: the watchdog timer starts it
# again a minute later.
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=oto-box
Group=oto-box
EnvironmentFile=/etc/oto-box/config
ExecStart=@NODE@ --disable-warning=ExperimentalWarning /opt/oto-box/current/oto-box.mjs run
# 75 is the runner asking for a fresh process after a claim gave it a new identity.
Restart=always
RestartSec=3
TimeoutStopSec=15
# What the box may touch: its own home, and its mirror directory. The dash is not
# optional: without it a missing mirror directory fails this unit with 226/NAMESPACE
# and the counter cannot sell. The store lock is an abstract socket (store-lock.ts),
# so PrivateNetwork, or a RestrictAddressFamilies without AF_UNIX, would break it.
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/oto-box -/mnt/oto-mirror/box
PrivateTmp=yes
# The scanner reads input devices. The Digio terminal reads and writes USB CDC.
# The installer's udev rules grant the service user read access to the scanner
# and read/write access to the PAX terminal.
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=char-input r
DeviceAllow=char-ttyACM rw
CapabilityBoundingSet=~CAP_MKNOD CAP_SYS_RAWIO
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target

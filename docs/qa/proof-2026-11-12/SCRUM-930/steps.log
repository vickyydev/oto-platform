r.dropoffNewPrintouts = fresh.map(p => ({ seq: p.seq, at: p.at, kind: p.kind ?? p.jobKind ?? null }));
r.kidsNewPrintouts = (await S.printouts('kids_band')).filter(p => !seen.kids.includes(S.keyOf(p))).length;
const prev = await S.admin.get(`/api/devices/${S.dev.dropoff_band.id}/printouts/${fresh[0].seq}/preview.png`);
r.preview = prev.status();
if (prev.status() === 200) S.writeFileSync(S.resolve(S.out, '02d-dropoff-printer-test-page-preview.png'), await prev.body());

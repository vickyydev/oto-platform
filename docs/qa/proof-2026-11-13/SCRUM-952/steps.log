=== 2026-11-12T22:49:56.153Z 2: two ZZ TEST walk-in sales, 1 Hour Play 1 child + 1 adult, cash; one printout per receipt
S.phase = '2: two ZZ TEST walk-in sales, 1 Hour Play 1 child + 1 adult, cash; one printout per receipt';
const { expect } = S;
const r = { mgrClosed: await S.close('mgr') };
const till = await S.signIn('rec', 'STAGING_RECEPTION_PHONE', 'STAGING_RECEPTION_PASSWORD');
S.till = till;
S.cashSales = [];
for (const [i, number] of [S.free[0], S.free[1]].entries()) {
  const before = await S.printoutsFull(S.dev.receipt.id);
  const seenKeys = before.printouts.map(S.keyOf);
  const t0 = Date.now();
  S.receipt.numbers['cash' + (i + 1)] = number;
  await S.walkIn(till, number);
  await S.ticket(till, 1, 1);
  const sale = await S.saleWritten('cash-sale-' + (i + 1));
  await S.payCash(till);
  await till.waitForTimeout(3000);
  if (i === 0) await S.shot(till, '02a-till-cash-sale-1-paid.png', [till.locator('span.font-mono')]);
  await expect.poll(async () => { const j = (await S.sale(sale.id)).printJobs ?? []; return j.length > 0 && j.every(x => ['printed', 'failed', 'skipped'].includes(x.status)); }, { timeout: 120000, intervals: [3000] }).toBe(true).catch(() => {});
  await S.sleep(6000);
  const s = await S.sale(sale.id);
  const after = await S.printoutsFull(S.dev.receipt.id);
  const fresh = after.printouts.filter(p => !seenKeys.includes(S.keyOf(p)));
  const events = after.events.filter(e => Date.parse(e.at) >= t0 - 1000);
  const one = { receipt: s.sale.receiptNumber, status: s.sale.status, gross: s.sale.totals.grossSatang / 100, tenders: (s.payments ?? s.sale.payments ?? []).map(p => p.method ?? p.kind ?? null),
    printJobs: (s.printJobs ?? []).map(S.jobFacts),
    newPrintouts: fresh.map(p => ({ seq: p.seq, at: p.at, widthDots: p.widthDots, heightDots: p.heightDots, jobBytes: p.jobBytes, truncated: p.truncated })),
    events: events.map(e => ({ at: e.at, kind: e.kind, detail: e.detail })) };

S.phase = '960 (2)(3): family H: two children paid in cash, left as booked; one checked in on a band';
const { expect } = S;
const till = S.till;
await S.unlock('till');
await till.setViewportSize({ width: 1440, height: 900 });
S.fam = S.fam ?? {};
S.receipt.numbers.H = S.free[2];
S.GH = 'ZZ TEST 959 guardian H';
await S.walkIn(till, S.free[2]);
await S.ticket(till, 2, 0);
const reg = await S.fillDropOff(till, ['ZZ TEST Mali 959 H', 'ZZ TEST Nok 959 H'], S.GH, null, [6, 7]);
const sale = await S.saleWritten('dropoff-sale-H');
await expect(S.paymentStep(till)).toBeVisible({ timeout: 30000 });
await till.waitForTimeout(1500);
const due = await S.amountDue(till);
await S.payCash(till);
const leave = till.getByRole('button', { name: 'Leave as booked', exact: true });
await leave.waitFor({ timeout: 20000 });
await leave.click();
await till.waitForTimeout(2500);
S.fam.H = { reg: reg.id, sale: sale.id, stays: reg.children.map(c => ({ id: c.id, name: c.childName })) };
// check in the first child on a band (the till's own check-in-booked route)
const one = S.fam.H.stays[0];
S.assert.ok(S.isZz(one.name));
const res = await till.evaluate(async (id) => {
  const r = await fetch('/api/checkin/check-in-booked', { method: 'POST', credentials: 'include', headers: { 'content-type': 'application/json', 'idempotency-key': crypto.randomUUID() }, body: JSON.stringify({ entries: [{ checkinId: id, nannyId: null }], consentAcknowledged: true }) });
  const b = await r.json().catch(() => null);
  return { status: r.status, code: b?.error?.code ?? null, children: (b?.children ?? []).map(c => ({ name: c.childName, status: c.status })), printJobs: (b?.printJobs ?? []).map(j => `${j.kind} ${j.status}`) };
}, one.id);
S.receipt.created.push({ kind: 'checked-in', registration: reg.id, child: one.name, status: res.status }); S.save();
const s = await S.sale(sale.id);
const fam = await S.familyOnBoard(reg.id);
const regRead = await S.registration(reg.id);
return { due, sale: { status: s.sale.status, receipt: s.sale.receiptNumber, gross: s.sale.totals.grossSatang / 100 }, checkIn: res, board: S.stayFacts(fam),
  scheduled: regRead.children.map(c => ({ name: c.childName, status: c.status, scheduledFor: c.scheduledFor ?? null, bandCode: c.bandCode ? 'present' : null })), now: new Date().toISOString() };

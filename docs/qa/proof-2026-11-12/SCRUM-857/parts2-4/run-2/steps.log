const { expect } = S;
S.phase = 'run 2 clean up: release W, display revoked, prints, member archived, till retired, sign out, read back';
clearInterval(S.alive);
const res = {};
await S.till.goto('/'); await S.till.waitForTimeout(1000);
res.display = await S.dropDisplay('w');
res.release = await S.releaseOwn(S.fam.W.reg);
res.reg = (await S.registration(S.fam.W.reg)).children.map(c => c.childName + ':' + c.status);
const sales = await S.stationSales();
res.sales = [];
for (const s of sales) {
  S.assert.equal(s.stationId, S.station.id);
  if (['tendering', 'open'].includes(s.status)) { res.sales.push({ id: s.id, void: (await S.call('POST', `/sales/${s.id}/void`, { reason: 'ZZ TEST SCRUM-857 parts 2-4 proof cleanup' })).status }); continue; }
  let jobs = [];
  await expect.poll(async () => { jobs = (await S.sale(s.id)).printJobs ?? []; return jobs.every(j => j.status === 'printed'); }, { timeout: 90000 }).toBe(true).catch(() => null);
  res.sales.push({ id: s.id, status: s.status, receipt: s.receiptNumber, gross: s.totals?.grossSatang, jobs: jobs.map(j => j.status) });
}
const m = (await S.call('GET', '/members/lookup?phone=0898570230')).body?.member ?? null;
if (m) { S.assert.ok(/ZZ TEST/.test(`${m.nickname ?? ''} ${m.name ?? ''}`)); res.member = { archive: (await S.call('DELETE', `/members/${m.id}`)).status, after: (await S.call('GET', '/members/lookup?phone=0898570230')).body?.member ?? null }; }
S.assert.equal((await S.call('GET', `/stations/${S.station.id}`)).body.station.name, S.fixtureName);
res.devicesOff = (await S.call('PATCH', `/stations/${S.station.id}`, { devices: [] })).status;
res.deleted = (await S.call('DELETE', `/stations/${S.station.id}`)).status;
const stations = (await S.call('GET', `/branches/${S.branchId}/stations?includeArchived=true`)).body.stations;
res.ownTillsBothRuns = stations.filter(s => /ZZ TEST SCRUM-857 p2-4/.test(s.name)).map(s => ({ prefix: s.codePrefix, archived: s.archived, devices: s.devices.length }));
const t = S.pages.till.page;
if ((await t.request.get('/api/me')).status() === 200) res.tillSignOut = (await t.request.post('/api/auth/sign-out', { headers: { 'idempotency-key': S.randomUUID() } })).status();
res.tillMe = (await t.request.get('/api/me')).status();
const board = (await S.call('GET', `/checkin/board?branchId=${S.branchId}`)).body;
res.boardOfThisProof = board.families.filter(f => /ZZ TEST 857/.test(f.guardianName ?? '')).map(f => ({ tab: f.tab, children: f.children.map(c => c.status) }));
res.notOut = res.boardOfThisProof.filter(f => f.tab !== 'out');
res.waiting = ((await S.call('GET', `/checkin/registrations?branchId=${S.branchId}`)).body?.registrations ?? []).filter(r => /ZZ TEST 857/.test(r.guardianName ?? '')).length;
res.membersLeft = [];
for (let i = 10; i < 40; i++) { const n = S.zz(i); if ((await S.call('GET', `/members/lookup?phone=${n}`)).body?.member) res.membersLeft.push(n); }
res.adminSignOut = (await S.admin.post('/api/auth/sign-out', { headers: { 'idempotency-key': S.randomUUID() } })).status();
res.adminMe = (await S.admin.get('/api/me')).status();
S.receipt.cleanup.final = res; S.receipt.finishedAt = new Date().toISOString(); S.save();
return res;

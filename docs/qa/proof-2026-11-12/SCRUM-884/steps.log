r.tabs = await till.evaluate(() => [...document.querySelectorAll('button')].map(b => b.innerText.replace(/\s+/g, ' ').trim()).filter(t => /^(In Park|Upcoming|Out)\s*\d+$/.test(t)));
r.fit = await S.fit(till);
r.fit.truncated = r.fit.truncated.filter(t => t.cw > 2 && !/proof till/.test(t.text));

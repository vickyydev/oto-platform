S.cardRead = (page, guardian) => page.evaluate((guardian) => {
  const cards = [...document.querySelectorAll('div[class*="bg-card/50"], div.rounded-xl, div.rounded-2xl')].filter(c => c.innerText.includes(guardian) && c.querySelector('button'));

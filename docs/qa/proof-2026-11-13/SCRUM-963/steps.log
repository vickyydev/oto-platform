=== 2026-11-12T23:57:49.378Z 4: sizes at 600x1024 and 1024x600: channel buttons on Agreements, the language choices, the age picker; the keys never over the box being typed in
const { expect } = S;
S.phase = '4: sizes at 600x1024 and 1024x600: channel buttons on Agreements, the language choices, the age picker; the keys never over the box being typed in';
const till = S.till, d = S.d;
const c = d.getByTestId('display-consent');
const out = {};
// the photo (generated grey frame), then Agreements
const photo = c.getByTestId('consent-photo');
await photo.getByRole('button', { name: 'Start camera', exact: true }).tap();
await photo.getByRole('button', { name: 'Take photo', exact: true }).waitFor({ timeout: 15000 });
await d.waitForTimeout(1000);
await photo.getByRole('button', { name: 'Take photo', exact: true }).tap();
await expect(photo.getByTestId('consent-photo-received')).toBeVisible({ timeout: 30000 });
out.photo = S.flat(await photo.getByTestId('consent-photo-received').innerText());
await c.getByRole('button', { name: 'Continue', exact: true }).tap();
await c.getByTestId('consent-guardian').waitFor();
await d.waitForTimeout(800);
S.channelSizes = () => d.evaluate(() => {
  const r1 = v => Math.round(v * 10) / 10;
  const form = document.querySelector('[data-testid="display-consent"]');
  return [...form.querySelectorAll('button')].filter(b => /^(WhatsApp|Telegram|LINE)$/.test(b.textContent.trim()) && b.getBoundingClientRect().width > 0).map(b => { const r = b.getBoundingClientRect(); return { text: b.textContent.trim(), w: r1(r.width), h: r1(r.height), box: [r1(r.left), r1(r.top), r1(r.right), r1(r.bottom)] }; });
});
const langSizes = async () => { await S.openLang(d); const l = await S.langList(d); await S.openLang(d); return { pill: l.pill.h, choices: l.choices.map(x => ({ text: x.text, h: x.h, w: x.w })) }; };
const sizesAt = async (tag) => {
  const r = {};
  await c.getByRole('button', { name: /^(3\. Agreements)$/ }).tap(); await d.waitForTimeout(800);
  const wa = c.getByRole('button', { name: 'WhatsApp', exact: true }).first();
  await wa.scrollIntoViewIfNeeded(); await d.waitForTimeout(400);
  r.channels = await S.channelSizes();
  await S.shot(d, `04${tag === '600x1024' ? 'c' : 'f'}-${tag}-agreements-channel-buttons.png`);
  r.language = await langSizes();
  // guardian with the keys
  await c.getByTestId('consent-guardian').tap();
  await expect.poll(() => S.keys(d).count()).toBe(1); await d.waitForTimeout(500);
  if (!(await c.getByTestId('consent-guardian').inputValue())) await S.typeKeys(d, 'ZZ TEST PARENT A');
  await d.waitForTimeout(400);
  r.guardianPlacing = await S.placing(d, 'consent-guardian');
  await S.shot(d, `04${tag === '600x1024' ? 'd' : 'g'}-${tag}-guardian-keys-below-the-box.png`);
  await S.hideKeys(d); await d.waitForTimeout(300);
  // allergies with the keys (Care details)
  await c.getByRole('button', { name: /^(2\. Care details)$/ }).tap(); await d.waitForTimeout(800);
  await c.getByTestId('consent-allergies').tap();
  await expect.poll(() => S.keys(d).count()).toBe(1); await d.waitForTimeout(500);
  r.allergiesPlacing = await S.placing(d, 'consent-allergies');
  await S.hideKeys(d); await d.waitForTimeout(300);
  // the child's name and the age picker (Your children)
  await c.getByRole('button', { name: /^(1\. Your children)$/ }).tap(); await d.waitForTimeout(800);
  await c.getByTestId('consent-child-name').tap();
  await expect.poll(() => S.keys(d).count()).toBe(1); await d.waitForTimeout(500);
  r.namePlacing = await S.placing(d, 'consent-child-name');
  await S.hideKeys(d); await d.waitForTimeout(300);
  await c.getByRole('button', { name: /yrs|Tap to set age/ }).first().tap();
  const dlg = d.getByRole('dialog').last(); await dlg.waitFor(); await d.waitForTimeout(600);
  r.pickerOpened = await S.pickerSizes(d);
  if (!r.pickerOpened.back) { await dlg.getByRole('button', { name: '6', exact: true }).tap().catch(() => {}); await d.waitForTimeout(400); r.pickerNext = await S.pickerSizes(d); }
  await S.shot(d, `04${tag === '600x1024' ? 'e' : 'h'}-${tag}-age-picker-back-close-crumbs.png`);
  await (await dlg.getByRole('button', { name: 'Close' }).count() ? dlg.getByRole('button', { name: 'Close' }).last().tap() : d.keyboard.press('Escape'));
  await dlg.waitFor({ state: 'hidden' }).catch(() => {});
  await d.waitForTimeout(500);
  r.ageAfter = S.flat(await c.getByRole('button', { name: /yrs|Tap to set age/ }).first().innerText());
  r.under44 = [...r.channels.filter(x => x.h < 44), ...r.language.choices.filter(x => x.h < 44), ...(r.pickerOpened?.under44 ?? []), ...(r.pickerNext?.under44 ?? [])];
  return r;
};
out['600x1024'] = await sizesAt('600x1024');
await d.setViewportSize({ width: 1024, height: 600 }); await d.waitForTimeout(1200);
out['1024x600'] = await sizesAt('1024x600');
await d.setViewportSize({ width: 600, height: 1024 }); await d.waitForTimeout(1000);
out.mirror = await S.mirrorState(till);
S.receipt.reads.p4sizes = out; S.save();
return out;

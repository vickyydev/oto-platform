=== 2026-11-13T02:52:33.833Z clean up: the till session signed out; the ZZ stations retired; the ZZ printers archived; read back
S.phase = 'clean up: the till session signed out; the ZZ stations retired; the ZZ printers archived; read back';
const out = { stations: [], devices: [] };
out.tillSession = await S.close('till');
const all = (await S.call('GET', `/branches/${S.branchId}/stations?includeArchived=true`)).body.stations;
const mine = [S.station, S.display, S.tillB, S.tillC].filter(Boolean);
for (const st of mine) {
  const row = all.find(s => s.id === st.id);
  S.assert.ok(row && row.name.startsWith('ZZ TEST 971'), 'own station');
  const cleared = await S.call('PATCH', `/stations/${st.id}`, { devices: [] });
  const del = await S.call('DELETE', `/stations/${st.id}`);
  out.stations.push({ name: row.name, kind: row.kind, devicesCleared: cleared.status, clearCode: cleared.body?.error?.code ?? null, retired: del.status, retireCode: del.body?.error?.code ?? null });
}
const after = (await S.call('GET', `/branches/${S.branchId}/stations?includeArchived=true`)).body.stations;
out.stationsReadBack = mine.map(st => { const r = after.find(s => s.id === st.id); return { name: r.name, archived: Boolean(r.archived), devices: (r.devices ?? []).length, codePrefix: r.codePrefix ?? null }; });
const ids = { ...Object.fromEntries(Object.entries(S.dev).map(([k, d]) => [d.label, d.id])), ...(S.extraDev ?? {}) };
for (const [label, id] of Object.entries(ids)) {
  const now = (await S.devicesOnBox()).find(x => x.id === id);
  S.assert.ok(now && now.label.startsWith('ZZ TEST 971 '), 'own device');
  const del = now.archived ? { status: 'already' } : await S.call('DELETE', `/devices/${id}`);
  out.devices.push({ label, archive: del.status, stillAssignedTo: (del.body?.stillAssignedTo ?? []).length });
}
out.devicesReadBack = (await S.devicesOnBox()).filter(x => Object.values(ids).includes(x.id)).map(x => ({ label: x.label, archived: Boolean(x.archived) }));
out.zzLiveOnBox = (await S.devicesOnBox()).filter(x => !x.archived && /^ZZ TEST 971/.test(x.label)).map(x => x.label);
out.zzLiveStations = after.filter(s => !s.archived && /^ZZ TEST 971/.test(s.name)).map(s => s.name);
S.receipt.cleanup.records = out;
return out;

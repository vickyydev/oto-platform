S.phase = '6: the release read back, drawn as a page (API answers only)';
const h = S.receipt.reads.health.at(-1);
const rel = S.receipt.reads.release.at(-1);
const p2 = S.receipt.reads.p2?.till;
const esc = s => String(s ?? '').replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]);
const row = (k, v) => `<tr><td style="border:1px solid #bbb;padding:5px 9px;background:#f6f6f6;vertical-align:top">${esc(k)}</td><td style="border:1px solid #bbb;padding:5px 9px">${v}</td></tr>`;
const ctx = await S.browser.newContext({ viewport: { width: 1200, height: 800 } });
const page = await ctx.newPage();
await page.setContent(`<html><body style="font-family:Segoe UI,Arial;margin:0;padding:22px 26px;background:#fff;color:#111">
<h2 style="margin:0 0 6px">SCRUM-906 point 6: the release, read back through the staging api (no database read)</h2>
<p style="margin:2px 0 10px;color:#555">oto-api-staging dep-dbqrjnbbc2fs73e80610 live at f1735975 from 13:11:38Z (20:11 Bangkok). Read at ${esc(S.bkk(rel.at))} Bangkok.</p>
<table style="border-collapse:collapse;font-size:14px;width:100%">
${row('GET /api/ops/health: job:parties.slips', esc(JSON.stringify(h.job)) + '<br><b>No counts</b> (notCaughtUp, changesRebased) are in the answer: the register gives status, last run and outcome only.')}
${row('Audit party.slips_schedule_start since 13:05Z', esc(rel.scheduleStart.total) + ' rows: ' + esc(rel.scheduleStart.entries.map(e => `${e.bangkok} ${e.branchIsFloresta ? 'Central Floresta' : 'the other park'} (startedAt ${e.after?.startedAt})`).join('; ')))}
${row('Audit party.slips_rebase since 13:05Z', esc(rel.rebase.total) + ' row: ' + esc(rel.rebase.entries.map(e => `${e.bangkok} Central Floresta, a party printed before the release (stations ${e.after?.stations?.map(s => s.station + ' ' + s.source).join(', ')}), composer ${e.after?.composer}`).join('; ')) + ' (not this run\'s party; nothing printed for it)')}
${row('Audit party.slips_print since 13:05Z', esc(rel.print.total) + ' row: ' + esc(rel.print.entries.map(e => `${e.bangkok} trigger ${e.after?.trigger}`).join('; ')) + ' (this run\'s own press on party 1)')}
${row('Audit party.slips_change since 13:05Z', esc(rel.change.total) + ' rows: ' + esc(rel.change.entries.map(e => e.bangkok).join(', ')) + ' (this run\'s own two BEO changes on party 1)')}
${row('Kitchen and bar print jobs at Central Floresta since the api went live', esc(rel.parkKitchenBarJobsSinceApi.length) + ': ' + esc(rel.parkKitchenBarJobsSinceApi.map(j => j.bangkok + ' ' + j.kind).join(', ')) + ' (all at the ZZ TEST till, this run\'s own)')}
${row('Kitchen and bar print jobs at the other park since the api went live', esc(rel.otherParks.map(p => p.kitchenBarJobsSinceApi).join(', ')))}
${row('Party 2 (no package, slip time 11:00, made 20:28)', esc(`slips ${JSON.stringify(p2?.slips)}`) + ': the schedule did not print it, with the ZZ TEST till named for party slips from 20:29:30 to 20:42:15 (not caught up)')}
</table></body></html>`);
await page.screenshot({ path: S.resolve(S.out, '06a-release-readback.png'), fullPage: true });
await ctx.close();
return 'ok';

await till.waitForTimeout(1200);
out.farChosen = (await S.rowRead(till)).chosen;
for (let i = 0; i < 80; i++) { await S.wheelRow(till, -150, 1); const x = await S.rowRead(till); if (x.scrollLeft <= 1) break; }

S.cover = async (name, boxes) => {
  const file = S.resolve(S.out, name);
  const b64 = S.readFileSync(file).toString('base64');
  const ctx = await S.browser.newContext({ viewport: { width: 2000, height: 1000 } });
  const page = await ctx.newPage();
  await page.setContent(`<html><body style="margin:0"><div style="position:relative;display:inline-block"><img id="i" src="data:image/png;base64,${b64}">${boxes.map(([x, y, w, h]) => `<div style="position:absolute;left:${x}px;top:${y}px;width:${w}px;height:${h}px;background:#18181b"></div>`).join('')}</div></body></html>`);
  const size = await page.evaluate(() => { const i = document.getElementById('i'); return [i.naturalWidth, i.naturalHeight]; });
  await page.setViewportSize({ width: size[0], height: size[1] });
  await page.locator('div').first().screenshot({ path: file });
  await ctx.close();
  return size;
};

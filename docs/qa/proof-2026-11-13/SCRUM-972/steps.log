=== 2026-11-13T02:04:03.971Z hunt: "Start card payment" pressed twice quickly while the box will refuse; then Back and Cancel
S.phase = 'hunt: "Start card payment" pressed twice quickly while the box will refuse; then Back and Cancel';
const { expect } = S;
const r = {};
const till = S.till;
await S.unlock('rec');
await till.goto('/');
S.receipt.numbers.h2 = S.free[2];
await S.walkIn(till, S.free[2]);
await S.ticket(till, 1, 1);
const sale = await S.saleWritten('h2-double-press');
r.sale = sale.id;
await expect(S.paymentStep(till)).toBeVisible({ timeout: 30000 });
r.assign = await S.assignTerminal();
await till.getByRole('heading', { name: 'Card', exact: true }).first().click();
const starts = [];
const onResp = rr => { const u = new URL(rr.url()); if (rr.request().method() === 'POST' && u.pathname === '/api/payments/attempts') starts.push(rr); };
till.on('response', onResp);
const t0 = Date.now();
await S.paymentStep(till).getByRole('button', { name: 'Start card payment', exact: true }).evaluate(el => { el.click(); setTimeout(() => el.click(), 60); setTimeout(() => el.click(), 160); });
r.secondsAssignToPress = Math.round((t0 - S.lastAssignAt) / 100) / 10;
r.timeline = [];
let last = '';
while (Date.now() - t0 < 30000) {
  const txt = S.flat(await S.paymentStep(till).innerText().catch(() => ''));
  if (txt !== last) { r.timeline.push({ s: Math.round((Date.now() - t0) / 100) / 10, text: txt.slice(0, 300) }); last = txt; }
  if (/Payment declined|Staff review required|Payment result unknown/.test(txt)) break;
  await till.waitForTimeout(250);
}
await till.waitForTimeout(1500);
till.off('response', onResp);
r.startCalls = [];
for (const s of starts) { const b = await s.json().catch(() => null); r.startCalls.push({ status: s.status(), attempt: b?.attempt?.id ?? null, attemptStatus: b?.attempt?.status ?? null, replay: s.headers()['idempotent-replay'] ?? s.headers()['idempotency-replayed'] ?? null, code: b?.error?.code ?? null }); }
await S.shot(till, 'H2a-till-double-press-declined.png');
const sd = await S.sale(sale.id);
r.attempts = (sd.attempts ?? []).map(a => ({ id: a.id, status: a.status }));
r.commands = [];
for (const a of r.attempts) r.commands.push(...(await S.termCommandsFor(a.id)).map(c => ({ attempt: a.id, kind: c.kind, mode: c.mode, state: c.state, errorCode: c.errorCode })));
// clean up this sale from the till: Back, Cancel
await S.paymentStep(till).getByRole('button', { name: 'Back', exact: true }).click();
await till.waitForTimeout(1200);
const voidResp = till.waitForResponse(rr => rr.request().method() === 'POST' && /\/api\/sales\/[^/]+\/void$/.test(new URL(rr.url()).pathname), { timeout: 20000 }).catch(() => null);
await till.getByRole('button', { name: 'Cancel', exact: true }).last().click();
const vr = await voidResp;
r.void = vr ? { status: vr.status(), saleIsOurs: (await vr.json().catch(() => null))?.sale?.id === sale.id } : null;
r.saleAfter = (await S.sale(sale.id)).sale.status;
S.receipt.hunt.doublePress = r;
const text = [
  `hunt: three clicks on "Start card payment" within 160 ms (in the page), ${r.secondsAssignToPress} s after assigning the terminal`,
  `POST /api/payments/attempts answers: ${JSON.stringify(r.startCalls, null, 1)}`,
  `the sale's attempts: ${JSON.stringify(r.attempts)}`,
  `terminal commands per attempt: ${JSON.stringify(r.commands, null, 1)}`,
  `timeline: ${JSON.stringify(r.timeline, null, 1)}`,
  `then Back + Cancel: void ${JSON.stringify(r.void)}; sale ${r.saleAfter}`,
].join('\n');
await S.txtShot(text, 'H2b-api-double-press-one-attempt.png', 'Hunt: Start card payment pressed twice quickly');
return r;

=== 2026-11-13T01:54:37.303Z 1c: void the held ZZ TEST sale (it answered 409 PAYMENT_IN_FLIGHT before the fix)
S.phase = '1c: void the held ZZ TEST sale (it answered 409 PAYMENT_IN_FLIGHT before the fix)';
const r = {};
const s0 = await S.sale(S.HELD_SALE);
S.assert.equal(s0.sale.id, S.HELD_SALE);
S.assert.equal(s0.sale.status, 'tendering', 'still unpaid');
S.assert.ok((s0.attempts ?? []).every(a => a.status === 'declined'), 'no money on it');
r.at = new Date().toISOString();
const v = await S.call('POST', `/sales/${S.HELD_SALE}/void`, { reason: 'ZZ TEST SCRUM-972 held card' });
r.void = { status: v.status, code: v.body?.error?.code ?? null, message: v.body?.error?.message ?? null, saleStatus: v.body?.sale?.status ?? null, voidReason: v.body?.void?.reason ?? null };
const s = await S.sale(S.HELD_SALE);
r.after = { status: s.sale.status, attempts: (s.attempts ?? []).map(x => x.status), refundStatus: s.refundStatus ?? null };
const au = await S.call('GET', `/audit?entityId=${S.HELD_SALE}&limit=20`);
r.saleAudit = (au.body?.entries ?? []).map(e => ({ at: e.createdAt, action: e.action }));
S.receipt.reads.p1void = r;
const text = [
  `POST /api/sales/${S.HELD_SALE}/void  { reason: "ZZ TEST SCRUM-972 held card" }   (admin session)  ${r.at}`,
  `  -> HTTP ${r.void.status}${r.void.code ? ' ' + r.void.code + ' ' + r.void.message : ''}`,
  `  sale.status in the answer: ${r.void.saleStatus}; void.reason: ${r.void.voidReason}`,
  '',
  '  (the SCRUM-952 proof, 12 Nov 23:13 UTC, the same call: 409 PAYMENT_IN_FLIGHT "A payment on this sale is still in progress — finish or cancel it before voiding the sale")',
  '',
  `GET /api/sales/${S.HELD_SALE} after: sale.status ${r.after.status}; attempts ${JSON.stringify(r.after.attempts)}`,
  '',
  `GET /api/audit?entityId=<sale> -> ${JSON.stringify(r.saleAudit, null, 1)}`,
].join('\n');
await S.txtShot(text, '01c-api-held-sale-voided.png', 'Point 1: the held ZZ TEST sale voided');
return r;

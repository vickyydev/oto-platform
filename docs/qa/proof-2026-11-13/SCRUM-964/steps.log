=== 2026-11-13T03:35:36.080Z 1: A signs in at the own desk till (1680x1050); a ZZ TEST display paired; A rings a ZZ TEST walk-in sale up to the payment step (display: Please pay)
S.phase = '1: A signs in at the own desk till (1680x1050); a ZZ TEST display paired; A rings a ZZ TEST walk-in sale up to the payment step (display: Please pay)';
const { expect } = S;
const till = await S.openTill('desk', { width: 1680, height: 1050 });
S.till = till;
const st = await S.formSignIn(till, 'A');
const after = await S.afterSignIn(till);
await S.landing(till).waitFor({ timeout: 30000 });
const me = await S.me(till);
S.walkNames(me.body);
S.keepAlive(true);
const d = await S.pairDisplay('d1');
S.d = d;
await S.landing(d).waitFor({ timeout: 60000 });
await expect(till.getByText(/^Display connected/)).toBeVisible({ timeout: 90000 }).catch(() => {});
await till.waitForTimeout(1500);
const n = S.nextNumber();
S.receipt.numbers.p1 = n;
await S.firstScreen(d, till, n, { tap: true });
await S.ticket(till, 1, 1, '1 Hour Play');
await expect(till.getByRole('button', { name: /^Pay ฿/ })).toBeEnabled({ timeout: 20000 });
await till.waitForTimeout(1500);
const [written] = await Promise.all([
  till.waitForResponse(r => new URL(r.url()).pathname === '/api/sales' && r.request().method() === 'POST', { timeout: 45000 }),
  S.pressPay(till),
]);
const sale = (await written.json()).sale;
S.knownSales.add(sale.id); S.p1sale = sale.id;
S.receipt.created.push({ kind: 'sale', point: '1', id: sale.id, status: sale.status }); S.save();
await expect(d.getByText(/Please pay/)).toBeVisible({ timeout: 30000 }).catch(() => {});
await till.waitForTimeout(1500);
const dText = S.flat(await d.locator('body').innerText());
const notice = await S.notice(till);
await S.both('01a-A-rung-up-payment-step-display-please-pay.png', 'point 1 — A rang the walk-in sale up: the payment step; the display says Please pay', till, d);
S.receipt.reads.p1a = { signIn: st, ...after, atOwnStation: JSON.stringify(me.body ?? {}).includes(S.station.id), sale: { id: sale.id, status: sale.status }, amountDue: await S.amountDue(till), display: dText.slice(0, 400), notice };
S.save();
return S.receipt.reads.p1a;

=== 2026-11-12T15:20:55.813Z clean up: the members the registrations made on this run's own numbers archived; the refunded sale's credit wallet read; the credit code scrubbed from the log
S.phase = 'clean up: the members the registrations made on this run\'s own numbers archived; the refunded sale\'s credit wallet read; the credit code scrubbed from the log';
const res = { members: [] };
for (const n of S.free.slice(0, 12)) {
  const m = (await S.call('GET', `/members/lookup?phone=${n}`)).body?.member ?? null;
  if (!m) continue;
  const label = `${m.nickname ?? ''} ${m.name ?? ''}`;
  S.assert.ok(/ZZ TEST/i.test(label), 'only own named test members: ' + n);
  const del = await S.call('DELETE', `/members/${m.id}`);
  const again = (await S.call('GET', `/members/lookup?phone=${n}`)).body?.member ?? null;
  res.members.push({ n, id: m.id, name: label.trim(), del: del.status, afterLookup: again ? again.id : null });
}
const o = await S.sale(S.fam.O.sale);
const walletId = o.grants?.[0]?.walletId;
for (const path of [`/wallets/${walletId}`, `/wallets?walletId=${walletId}`]) {
  const r = await S.call('GET', path);
  res[path.split('?')[0].replace(S.ID, ':id')] = { status: r.status, keys: r.body ? Object.keys(r.body).slice(0, 12) : null, state: r.body ? JSON.stringify(r.body).match(/"(status|state|voided[A-Za-z]*|balanceSatang|archivedAt|revokedAt)":[^,}]*/g)?.slice(0, 6) ?? null : null };
}
// scrub the credit code from the receipt (it was answered in the clean-up step's read)
if (S.receipt.cleanup.rest?.ordinaryGrants) S.receipt.cleanup.rest.ordinaryGrants = { grants: '[one adult credit grant ฿350, its code withheld]' };
S.save();
S.receipt.cleanup.members = res.members; S.save();
return res;

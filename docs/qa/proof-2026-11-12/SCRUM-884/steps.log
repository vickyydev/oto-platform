=== 2026-11-12T16:00:21.994Z 1/2: Tourist, the ticket list and the add-ons, 1440x900
S.W='1440x900'; S.pfx='02';
// args: S.W, S.pfx  (the customer type step is on screen)
S.phase = `1/2: Tourist, the ticket list and the add-ons, ${S.W}`;
const till = S.till;
await S.unlock('till');
const pfx = S.pfx;
const r = {};
await till.getByRole('heading', { name: 'Tourist', exact: true }).first().click();
await till.getByRole('heading', { name: 'Add to Sale', exact: true }).waitFor({ timeout: 20000 });
await till.waitForTimeout(1500);
// the ticket list
r.list = await till.evaluate(() => {
  const h = [...document.querySelectorAll('h2,h1')].find(e => e.innerText.trim() === 'Add to Sale');
  const step = h.closest('[class*="@container/step"]') ?? h.parentElement.parentElement;
  const sb = step.getBoundingClientRect();
  const cards = [...step.querySelectorAll('h3')].map(x => { const c = x.closest('[class*="cursor-pointer"]') ?? x.closest('button') ?? x.parentElement; const b = c.getBoundingClientRect(); return { name: x.innerText.trim(), left: Math.round(b.left), top: Math.round(b.top), width: Math.round(b.width), height: Math.round(b.height) }; });
  const rows = [...new Set(cards.map(c => c.top))].length;
  return { stepWidth: Math.round(sb.width), cards, oneARow: cards.length > 0 && new Set(cards.map(c => c.left)).size === 1, rows };
});
r.addDropOff = await S.boxOf(till, 'Add drop-off child');
r.doneAdding = await S.boxOf(till, 'Done Adding');
r.fitList = await S.fit(till);
await S.shot(till, `${pfx}a-${S.W}-split-tourist-ticket-list.png`);
// 1 Hour Play: the configure step with its add-ons
await till.getByRole('heading', { name: '1 Hour Play', exact: true }).first().click();
await till.waitForTimeout(1500);
await S.quantity(till, 'Kids', 1); await S.quantity(till, 'Adults', 1);
await till.waitForTimeout(1200);

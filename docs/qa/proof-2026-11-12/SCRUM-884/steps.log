S.phase = 'clean up: the party (cancel the settlement, delete in the OTO App)';
const till = S.till;
await S.unlock('till');
await till.setViewportSize({ width: 1440, height: 900 });
const out = {};
await till.getByRole('button', { name: 'Close', exact: true }).click().catch(async () => { await till.keyboard.press('Escape'); });
await till.waitForTimeout(2000);
await till.goto(`/parties?party=${S.partyId}`); await till.waitForTimeout(4500);
const cancelBtn = till.getByRole('button', { name: 'Cancel settlement', exact: true }).first();
out.cancelVisible = await cancelBtn.isVisible().catch(() => false);
if (out.cancelVisible) {
  await cancelBtn.click(); await till.waitForTimeout(800);
  await till.locator('#cancel-settlement-reason').fill('ZZ TEST SCRUM-884 proof: clean-up');
  const voided = S.settleSale ? till.waitForResponse(x => new URL(x.url()).pathname === `/api/sales/${S.settleSale}/void`, { timeout: 30000 }).catch(() => null) : Promise.resolve(null);
  await till.getByRole('dialog').getByRole('button', { name: 'Cancel settlement', exact: true }).click();
  const v = await voided; out.voidStatus = v?.status() ?? null;
  await till.waitForTimeout(3000);
}
const pAfter = (await S.call('GET', `/parties/${S.partyId}?branchId=${S.branchId}`)).body;
out.settlementAfter = pAfter?.event?.party?.settlement?.state ?? null;
out.saleAfter = S.settleSale ? (await S.call('GET', `/sales/${S.settleSale}`)).body?.sale?.status : null;
S.assert.equal(pAfter?.event?.title ?? pAfter?.event?.name ?? S.PARTY, S.PARTY);
if (!S.appCtx) await S.appSignIn();
out.delete = (await S.appCall('DELETE', `/admin/events/${S.partyId}`)).status;
out.readBack = { app: (await S.appCall('GET', `/admin/events/${S.partyId}`)).status, till: (await S.call('GET', `/parties/${S.partyId}?branchId=${S.branchId}`)).status };
const so = await S.appCtx.request.post(S.LAUNCHER + '/api/auth/sign-out', { data: {}, headers: { 'Idempotency-Key': S.randomUUID() } });
out.appSignOut = so.status();
await S.appCtx.close(); S.appCtx = null;
S.receipt.cleanup.party = out; S.save();
return out;

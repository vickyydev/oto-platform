S.phase = '6: the job register on the Health api (read only)';
const h = await S.call('GET', '/ops/health');
const body = h.body ?? {};
const keys = Object.keys(body);
const find = (o, d = 0) => {
  if (!o || typeof o !== 'object' || d > 4) return null;
  if (Array.isArray(o)) { for (const x of o) { const f = find(x, d + 1); if (f) return f; } return null; }
  if (Object.values(o).some(v => v === 'job:parties.slips')) return o;
  for (const v of Object.values(o)) { const f = find(v, d + 1); if (f) return f; }
  return null;
};
const job = find(body);
const r = { status: h.status, topKeys: keys, job };
(S.receipt.reads.health ??= []).push({ at: new Date().toISOString(), ...r });
return r;

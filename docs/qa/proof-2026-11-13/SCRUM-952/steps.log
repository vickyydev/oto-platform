=== 2026-11-12T23:07:40.303Z 5: each eligible device through the Console edit form, address only; a guard stops any save that changes more
S.phase = '5: each eligible device through the Console edit form, address only; a guard stops any save that changes more';
const { expect } = S;
const c = S.pages.console.page;
const stable = v => JSON.stringify(v, (k, x) => (x && typeof x === 'object' && !Array.isArray(x)) ? Object.fromEntries(Object.entries(x).sort(([a], [b]) => a.localeCompare(b))) : x);
const out = [];
let n = 0;
for (const f of (S.p5targets ?? S.p5.found.filter(x => x.eligible))) {
  n += 1;
  const tag = S.p5targets ? `05z${n}-control` : `05${String.fromCharCode(97 + n)}`; // 05b.. per device
  const slug = f.label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/-$/, '');
  const newAddress = f.address.replace(/^192\.168\.88\./, '192.0.2.');
  const before = (await S.call('GET', `/boxes/${f.boxId}/devices?includeArchived=true`)).body.devices.find(d => d.id === f.id);
  const rec = { label: f.label, box: f.box, oldAddress: before.address, wantAddress: newAddress, sent: null, extra: [], outcome: null };
  S.assert.equal(before.transport, 'simulated'); S.assert.equal(f.boxRole, 'virtual');
  await c.reload();
  const box = await S.goBox(c, f.branchId, f.box);
  const row = box.getByRole('listitem').filter({ has: c.getByText(f.label, { exact: true }) }).first();
  await row.scrollIntoViewIfNeeded();
  await S.shot(c, `${tag}1-console-${slug}-before.png`);
  await row.getByRole('button', { name: 'Edit', exact: true }).click();
  const editing = box.getByRole('listitem').filter({ has: c.getByRole('button', { name: 'Archive it', exact: true }) });
  await expect(editing).toHaveCount(1);
  await editing.getByLabel(/^Address/).fill(newAddress);
  // the guard: only a PATCH that changes the address and nothing else goes to the platform
  const route = `**/api/devices/${f.id}`;
  await c.route(route, async (req) => {
    if (req.request().method() !== 'PATCH') return req.continue();
    const body = req.request().postDataJSON() ?? {};
    rec.sent = body;
    const known = ['label', 'address', 'model', 'protocol', 'terminalId', 'merchantId', 'serialNumber', 'settings'];
    for (const k of Object.keys(body)) if (!known.includes(k)) rec.extra.push(`${k} (unknown field)`);
    if ('label' in body && body.label !== before.label) rec.extra.push(`label ${JSON.stringify(before.label)} -> ${JSON.stringify(body.label)}`);
    for (const k of ['model', 'protocol', 'terminalId', 'merchantId', 'serialNumber']) if (k in body && (body[k] ?? null) !== (before[k] ?? null)) rec.extra.push(`${k} ${JSON.stringify(before[k] ?? null)} -> ${JSON.stringify(body[k] ?? null)}`);
    if ('settings' in body && stable(body.settings ?? null) !== stable(before.settings ?? null)) rec.extra.push(`settings ${stable(before.settings ?? null)} -> ${stable(body.settings ?? null)}`);
    if (body.address !== newAddress) rec.extra.push(`address sent ${JSON.stringify(body.address)} (wanted ${newAddress})`);
    if (rec.extra.length === 0) { rec.outcome = 'sent'; return req.continue(); }
    rec.outcome = 'stopped in the browser: the form would change more than the address';
    return req.abort('failed');
  });
  await editing.getByRole('button', { name: 'Save', exact: true }).click();
  await c.waitForTimeout(2500);
  rec.formMessage = S.flat(await editing.locator('p.text-destructive').allInnerTexts().then(a => a.join(' | ')).catch(() => '')) || null;
  await editing.getByLabel(/^Address/).scrollIntoViewIfNeeded().catch(() => {});
  await S.shot(c, `${tag}2-console-${slug}-form-${rec.outcome === 'sent' ? 'saved' : 'save-stopped'}.png`);
  await c.unroute(route);
  if (await editing.count()) await editing.getByRole('button', { name: 'Cancel', exact: true }).click().catch(() => {});
  const after = (await S.call('GET', `/boxes/${f.boxId}/devices?includeArchived=true`)).body.devices.find(d => d.id === f.id);
  rec.after = { address: after.address, label: after.label, kind: after.kind, model: after.model ?? null, protocol: after.protocol ?? null, settings: after.settings ?? null, updatedAt: after.updatedAt ?? null };
  rec.unchanged = stable({ a: after.address, l: after.label, k: after.kind, m: after.model ?? null, p: after.protocol ?? null, s: after.settings ?? null }) === stable({ a: before.address, l: before.label, k: before.kind, m: before.model ?? null, p: before.protocol ?? null, s: before.settings ?? null });
  out.push(rec);
  S.receipt.reads.p5edits = out; S.save();
}
return out.map(x => ({ label: x.label, box: x.box, oldAddress: x.oldAddress, wantAddress: x.wantAddress, outcome: x.outcome, extra: x.extra, formMessage: x.formMessage, afterAddress: x.after.address, unchanged: x.unchanged }));

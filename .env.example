# --- Database -----------------------------------------------------------
# Postgres 16 connection string. `docker compose -f infra/docker-compose.yml up -d`
# serves it on 5433 with these credentials.
DATABASE_URL=postgres://oto:oto@localhost:5433/oto
# Optional: a Postgres server the API integration tests create throwaway
# databases on. Unset, they start an embedded Postgres 16 themselves, so
# `pnpm test` needs neither Docker nor this variable.
TEST_DATABASE_URL=

# --- API server ---------------------------------------------------------
# development | test | production. In production the api REFUSES to start on
# a development default (localhost database, demo MinIO keys, insecure
# cookie) rather than starting and putting real data somewhere wrong.
NODE_ENV=development
# pino level: trace | debug | info | warn | error | fatal | silent.
# Defaults to info, and to silent under NODE_ENV=test.
LOG_LEVEL=info
API_PORT=3001
# Render supplies PORT and it wins over API_PORT when set.
# Session lifetime (server-side row + cookie maxAge).
SESSION_TTL_HOURS=12
# Set true behind HTTPS in production; false for local http dev.
COOKIE_SECURE=false
# Sign-in throttling: failures per phone before a cooldown applies. This is
# the bucket with the security value — five wrong passwords on one number and
# that number waits. Counters live in Postgres and survive a restart.
AUTH_MAX_FAILURES=5
# The same failures counted per ADDRESS, on its own ceiling. Sized for a
# shared address: every till behind one site rewrite shares it, and so do the
# Console and the launcher, so this is a ceiling on absurdity rather than a
# guess-count. It was AUTH_MAX_FAILURES x 4, at which five mistyped passwords
# anywhere locked the whole estate out of signing in for the cooldown.
AUTH_MAX_FAILURES_PER_ADDRESS=50
AUTH_COOLDOWN_SECONDS=300
# Wrong setup/reset codes accepted before every outstanding code for that
# account is invalidated.
CODE_MAX_ATTEMPTS=5
# How many proxy hops in front of the api are OURS, counted inward from the
# socket. X-Forwarded-For is appended left to right, so its LAST entry is the
# one the nearest proxy wrote and its FIRST is whatever the client chose to
# send. 0 trusts nothing and req.ip is the socket address; 1 trusts the socket
# and reads the last entry; each further hop reads one entry further left — and
# every hop past the real ones is an entry a caller can write themselves, which
# buys them a fresh rate-limit bucket and a fresh sign-in failure count. Local
# dev has no proxy, so 0. Fastify fails a numeric trustProxy closed
# (SCRUM-353), so app.ts hands this to it as a function. THE FALLBACK: on the
# deployments TRUST_PROXY_ADDRS below is set and replaces this count.
TRUST_PROXY=0
# WHICH proxies in front of the api are OURS, by address: comma-separated
# addresses and CIDR blocks, e.g. 10.0.0.0/8,104.16.0.0/13,2400:cb00::/32.
# Set, it REPLACES the count above: X-Forwarded-For is walked from the right
# and every entry whose address is listed is stepped over, so req.ip is the
# first entry no listed proxy wrote. That is the only form that can reach past
# a proxy safely — a count trusts whatever wrote the entry at that position,
# including on a request that never passed through that proxy. Empty here:
# local dev has nothing in front of it. On Render it carries the platform's
# internal balancer and Cloudflare's published ranges, measured as the
# addresses callers were being filed under (SCRUM-353, SCRUM-367); the value
# and its sources are in render.yaml. A malformed entry refuses the boot.
TRUST_PROXY_ADDRS=
# Browser origins allowed to send state-changing requests. Empty = same origin
# only. Comma-separated, scheme + host + port, no trailing slash, e.g.
# https://oto-pos.onrender.com,https://oto-console.onrender.com
ALLOWED_ORIGINS=
# Secondary per-IP bucket on the unauthenticated routes (/auth code routes and
# /public/*). Generous on purpose: a mall shares very few public addresses.
RATE_LIMIT_IP_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60
# Primary per-phone bucket on the code-issuing routes.
RATE_LIMIT_CODE_MAX=5
RATE_LIMIT_CODE_WINDOW_SECONDS=900
# Idempotency-key retention.
IDEMPOTENCY_TTL_HOURS=24

# --- POS dev server -----------------------------------------------------
# Vite port for apps/pos (proxies /api to the API server).
POS_PORT=25741
# Point the Playwright smoke flows at a deployment instead of the dev server,
# e.g. https://oto-pos-staging.onrender.com. Unset, they use the dev proxy.
SMOKE_BASE_URL=

# --- Deployment profile -------------------------------------------------
# WHICH deployment this is, as distinct from how the code is built above.
# Staging runs the production build against throwaway data, so NODE_ENV
# cannot decide whether the playground controls exist — this does. Every
# service in a Render environment carries the same value: `staging` on the
# staging services, `production` on the production ones, `local` here. On
# `production` the api refuses to boot with either of the two playground
# values below (SEED_PROFILE=staging, OPS_TEST_CONTROLS=true); on anything
# but `local` it refuses SMS_ADAPTER=console.
DEPLOY_ENV=local
# A deployment the park's team plays with, running production code against
# throwaway data. `staging` seeds the demo tenant; `production` does not.
SEED_PROFILE=staging
# Which roles this process runs: api, edge, jobs (comma-separated). One
# Render service carries all three for the demo; splitting jobs out means
# removing it here, or the runner competes with itself for its own locks.
PROCESS_ROLES=api
# Where an alert goes. `console` until the owner names a channel (decision 17).
ALERT_CHANNELS=console
# Enables the staging-only operator controls — "Reset demo data" and the
# device simulators' fault injection. NEVER true on a real deployment.
OPS_TEST_CONTROLS=false
# How often the analytics rollup runs, in seconds (S2-15b, default 300). Today's
# figures on Today > Performance and in Radar refresh within this interval, and
# a day a late fact marked (a box sale synced late, a refund of an old sale) is
# corrected on the next run. Only a process carrying the `jobs` role runs it.
ROLLUP_INTERVAL_S=300

# --- The sync core's four dials (S2-05) ---------------------------------
# All optional: leave them unset and the defaults in `syncSettings()` apply.
# They are listed here because a deployment that sets one gets it VALIDATED
# at boot rather than silently ignored — an unknown name in a Render
# environment does nothing at all, quietly, for as long as nobody checks.
#
# How long a box's facts are kept in `edge.sync_event` (365). Dedupe does not
# depend on this: `sync_cursor` is never swept, so an event past the window is
# still recognisably a replay rather than a second member.
SYNC_EVENT_RETENTION_DAYS=365
# How long a cloud-side change stays on the feed a box pulls (30). A box away
# longer than this takes a whole cache bundle instead of the deltas.
SYNC_CHANGE_RETENTION_DAYS=30
# The tape of one station's afternoon — every intent and snapshot (30).
# Telemetry, not record: it answers "the display stopped updating at 3pm" the
# next morning and is worth nothing a month later.
STATION_EVENT_RETENTION_DAYS=30
# A box that IS calling home but whose oldest unsynced event is older than
# this is not syncing (300s). Quieter than silence, and the fault with money
# behind it — the till's own banner reads this same verdict.
SYNC_STALE_AFTER_S=300

# --- Object storage (MinIO locally, any S3 API in production) -----------
# Host ONLY — no scheme, no bucket, no trailing slash. minio-js refuses a URL
# at construction, which is a crash at boot rather than a bad request later.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=oto
MINIO_SECRET_KEY=otosecret123
# The S3 region. Cloudflare R2 wants `auto`; AWS wants its real region. Set
# explicitly so the SDK never spends a round trip probing for it — which also
# means presigning a URL touches the network not at all.
MINIO_REGION=us-east-1
MINIO_BUCKET=oto-files

# --- SMS (verification / reset codes) ------------------------------------
# `console` writes the code to the API log (the terminal running `pnpm dev`).
# It is a LOCAL-DEVELOPMENT adapter and nothing else: the API refuses to boot
# with it whenever DEPLOY_ENV is anything but `local`, staging included — a
# code printed into a hosted log stream reaches whoever can read the logs and
# never reaches the phone, so nobody on that deployment could finish setting
# up an account or reset a password.
# `twilio` sends a real SMS. It needs TWILIO_ACCOUNT_SID, TWILIO_FROM and ONE
# of the two credential shapes below: the API THROWS AT BOOT while either is
# incomplete, so a deployment does not start until it can reach a phone. There
# is no fallback in either direction — that is the point, because a fallback
# fails silently and looks healthy doing it.
# `twilio_verify` (SCRUM-455) hands the whole code to Twilio's Verify API:
# Twilio generates, sends AND checks it through its own pre-registered senders,
# the route that reaches Thai phones without registering a sender of our own.
# It needs TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN and TWILIO_VERIFY_SERVICE_SID
# ("VA…") below, and throws at boot the same way if one is missing or the wrong
# shape. The platform stores no code with this adapter — only an anchor row.
SMS_ADAPTER=console
# All from https://console.twilio.com.
#
# The account, always required: it names the account in the request URL rather
# than authenticating, so an API key does not replace it. Begins "AC".
TWILIO_ACCOUNT_SID=
# RECOMMENDED CREDENTIAL — an API key of type Standard (Account → API keys &
# tokens → Create API key). Two reasons to prefer it over the auth token:
# it is revoked and rotated on its own, so replacing the credential this
# deployment uses is not an event for every other integration on the account;
# and a Standard key cannot manage keys or change account settings, while the
# auth token can do anything the account can do. The SID begins "SK" and the
# secret is shown once, at creation. Set both or neither — half a pair is
# refused at boot rather than silently falling back to the auth token.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# FALLBACK — the account's Auth Token, shown on the console dashboard. Used
# only when no API key is set. Leave empty once the key above is in place.
TWILIO_AUTH_TOKEN=
# An SMS-capable Twilio number in E.164 (e.g. +15005550006) or a Messaging
# Service SID ("MG..."). Trial accounts can only text numbers verified in the
# Twilio console, so add every phone used for a walkthrough to that list first.
TWILIO_FROM=
# A Twilio Verify service ("VA..."). The route that reaches Thai phones without
# registering a sender: Verify generates, sends and checks the code itself
# through Twilio's pre-registered senders. Read by the twilio_verify adapter
# (SCRUM-455), which refuses to construct without it; leave empty for the
# console and twilio adapters.
TWILIO_VERIFY_SERVICE_SID=

# --- Sprint reporting over WhatsApp ---------------------------------------
# Read only by `node scripts/sprint-report.mjs` today. Nothing in the API
# depends on them, so leaving them empty changes nothing about a deployment.
#
# The sending identity is a WhatsApp-enabled Twilio sender, not the SMS number
# above — they are different channels on the same account. Two ways to get one:
#   - The sandbox, which works in minutes: Twilio console → Messaging → Try it
#     out → Send a WhatsApp message. It gives you a number and a join code, and
#     EACH RECIPIENT must send that code to it once from their own WhatsApp
#     before anything can be delivered to them. Sandbox messages expire after
#     24 hours of recipient silence, so it is for proving the pipe, not for
#     running on.
#   - A WhatsApp Business sender, which is the permanent answer and needs a
#     Meta Business account and a few days of approval.
# Include the `whatsapp:` prefix; the script adds it if you forget.
TWILIO_WHATSAPP_FROM=
# Who gets the sprint report. E.164, comma separated for more than one.
REPORT_WHATSAPP_TO=

# --- Error reporting ------------------------------------------------------
# Leave empty for a no-op error hook; set a DSN to enable Sentry.
SENTRY_DSN=

# --- The payment gateway, 2C2P (S2-10a) -----------------------------------
# QR on the customer display at the till, and the booking site's checkout
# later. docs/architecture/PAYMENT_GATEWAY.md is the authority for every name
# below; the 2C2P_* spellings earlier drafts used are gone, because a variable
# starting with a digit is not shell-safe.
#
# API SERVER ONLY. Not one of these reaches a Pi box or a browser. The customer
# display renders the QR from a payload stored on the payment attempt, so it
# needs no outbound internet and never holds a key.
#
# LEAVE THE WHOLE BLOCK EMPTY AND EVERYTHING WORKS. With no merchant id or
# secret key the api runs its own gateway simulator: a QR that scans, an
# expiry, a real-looking reference, and a Console panel that can mark it paid,
# expire it, decline it, pay it late, or suppress the callback so the inquiry
# poller has to find the money on its own. It says so at boot and on the
# Console's Integrations page. That is how CI, a demo and a fresh checkout
# never need a sandbox account.
#
# ON A PRODUCTION DEPLOYMENT IT IS NOT OPTIONAL: DEPLOY_ENV=production with
# either of the two credentials unset REFUSES TO START. A live park showing a
# guest a code that cannot be paid, and then closing the sale on somebody
# pressing a button, is the worst failure this platform has.

# `2c2p` or `simulator` — which implementation is live.
PGW_PROVIDER=simulator
# `sandbox` or `production`. Chooses the hosts and marks every record.
PGW_ENV=sandbox
# The Payment API host. Empty uses the one PGW_ENV names
# (sandbox-pgw.2c2p.com / pgw.2c2p.com).
PGW_BASE_URL=
# The merchant id sent in every payload, and checked on every notification.
PGW_MERCHANT_ID=
# The Secret Key. It signs everything we send and verifies everything 2C2P
# sends back, so it is the ONLY thing that makes a payment notification proof
# of anything. Never logged, never shown on a page, not even masked.
PGW_SECRET_KEY=
# ISO 4217 ALPHABETIC. `THB` — not the numeric 764, which is the legacy 3.x
# spelling and is refused.
PGW_CURRENCY_CODE=THB
# The public HTTPS URL 2C2P posts payment notifications to. This api's own:
#   https://api.<domain>/webhooks/2c2p/payment
# Add ?t=<PGW_WEBHOOK_SECRET> to it when that is set.
PGW_BACKEND_RETURN_URL=
# Where a browser comes back to after the booking site's hosted page (S2-12).
PGW_FRONTEND_RETURN_URL=
# A random token on the webhook URL. A CHEAP FILTER FOR INTERNET NOISE, and
# NOT AUTHENTICATION — the JWT signature is what authenticates. Still a secret:
# a filter everybody knows is not a filter.
PGW_WEBHOOK_SECRET=
# The Do Payment channel. `PPQR` is PromptPay QR. `THQR` looks right and is
# wrong: it is a category code in the Payment Option response, not a channel.
PGW_QR_CHANNEL_CODE=PPQR
# `RAW`, so the EMVCo payload comes back and the display draws the QR itself.
# `URL` would make every sale depend on an image host being reachable.
PGW_QR_TYPE=RAW
# Minutes a QR is valid. 2C2P's own default is twenty.
PGW_PAYMENT_EXPIRY_MIN=20
# Up to five letters or digits in front of every invoice number, so sandbox
# invoices can never collide with production ones. Empty in production.
PGW_INVOICE_PREFIX=
# TWO DIALS THAT ARE NOT THE SAME THING:
#   PGW_INQUIRY_INTERVAL_S  how often a QR still on a display is asked about.
#                           It is also the poller job's tick, so raising it on
#                           a deployment costs a few seconds on the one case
#                           where the webhook failed and saves an operational
#                           record row every three seconds.
#   PGW_INQUIRY_MAX_MIN     when asking stops.
#   PAYMENT_PENDING_MIN     OURS, not 2C2P's — when a tender nobody has
#                           answered goes on the Failures page. Much shorter
#                           than the polling window on purpose: ten minutes is
#                           a guest who has left the counter.
PGW_INQUIRY_INTERVAL_S=3
PGW_INQUIRY_MAX_MIN=30
PAYMENT_PENDING_MIN=10
# Void and refund live on the Payment ACTION api, which is A DIFFERENT HOST and
# a different crypto envelope: a JWE (RSA-OAEP + A256GCM) around a JWS (PS256),
# under an RSA key pair exchanged with 2C2P. PGW_SECRET_KEY is not used here
# and must not be put here. Empty means refunds through the gateway are not
# available yet; everything else still works.
PGW_MAINT_BASE_URL=
PGW_MAINT_PRIVATE_KEY=
PGW_MAINT_2C2P_PUBLIC_KEY=

# --- Suite launcher hand-off (S2-02) ------------------------------------
# One platform session opens several apps on different origins. A
# parent-domain cookie cannot do it: *.onrender.com is on the public suffix
# list, and it would not cover a separate booking domain anyway. So the
# launcher asks the api for a short-lived signed token aimed at ONE app
# origin, the browser carries it in the URL fragment (never the query string,
# which would reach logs and the Referer), and the app exchanges it for its
# own cookie bound to the same session row.
#
# A KEYRING, newest first: <kid>:<secret>[,<kid>:<secret>...]. The first signs;
# the rest still verify, so a key is rotated by prepending a new one and
# dropping the old once every issued token has expired - expand and contract,
# exactly like a migration. The kid is at most 16 characters of [A-Za-z0-9_-]
# and the secret at least 32.
HANDOFF_SIGNING_KEY=
# Which origin each app answers on: <app>=<origin>, comma separated. An app
# absent here cannot be handed off to at all.
HANDOFF_APP_ORIGINS=
# How long a token is worth carrying: the seconds a browser needs to follow a
# redirect, not minutes.
HANDOFF_TOKEN_TTL_S=60

# --- The signed staff token (S2-06) --------------------------------------
# What lets a till be unlocked when the mall's internet is out. The cloud signs
# a shift token when somebody picks a station; the box verifies it with the
# PUBLIC half, which is published to core.signing_key at boot and travels in
# every box's config bundle. The private half below never reaches the database,
# so a Raspberry Pi carried out of a storeroom can check tokens and can never
# mint one.
#
# Generate:  openssl genpkey -algorithm ed25519
# Paste the PEM as it is, with its newlines escaped as 
, or base64-encoded
# whole — all three are accepted, because those are the three shapes a
# deployment dashboard produces.
#
# EMPTY IS A WORKING CONFIGURATION with one consequence, and it is stated on
# the station pick's own response: the till works, and it cannot be unlocked
# without the internet. It is deliberately not generated at boot — a key that
# differed per instance and per restart would stop every outstanding token
# verifying on the next deploy, including on a till that has been offline since
# the morning.
STAFF_TOKEN_PRIVATE_KEY=
# How long a shift token lives. Default sixteen hours: an opening-to-closing
# shift plus the close-down, and dead before the next morning.
STAFF_TOKEN_TTL_S=57600
# Whether somebody this box minted a token for in the last thirty days may
# unlock offline with their password once their token has expired. Off: an
# expired token is refused with "shift token expired, connect to sign in".
# Turning it on keeps a till working through an outage longer than a shift, and
# makes a password the only thing between a stolen box and an unlocked till for
# a month. Either way the unlock is recorded as what it was — offline_token or
# offline_sign_in.
STAFF_OFFLINE_SIGN_IN=false

# Staff benefit QRs (S2-21 round 2). The Ed25519 private key that signs them —
# the shift token's scheme under its own key and its own core.signing_key
# purpose (benefit_qr). Its public half is published at boot and travels to
# every box in the benefits cache scope, so a box checks a benefit QR with no
# internet and can never mint one. Same three accepted shapes as above.
#
# Generate:  openssl genpkey -algorithm ed25519
#
# EMPTY: Admin > Staff Benefits cannot issue or show a QR (503, naming this
# variable); every QR already printed still verifies. Not generated at boot —
# a key that changed on a deploy would stop every QR in the park verifying.
#
# The demo seed (`pnpm db:seed`, round 4) reads it too: set, the four demo
# employees are issued their QRs under it (once — a re-seed issues none to a
# person who has held one); empty, the seed issues none and says so.
BENEFIT_QR_PRIVATE_KEY=

# --- Suite app origins, read at BUILD time by the launcher ---------------
# Vite inlines these, so changing one is a rebuild, not a restart. An unset or
# unparseable value leaves that tile as coming soon rather than putting a dead
# address on the front door.
# Signs every wristband code (S2-11). One shared key across the operator's boxes
# (the owner's decision). Unset locally, a fixed development key is used; staging
# needs a real value or no bands are minted; production refuses to boot without one.
BAND_HMAC_KEY=

# --- The OTO App's directory API (S2-20 E2) -------------------------------
# Where a walk-up or an event pass sold at the till is written back to the OTO
# App, which owns every event registration. The URL is the app's origin; the
# key is the tenant-bound directory key the app issued to this api
# (`npm run directory:client` in apps/oto-app) — a secret. Unset, nothing is
# written back: the sale stands and the child waits as pending on the roster
# and on the Failures page until a retry finds the app configured.
OTOAPP_DIRECTORY_URL=
OTOAPP_DIRECTORY_KEY=
# One directory call's time limit before it counts as no answer.
OTOAPP_DIRECTORY_TIMEOUT_MS=8000
# The OTO App's own switch, set on that app's service, not here (documented
# in apps/oto-app/.env.example): who runs its night jobs, `inprocess` (its own
# timers, the default) or `platform` (this platform's job runner, S2-17b
# round 3). Listed so the suite's variables are in one place.
# OTOAPP_JOBS=inprocess

VITE_POS_URL=http://localhost:25741
VITE_CONSOLE_URL=
VITE_OTO_APP_URL=
VITE_RADAR_URL=
VITE_BOOTH_URL=
VITE_INBOX_URL=
# Shown on the POS lock screen as a way back. Unset, the link is absent.
VITE_LAUNCHER_URL=

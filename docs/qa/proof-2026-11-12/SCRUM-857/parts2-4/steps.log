const { expect } = S;
S.phase = 'clean up: sales (print jobs), members on the numbers, the till retired, sessions signed out';
const res = {};
const sales = await S.stationSales();
for (const s of sales) S.assert.equal(s.stationId, S.station.id);
res.open = [];
for (const s of sales.filter(x => ['tendering', 'open'].includes(x.status))) {
  const v = await S.call('POST', `/sales/${s.id}/void`, { reason: 'ZZ TEST SCRUM-857 parts 2-4 proof cleanup' });
  res.open.push({ id: s.id, void: v.status });
}
res.prints = [];
for (const s of sales.filter(x => x.status === 'finalised')) {
  let jobs = [];
  await expect.poll(async () => { jobs = (await S.sale(s.id)).printJobs ?? []; return jobs.every(j => j.status === 'printed'); }, { timeout: 90000 }).toBe(true).catch(() => null);
  res.prints.push({ id: s.id, receipt: s.receiptNumber, gross: s.totals?.grossSatang, jobs: jobs.map(j => j.status) });
}
res.salesFinal = (await S.stationSales()).map(s => ({ id: s.id, status: s.status, receipt: s.receiptNumber, gross: s.totals?.grossSatang }));
res.members = [];
for (const n of S.free.slice(0, 10)) {
  const m = (await S.call('GET', `/members/lookup?phone=${n}`)).body?.member ?? null;
  if (m) {
    const label = `${m.nickname ?? ''} ${m.name ?? ''}`;
    S.assert.ok(/ZZ TEST/.test(label), 'only own named test members: ' + n);
    const del = await S.call('DELETE', `/members/${m.id}`);
    const again = (await S.call('GET', `/members/lookup?phone=${n}`)).body?.member ?? null;
    res.members.push({ n, id: m.id, archived: del.status, after: again === null });
  } else res.members.push({ n, member: null });
}
S.receipt.cleanup.sales = res; S.save();
return res;

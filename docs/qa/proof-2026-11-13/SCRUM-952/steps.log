S.phase = '5: list every device at a 192.168.88.x address, every box of every branch (read only)';
const r = { at: new Date().toISOString(), found: [], boxesRead: 0 };
const branches = (await S.call('GET', '/branches')).body.branches;
for (const b of branches) {
  const boxes = (await S.call('GET', `/branches/${b.id}/boxes`)).body?.boxes ?? [];
  const stations = (await S.call('GET', `/branches/${b.id}/stations?includeArchived=true`)).body?.stations ?? [];
  for (const bx of boxes) {
    r.boxesRead += 1;
    const devs = (await S.call('GET', `/boxes/${bx.id}/devices?includeArchived=true`)).body?.devices ?? [];
    for (const d of devs) {
      if (!String(d.address ?? '').startsWith('192.168.88.')) continue;
      const roles = stations.flatMap(s => (s.devices ?? []).filter(x => x.deviceId === d.id).map(x => `${s.name}${s.archived ? ' (retired)' : ''}: ${x.role}`));
      r.found.push({ branch: b.name, branchId: b.id, box: bx.name, boxId: bx.id, boxRole: bx.role, boxStatus: bx.status, id: d.id, label: d.label, kind: d.kind, transport: d.transport, address: d.address,
        model: d.model ?? null, protocol: d.protocol ?? null, settings: d.settings ?? null, archived: Boolean(d.archived), reachability: d.reachability, paperStatus: d.paperStatus, lastError: d.lastError ?? null, roles });
    }
  }
}
r.found.forEach(f => { f.virtualBox = f.boxRole === 'virtual'; f.simulated = f.transport === 'simulated'; f.eligible = f.virtualBox && f.simulated && !f.archived; });
S.p5 = r;
S.receipt.reads.p5list = r;
const lines = r.found.map(f => `${f.eligible ? 'ELIGIBLE ' : 'LEAVE    '} ${f.branch} / ${f.box} (${f.boxRole}, ${f.boxStatus})  "${f.label}"  ${f.kind}  ${f.transport}  ${f.address}  model=${f.model}  protocol=${f.protocol}  settings=${JSON.stringify(f.settings)}  archived=${f.archived}  reading=${f.reachability}/${f.paperStatus}/${f.lastError}  roles=[${f.roles.join('; ')}]`);
await S.txtShot(`Every device whose address starts 192.168.88., on every box of every branch (${r.boxesRead} boxes read; ${r.at})\n\n` + lines.join('\n'), '05a-api-devices-at-park-network-addresses.png', 'Point 5: devices at 192.168.88.x addresses, before');
return { boxesRead: r.boxesRead, found: r.found.map(f => ({ branch: f.branch, box: f.box, boxRole: f.boxRole, label: f.label, kind: f.kind, transport: f.transport, address: f.address, settings: f.settings, archived: f.archived, eligible: f.eligible, roles: f.roles })) };

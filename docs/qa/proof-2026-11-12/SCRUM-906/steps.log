S.assert.equal(snap.status, 201, 'package applied');
r.package = { status: snap.status, name: snap.body?.packageName ?? null, slipsTimeAtApply: snap.body?.slipsTime ?? null, setMenuTemplateId: snap.body?.setMenuTemplateId ?? null };

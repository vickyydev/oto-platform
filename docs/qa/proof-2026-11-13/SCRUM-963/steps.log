=== 2026-11-13T00:04:39.997Z hunt: the returning family's review, a language chosen while the connection is cut (lock, Retry, free on reconnect: timed); a dim red link in dark
S.phase = 'hunt: the returning family\'s review, a language chosen while the connection is cut (lock, Retry, free on reconnect: timed); a dim red link in dark';
const d = S.d, ctx = S.displays.main.ctx;
const out = {};
const st = () => d.evaluate(() => {
  const alert = document.querySelector('[role="alert"]');
  const h2 = [...document.querySelectorAll('h2')].find(h => h.getBoundingClientRect().width > 0);
  return { h2: h2?.textContent.trim() ?? null, h2Top: h2 ? Math.round(h2.getBoundingClientRect().top) : null, alert: alert ? alert.innerText.replace(/\s+/g, ' ').trim() : null,
    status: [...document.querySelectorAll('[role="status"]')].map(s => s.innerText.replace(/\s+/g, ' ').trim()).filter(Boolean), inert: !!document.querySelector('[inert]'), paused: /Connection paused|การเชื่อมต่อหยุดชั่วคราว/.test(document.body.innerText) };
});
const link = d.getByText('Ask the team to remove a child', { exact: true }).locator('xpath=ancestor-or-self::button[1]').first();
out.removeLinkDark = { css: await S.ink(link), drawn: await S.pixelInk(d, link) };
out.before = await st();
await ctx.setOffline(true);
const off = Date.now();
for (let i = 0; i < 20; i++) { await d.waitForTimeout(250); const s = await st(); if (s.status.length) break; }
out.lineMs = Date.now() - off;
await S.chooseLang(d, 'ไทย');
out.justAfter = { ms: Date.now() - off, ...(await st()) };
await S.shot(d, '93a-hunt-600-review-thai-chosen-offline.png');
await d.waitForTimeout(Math.max(0, 7000 - (Date.now() - off)));
out.offlineMs = Date.now() - off;
await ctx.setOffline(false);
const on = Date.now();
const frames = [];
for (let i = 0; i < 40; i++) { await d.waitForTimeout(500); const s = await st(); frames.push({ ms: Date.now() - on, alert: s.alert, inert: s.inert, status: s.status.join(' | ') }); if (!s.alert && !s.inert && !s.status.length) break; }
out.freeAfterMs = frames.at(-1).ms;
out.frames = frames.filter((f, i, a) => i === 0 || i === a.length - 1 || JSON.stringify({ ...f, ms: 0 }) !== JSON.stringify({ ...a[i - 1], ms: 0 }));
out.after = await st();
await S.shot(d, '93b-hunt-600-review-after-reconnect.png');
await S.chooseLang(d, 'English'); await d.waitForTimeout(1200);
out.english = await st();
S.receipt.hunt.push({ what: 'returning review: a language chosen offline', ...out }); S.save();
return out;

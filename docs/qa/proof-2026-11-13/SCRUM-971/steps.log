  await expect(form).toBeVisible();
  await form.getByLabel(/^What it is/).selectOption(kind);
  await form.getByLabel(/^Label/).fill(label);
  await form.getByLabel(/^How the box reaches it/).selectOption('simulated');
  await form.getByLabel(/^Address/).fill(address);
  await form.getByLabel(/^Protocol/).fill(protocol);
  await c.waitForTimeout(300);
  const shown = {};
  if (kind === 'receipt_printer') shown.paperWidth = await form.getByLabel(/^Paper width/).locator('option:checked').innerText();
  if (kind === 'band_printer') shown.sensing = await form.getByLabel(/^Sensing/).locator('option:checked').innerText();
  await form.scrollIntoViewIfNeeded();
  await S.shot(c, pic);
  let made = null;
  const sent = await S.capture(c, 'POST', new RegExp(`^/api/boxes/${S.box.id}/devices$`), async () => {
    const resp = c.waitForResponse(x => x.request().method() === 'POST' && new URL(x.url()).pathname === `/api/boxes/${S.box.id}/devices`, { timeout: 20000 });
    await form.getByRole('button', { name: 'Add it', exact: true }).click();
    const res = await resp; made = { status: res.status(), body: await res.json().catch(() => null) };
  }, 1500);
  const id = made?.body?.device?.id;
  if (id) { S.extraDev = { ...(S.extraDev ?? {}), [label]: id }; S.receipt.created.push({ kind: 'device', key: 'form', id, label }); S.save(); }
  const row = id ? (await S.devicesOnBox()).find(x => x.id === id) : null;
  return { shownInForm: shown, sent: sent.map(s => JSON.parse(s.body ?? '{}')), status: made?.status, error: made?.body?.error?.code ?? null, readBack: row ? { label: row.label, kind: row.kind, address: row.address, protocol: row.protocol, settings: row.settings ?? null } : null };
};

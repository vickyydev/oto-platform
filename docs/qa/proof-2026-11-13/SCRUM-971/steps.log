=== 2026-11-13T02:48:25.420Z hunt: the ZZ TEST Thai till changed into a Customer display in the Console; does its prefix stay, can a new ZZ TEST till take it?
S.phase = 'hunt: the ZZ TEST Thai till changed into a Customer display in the Console; does its prefix stay, can a new ZZ TEST till take it?';
const { expect } = S;
const r = {};
const c = S.pages.console.page;
await c.goto(S.CONSOLE + '/overview');
await S.goStations(c);
await c.getByRole('button', { name: S.tillB.name, exact: true }).click();
const d = S.drawerOf(c);
await expect(d).toBeVisible();
await c.waitForTimeout(1500);
r.before = { prefixField: await d.getByLabel(/^Code prefix/).inputValue().catch(() => null), version: S.flat(await d.innerText()).match(/config v(\d+)/)?.[1] ?? null };
await d.getByLabel(/^Kind/).selectOption('display');
await c.waitForTimeout(500);
r.afterKindChange = { prefixFields: await d.getByLabel(/^Code prefix/).count(), devicesText: S.flat(await d.getByText(/A customer display drives nothing/).first().innerText().catch(() => '')) };
await d.getByLabel(/^Kind/).scrollIntoViewIfNeeded();
await S.shot(c, 'h2a-console-thai-till-kind-changed-to-customer-display.png');
let saved = null;
const sent = await S.capture(c, 'PATCH', new RegExp(`^/api/stations/${S.tillB.id}$`), async () => {
  const resp = c.waitForResponse(x => x.request().method() === 'PATCH' && new URL(x.url()).pathname === `/api/stations/${S.tillB.id}`, { timeout: 20000 });
  await d.getByRole('button', { name: 'Save the station', exact: true }).click();
  const res = await resp; saved = { status: res.status(), body: await res.json().catch(() => null) };
}, 1500);
r.save = { sent: sent.map(s => JSON.parse(s.body ?? '{}')), status: saved?.status, error: saved?.body?.error ? { code: saved.body.error.code, message: saved.body.error.message } : null, station: saved?.body?.station ? { kind: saved.body.station.kind, codePrefix: saved.body.station.codePrefix ?? null, devices: (saved.body.station.devices ?? []).length, configVersion: saved.body.station.configVersion } : null };
r.drawerOpen = await S.drawerOf(c).count();
r.alert = r.drawerOpen ? S.flat(await S.drawerOf(c).getByRole('alert').innerText().catch(() => '')) : null;
await S.shot(c, 'h2b-console-thai-till-saved-as-customer-display.png');
const row = await S.stationRow(S.tillB.id);
r.readBack = { name: row.name, kind: row.kind, codePrefix: row.codePrefix ?? null, devices: (row.devices ?? []).map(x => x.role), configVersion: row.configVersion };
// can a new ZZ TEST till take that prefix?
if (row.codePrefix) {
  const tryC = await S.call('POST', `/branches/${S.branchId}/stations`, { name: 'ZZ TEST 971 till C', kind: 'till', boxId: S.box.id, codePrefix: row.codePrefix, accessScope: 'all_staff', paymentRouting: { card: 'manual', qr: 'none' }, capabilities: [], devices: [] });
  r.newTillSamePrefix = { status: tryC.status, code: tryC.body?.error?.code ?? null, message: tryC.body?.error?.message ?? null, id: tryC.body?.station?.id ?? null };
  if (tryC.status === 200) { S.tillC = { id: tryC.body.station.id, name: 'ZZ TEST 971 till C' }; S.receipt.created.push({ kind: 'station', id: S.tillC.id, name: 'ZZ TEST 971 till C', prefix: row.codePrefix }); S.save(); }
}
// the station card in the list
await c.keyboard.press('Escape').catch(() => {});
await c.reload();
await S.goStations(c);
await c.waitForTimeout(1200);
r.cards = (await c.locator('button, a, div').filter({ hasText: /^ZZ TEST 971/ }).count());
await S.shot(c, 'h2c-console-stations-list-after-kind-change.png');
await S.txtShot([`Hunt: the ZZ TEST till "${S.tillB.name}" (prefix ${S.tillB.prefix}) changed into a Customer display in the Console (${new Date().toISOString()})`, '',
  `Before: Code prefix field "${r.before.prefixField}", config v${r.before.version}`,
  `Kind -> Customer display: Code prefix fields on the form ${r.afterKindChange.prefixFields}`,
  `Save the station: PATCH /api/stations/<id> -> ${r.save.status}${r.save.error ? ' ' + JSON.stringify(r.save.error) : ''}`,
  `  body sent: ${JSON.stringify(r.save.sent[0] ?? null)}`,
  `  answer: ${JSON.stringify(r.save.station)}`,
  `Read back: ${JSON.stringify(r.readBack)}`, '',
  r.newTillSamePrefix ? `A new ZZ TEST till "ZZ TEST 971 till C" with prefix ${row.codePrefix}: POST /api/branches/<id>/stations -> ${r.newTillSamePrefix.status} ${r.newTillSamePrefix.code ?? ''} ${r.newTillSamePrefix.message ?? ''}` : 'The display kept no prefix, so nothing to take.'].join('\n'), 'h2d-till-to-display-prefix-kept.png', 'Hunt: a till changed into a Customer display, and its code prefix');
S.receipt.reads.huntTillToDisplay = r;
return r;

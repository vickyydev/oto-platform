const { expect } = S;
S.phase = 'hunt: the display first screen, a language chosen while the connection is cut (lock, Retry, free on reconnect: timed)';
const d = S.d, ctx = S.displays.main.ctx;
S.firstState = () => d.evaluate(() => {
  const alert = document.querySelector('[role="alert"]');
  const id = document.querySelector('[data-testid="identify-safety"]');
  return { h2: document.querySelector('h2')?.textContent.trim() ?? null, alert: alert ? alert.innerText.replace(/\s+/g, ' ').trim() : null,
    status: [...document.querySelectorAll('[role="status"]')].map(s => s.innerText.replace(/\s+/g, ' ').trim()).filter(Boolean),
    inert: !!id?.closest('[inert]') || !!document.querySelector('[inert]'), paused: /Connection paused|การเชื่อมต่อหยุดชั่วคราว/.test(document.body.innerText),
    lang: [...document.querySelectorAll('button')].find(b => b.getAttribute('aria-label') && /language|ภาษา/i.test(b.getAttribute('aria-label')))?.textContent.trim() ?? null };
});
const out = { before: await S.firstState() };
await ctx.setOffline(true);
const off = Date.now();
let lineAt = null;
for (let i = 0; i < 20; i++) { await d.waitForTimeout(250); const s = await S.firstState(); if (s.status.length) { lineAt = Date.now() - off; out.lineSeen = s; break; } }
out.lineAfterMs = lineAt;
await S.chooseLang(d, 'ไทย');
out.chosenAtMs = Date.now() - off;
out.justAfter = await S.firstState();
await S.shot(d, '90a-hunt-600-first-screen-thai-chosen-offline.png');
// can the keypad take a press while it waits?
out.keypadPress = await d.getByRole('button', { name: '1', exact: true }).last().tap({ timeout: 2500 }).then(() => 'pressed').catch(e => 'refused: ' + String(e.message).split('\n')[0].slice(0, 80));
await d.waitForTimeout(Math.max(0, 7000 - (Date.now() - off)));
out.offlineMs = Date.now() - off;
out.beforeRestore = await S.firstState();
await ctx.setOffline(false);
const on = Date.now();
const frames = [];
for (let i = 0; i < 40; i++) { await d.waitForTimeout(500); const s = await S.firstState(); frames.push({ ms: Date.now() - on, alert: s.alert, status: s.status.join(' | '), inert: s.inert, paused: s.paused }); if (!s.alert && !s.inert && !s.status.length) break; }
out.freeAfterMs = frames.at(-1).ms;
out.frames = frames.filter((f, i, a) => i === 0 || i === a.length - 1 || JSON.stringify({ ...f, ms: 0 }) !== JSON.stringify({ ...a[i - 1], ms: 0 }));
out.after = await S.firstState();
await S.shot(d, '90b-hunt-600-first-screen-after-reconnect.png');
// clear any digit the press put in, back to English
out.numberBoxAfter = await d.evaluate(() => [...document.querySelectorAll('div')].find(x => /h-16 flex-1 rounded-2xl/.test(x.className))?.innerText.trim() ?? null);
if (out.numberBoxAfter && /\d{1,}$/.test(out.numberBoxAfter) && !/X/.test(out.numberBoxAfter)) { const clr = d.getByRole('button', { name: /^(Clear|ล้าง)$/ }).last(); await clr.tap().catch(() => {}); }
await S.chooseLang(d, 'English');
await d.waitForTimeout(1500);
out.english = await S.firstState();
S.receipt.hunt.push({ what: 'first screen: a language chosen offline', ...out }); S.save();
return out;

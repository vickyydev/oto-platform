  const menu = b.locator('xpath=..').locator(':scope > div');
  const pick = name => menu.getByRole('button', { name, exact: true });
  return { chosen: await S.ink(pick('English')), other: await S.ink(pick('中文')), thai: await S.ink(pick('ไทย')), french: await S.ink(pick('Français')) };
};
out.themeAtStart = await S.themeOf(d);
if (out.themeAtStart !== 'dark') { await S.toggleDisplayTheme(); out.themeAtStart2 = await S.themeOf(d); }
await S.openLang(d);
out.dark = { list: await S.langList(d), ink: await listInk() };
await S.shot(d, '02a-600-dark-display-language-list-slate.png');
await S.shot(d, '02a2-600-dark-display-language-list-close-up.png', [], { clip: { x: 300, y: 0, width: 300, height: 360 } });
await S.openLang(d); // closes it
out.toggle = await S.toggleDisplayTheme();
out.themeLight = await S.themeOf(d);
await S.openLang(d);
out.light = { list: await S.langList(d), ink: await listInk() };
await S.shot(d, '02b-600-light-display-language-list-cream-dark-words-chosen-marked.png');
await S.shot(d, '02b2-600-light-display-language-list-close-up.png', [], { clip: { x: 300, y: 0, width: 300, height: 360 } });
await S.openLang(d);
// the rest of the form on a light display, for the record
await S.shot(d, '02c-600-light-display-form-care-details.png');
await S.toggleDisplayTheme();
out.themeBack = await S.themeOf(d);
await S.openLang(d);
out.darkAgain = { list: await S.langList(d), ink: await listInk() };
await S.shot(d, '02d-600-dark-again-language-list-slate-as-before.png', [], { clip: { x: 300, y: 0, width: 300, height: 360 } });
await S.openLang(d);
S.receipt.reads.p2list = out; S.save();
return out;

  await S.both('01m-B-simulator-qr-on-display-masked.png', 'point 1 — B pressed Show payment QR (socks off again): the QR waits on the display (QR masked)', till, d);
} else {
  r.qr = { attemptCreate: null, requests: [...reqs], toasts: await toasts(), step: S.flat(await S.paymentStep(till).innerText().catch(() => '')).slice(0, 300) };
  await S.both('01m-B-show-qr-refused-again.png', 'point 1 — Show payment QR after the socks came off', till, d);
}
till.off('request', onReq);

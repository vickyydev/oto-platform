S.phase = 'sign in desk till 1440x900';
const till = await S.signIn('till', 'STAGING_RECEPTION_PHONE', 'STAGING_RECEPTION_PASSWORD', { width: 1440, height: 900 });
S.till = till;
const bundle = await till.evaluate(async () => {
  const urls = [...new Set(performance.getEntriesByType('resource').map(e => e.name).filter(n => /\.js(\?|$)/.test(n)))];
  const found = { files: urls.length, maxXl: 0, stickyFoot: 0, addonsContainer: 0, satangText: 0 };
  for (const url of urls) { const t = await (await fetch(url, { cache: 'no-store' })).text();
    found.maxXl += t.split('md:@max-xl:sticky').length - 1; found.stickyFoot += t.split('stickyFoot').length - 1; found.addonsContainer += t.split('@container/addons').length - 1; found.satangText += t.split('min-h-11 py-2').length - 1; }
  return found;
});
S.receipt.reads.bundle = bundle;
await S.landing(till).waitFor();
const split = await S.toggleDisplay(till, true);
await S.shot(till, '00-1440-split-signed-in-landing.png');
return { bundle, split, fit: await S.fit(till) };

await expect(S.paymentStep(till)).toBeVisible({ timeout: 30000 });
await till.waitForTimeout(1500);
const due = await S.amountDue(till);
await S.payCash(till);
const leave = till.getByRole('button', { name: 'Leave as booked', exact: true });

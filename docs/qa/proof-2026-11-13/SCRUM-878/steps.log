S.phase = 'clean up: sessions signed out; every own finalised sale refunded whole by the staging manager; own numbers read; the till retired; the display read back; A and B deactivated and read back';
const out = { signOuts: {}, refunds: [], members: [], board: null };
for (const label of Object.keys(S.pages)) out.signOuts[label] = await S.signOut(label);
const mgr = await S.pw.request.newContext({ baseURL: S.pos });
const ms = await mgr.post('/api/auth/sign-in', { data: { phone: S.need('STAGING_MANAGER_PHONE'), password: S.need('STAGING_MANAGER_PASSWORD') } });
out.managerSignIn = ms.status();
for (const s of await S.stationSales()) {
  S.assert.equal(s.stationId, S.station.id);
  S.assert.ok(S.knownSales.has(s.id), 'own sale only');
  if (s.status !== 'finalised') { out.refunds.push({ receipt: s.receiptNumber, status: s.status, skipped: true }); continue; }
  const res = await mgr.fetch(`/api/sales/${s.id}/refunds`, { method: 'POST', headers: { 'content-type': 'application/json', 'idempotency-key': S.randomUUID() }, data: { mode: 'whole', reason: 'ZZ TEST SCRUM-878 proof clean-up' } });
  const b = await res.json().catch(() => null);
  const after = await S.sale(s.id);
  out.refunds.push({ receipt: s.receiptNumber, gross: s.totals?.grossSatang / 100, soldBy: s.soldBy?.name, status: res.status(), errorCode: b?.error?.code ?? null, errorMessage: b?.error?.message ?? null, refund: (b?.refund?.amountSatang ?? 0) / 100, saleStatus: after.sale?.status, refundStatus: after.refundStatus ?? null, refundable: after.refundableSatang ?? null });
}
const mso = await mgr.post('/api/auth/sign-out', { headers: { 'idempotency-key': S.randomUUID() } });
out.managerSignOut = mso.status();
await mgr.dispose();
for (const n of S.receipt.numbers.used ?? []) { const m = (await S.call('GET', `/members/lookup?phone=${n}`)).body?.member ?? null; out.members.push({ n, member: m ? { id: m.id, name: m.name } : null }); }
const board = (await S.call('GET', `/checkin/board?branchId=${S.branchId}`)).body;
const used = new Set((S.receipt.numbers.used ?? []).map(n => '+66' + n.slice(1)));
out.board = board.families.filter(f => used.has(f.guardianPhone)).map(f => ({ guardian: f.guardianName, children: f.children.map(c => c.status) }));
S.receipt.cleanup.refunds = out.refunds; S.receipt.cleanup.members = out.members; S.receipt.cleanup.boardOwnNumbers = out.board; S.save();
return out;

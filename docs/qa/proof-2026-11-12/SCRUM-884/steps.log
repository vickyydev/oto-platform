S.phase = 'clean up: read the sessions left by the crashed first driver (read only)';
// the admin api signs in again for this read and out after
const out = {};
for (const [label, key] of [['reception', 'STAGING_RECEPTION_PHONE'], ['manager', 'STAGING_MANAGER_PHONE']]) {
  const phone = S.need(key);
  const list = (await S.call('GET', `/accounts?q=${encodeURIComponent(phone.replace(/^\+66/, '0'))}`)).body?.accounts ?? [];
  const acct = list.find(a => (a.phone ?? '').replace(/\s/g, '').endsWith(phone.replace(/^\+66|^0/, '').slice(-8)));
  if (!acct) { out[label] = { found: false, n: list.length }; continue; }
  const page = (await S.call('GET', `/accounts/${acct.id}/sessions?limit=50`)).body;
  const mine = (page?.sessions ?? []).filter(s => s.stationId === S.station.id);
  out[label] = { total: page?.total ?? null, onOwnTill: mine.map(s => ({ status: s.status, endedAt: s.endedAt ?? null, keys: Object.keys(s).filter(k => !/name|phone|ip|agent/i.test(k)) })) };
}
await S.admin.post('/api/auth/sign-out', { headers: { 'idempotency-key': S.randomUUID() } });
out.adminMe = (await S.admin.get('/api/me')).status();
return out;

S.phase = 'clean up: End of Day check, members on the own numbers archived, sessions signed out, the two own tills retired, displays read back, the admin signed out';
const out = {};
const eod = await S.call('GET', `/branches/${S.branchId}/end-of-day?date=${S.today}`);
const rows = eod.body?.openSales?.rows ?? null;
out.endOfDay = { date: S.today, status: eod.status, openSalesOfOwnTills: rows ? rows.filter(x => /ZZ TEST SCRUM-963/.test(x.stationName ?? '')).length : 'no openSales field' };
const board = await S.boardApi();
out.boardOwn = board.families.filter(f => /^Zz Test Parent A$/i.test(f.guardianName ?? '')).map(f => ({ guardian: f.guardianName, children: f.children.map(c => c.status) }));
out.members = [];
for (const phone of S.free.slice(0, 3)) {
  const m = (await S.call('GET', `/members/lookup?phone=${encodeURIComponent(phone)}`)).body?.member ?? null;
  if (!m) { out.members.push({ phone: phone.slice(-2), member: null }); continue; }
  const named = `${m.nickname ?? ''} ${m.name ?? ''}`;
  if (/zz test/i.test(named)) { const d = await S.call('DELETE', `/members/${m.id}`); const after = (await S.call('GET', `/members/lookup?phone=${encodeURIComponent(phone)}`)).body?.member ?? null; out.members.push({ phone: phone.slice(-2), archived: d.status, lookupAfter: after ? 'still found' : 'gone' }); }
  else out.members.push({ phone: phone.slice(-2), member: 'found, not ZZ TEST named: left alone' });
}
out.signOuts = {};
for (const label of Object.keys(S.pages)) out.signOuts[label] = await S.signOut(label);
S.till = null; S.mgr = null; S.phone = null;
out.displays = {};
out.stations = {};
for (const st of [S.station, S.phoneStation]) {
  const cur = (await S.call('GET', `/stations/${st.id}`)).body?.station;
  S.assert.equal(cur?.name, st.name);
  const disp = (await S.call('GET', `/stations/${st.id}/displays`)).body;
  out.displays[st.codePrefix] = (disp?.displays ?? disp?.devices ?? []).map(x => ({ name: x.name, status: x.status ?? (x.revokedAt ? 'revoked' : 'active'), revoked: Boolean(x.revokedAt ?? x.revoked) }));
  const devicesCleared = (await S.call('PATCH', `/stations/${st.id}`, { devices: [] })).status;
  const retired = (await S.call('DELETE', `/stations/${st.id}`)).status;
  const after = (await S.call('GET', `/branches/${S.branchId}/stations?includeArchived=true`)).body.stations.find(s => s.id === st.id);
  out.stations[st.codePrefix] = { devicesCleared, retired, archived: Boolean(after?.archived), devices: after?.devices?.length ?? null };
}
const g = {};
for (const e of S.receipt.pageErrors) { const k = `${e.page} | ${e.kind} | ${e.text}`; g[k] = g[k] ?? { n: 0, at: [] }; g[k].n++; if (g[k].at.length < 2 && !g[k].at.includes(e.at)) g[k].at.push(e.at); }
S.receipt.pageErrorsGrouped = g;
Object.assign(S.receipt.cleanup, { endOfDay: out.endOfDay, boardOwn: out.boardOwn, members: out.members, signOutsFinal: out.signOuts, displaysReadBack: out.displays, stations: out.stations });
await S.admin.post('/api/auth/sign-out', { headers: { 'idempotency-key': S.randomUUID() } });
out.adminMe = (await S.admin.get('/api/me')).status();
S.receipt.cleanup.adminMe = out.adminMe;
S.receipt.finishedAt = new Date().toISOString();
S.save();
return { ...out, errors: g };

=== 2026-11-13T02:52:17.938Z clean up: the child released, the manager refunds the ZZ drop-off sale, the member archived
S.phase = 'clean up: the child released, the manager refunds the ZZ drop-off sale, the member archived';
const out = {};
out.release = await S.releaseOwn(S.reg, S.GD);
out.regAfter = (await S.registration(S.reg)).children.map(c => `${c.childName}: ${c.status}`);
const eod = await S.call('GET', `/branches/${S.branchId}/end-of-day?date=${S.today}`);
out.eodAfterRelease = { status: eod.status, oursStillInside: (eod.body?.stranded ?? []).filter(x => x.childName === S.CD).length };
const mgr = await S.pw.request.newContext({ baseURL: S.pos });
const si = await mgr.post('/api/auth/sign-in', { data: { phone: S.need('STAGING_MANAGER_PHONE'), password: S.need('STAGING_MANAGER_PASSWORD') } });
out.mgrSignIn = si.status();
out.refunds = [];
try {
  for (const s of (await S.stationSales(S.station.id))) {
    S.assert.equal(s.stationId ?? S.station.id, S.station.id);
    S.assert.ok(String(s.receiptNumber ?? '').startsWith('Z971') || ['tendering', 'open'].includes(s.status), 'own ZZ till series');
    if (s.status === 'finalised') {
      const res = await mgr.post(`/api/sales/${s.id}/refunds`, { headers: { 'idempotency-key': S.randomUUID() }, data: { mode: 'whole', reason: 'ZZ TEST SCRUM-971 proof cleanup' } });
      const b = await res.json().catch(() => null);
      out.refunds.push({ receipt: s.receiptNumber, status: res.status(), code: b?.error?.code ?? null, message: res.status() >= 400 ? (b?.error?.message ?? null) : null });
    } else if (['tendering', 'open'].includes(s.status)) {
      const v = await S.call('POST', `/sales/${s.id}/void`, { reason: 'ZZ TEST SCRUM-971 proof cleanup' });
      out.refunds.push({ receipt: s.receiptNumber, voided: v.status });
    }
  }
} finally {
  const so = await mgr.post('/api/auth/sign-out', { headers: { 'idempotency-key': S.randomUUID() } });
  out.mgrSignOut = { status: so.status(), me: (await mgr.get('/api/me')).status() };
  await mgr.dispose();
}
for (const st of [S.station, S.tillB, S.display].filter(Boolean)) out[`sales ${st.name}`] = (await S.stationSales(st.id)).map(s => ({ receipt: s.receiptNumber, status: s.status, gross: s.totals?.grossSatang / 100, refunded: (s.totals?.refundedSatang ?? 0) / 100 }));
out.members = [];
for (const [key, phone] of Object.entries(S.receipt.numbers)) {
  const m = (await S.call('GET', `/members/lookup?phone=${encodeURIComponent(phone)}`)).body?.member ?? null;
  if (m) {
    S.assert.ok(`${m.nickname ?? ''} ${m.name ?? ''}`.includes('ZZ TEST'), 'only own named test members');
    const d = await S.call('DELETE', `/members/${m.id}`);
    out.members.push({ key, archived: d.status, lookupAfter: (await S.call('GET', `/members/lookup?phone=${encodeURIComponent(phone)}`)).body?.member ? 'still found' : 'not found' });
  } else out.members.push({ key, member: 'none' });
}
S.receipt.cleanup.salesAndFamily = out;
return out;

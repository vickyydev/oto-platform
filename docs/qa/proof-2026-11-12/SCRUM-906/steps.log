await confirm.click();
await till.getByText(/Settled|Payment Successful/).first().waitFor({ timeout: 60000 });
await till.waitForTimeout(2500);
r.done = S.flat(await till.getByRole('dialog').last().innerText().catch(() => '')).slice(0, 300);

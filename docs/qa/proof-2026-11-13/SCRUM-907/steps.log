  await c.close().catch(() => {});
  S.app = null;
}
const so = await S.admin.post('/api/auth/sign-out', { headers: { 'idempotency-key': S.randomUUID() } });
out.platformAdmin = { signOut: so.status(), meAfter: (await S.admin.get('/api/me')).status() };

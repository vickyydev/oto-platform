const till = S.till;
await S.unlock('till');
const out = {};
const clipOf = async (re, name) => {
  const el = till.getByText(re).first();
  if (!(await el.count())) return null;
  // the nearest card around the figure
  const card = el.locator('xpath=ancestor::div[contains(@class,"rounded")][1]');
  const target = (await card.count()) ? card : el;
  await target.scrollIntoViewIfNeeded();
  const box = await target.boundingBox();
  const label = S.flat(await target.innerText()).slice(0, 200);
  await S.shot(till, name, [], { clip: { x: Math.max(0, box.x - 8), y: Math.max(0, box.y - 8), width: Math.min(1680, box.width + 16), height: Math.min(600, box.height + 16) } });
  return { label, names: S.needles().some(n => label.includes(n)) };
};
for (const name of ['Performance', 'End of Day']) {
  await till.getByRole('tab', { name, exact: true }).click().catch(() => {});
  await S.sleep(3000);
  out[name] = [];
  const t = S.flat(await till.locator('body').innerText());
  const hits = [...new Set(S.oneDecimal(t))];
  let i = 0;
  for (const h of hits) { i++; out[name].push({ figure: h, ...(await clipOf(new RegExp(h.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '(?![0-9])'), `08${name === 'Performance' ? 'a' : 'b'}${i}-one-decimal-${name.toLowerCase().replace(/ /g, '-')}.png`)) }); }
}
S.receipt.reads.sweepShots = out; S.save();
return out;

out.api = S.stayFacts(api);
out.apiCounts = await (async () => { const b = await S.boardApi(); const kids = b.families.flatMap(f => f.children); return { registered: kids.filter(c => c.status === 'registered').length, inPark: kids.filter(c => c.status === 'in_park').length }; })();
S.receipt.reads.p8desk = out; S.save();
return out;

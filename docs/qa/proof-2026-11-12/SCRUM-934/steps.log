await S.ticket(till, 2, 0);
const reg = await S.fillDropOff(till, ['ZZ TEST Mint 934', 'ZZ TEST Pang 934'], 'ZZ TEST 934 guardian A', '01a-family-a-dropoff-form-two-children.png', [6, 6]);

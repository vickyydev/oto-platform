S.phase='Exact final-source money cleanup: own simulator refunds and unresolved card void';const manager=await S.pw.request.newContext({baseURL:S.pos});S.assert.equal((await manager.post('/api/auth/sign-in',{data:{phone:S.need('STAGING_MANAGER_PHONE'),password:S.need('STAGING_MANAGER_PASSWORD')}})).status(),200);const rows=[];try{for(const st of S.finalStations){S.assert.ok(/^ZZ TEST SCRUM-982 final /.test(st.name));for(const row of await S.stationSales(st)){S.assert.ok(S.knownSales.has(row.id)&&S.receipt.created.some(x=>x.kind==='sale'&&x.id===row.id&&x.stationId===st.id),'exact own sale ledger');let d=await S.sale(row.id);S.assert.equal(d.sale.stationId,st.id);if(d.sale.status==='finalised'){S.assert.ok(d.sale.receiptNumber.startsWith(st.codePrefix+'-'));S.assert.notEqual(d.refundStatus,'refunded');const r=await manager.post(`/api/sales/${row.id}/refunds`,{headers:{'idempotency-key':S.randomUUID()},data:{mode:'whole',reason:'ZZ TEST SCRUM-982 final-source simulator proof cleanup'}});S.assert.equal(r.status(),200);d=await S.sale(row.id);S.assert.equal(d.refundStatus,'refunded');const refunded=d.refunds.reduce((sum,r)=>sum+r.amountSatang,0);S.assert.equal(refunded,d.sale.totals.grossSatang);rows.push({id:row.id,stationId:st.id,status:d.sale.status,refundStatus:d.refundStatus,refundedSatang:refunded});}else if(d.sale.status==='tendering'){S.assert.equal(row.id,S.cardSale);S.assert.equal(d.attempts.length,1);S.assert.equal(d.attempts[0].id,S.cardAttempt);S.assert.equal(d.attempts[0].status,'awaiting_staff_confirmation');const c=await S.call('POST',`/payments/attempts/${S.cardAttempt}/confirm`,{took:false,note:'ZZ TEST SCRUM-982 own simulated terminal deliberately returned no response; no real money taken'});S.assert.equal(c.status,200);S.assert.equal((await S.call('POST',`/sales/${row.id}/void`,{reason:'ZZ TEST SCRUM-982 unpaid simulated card proof cleanup'})).status,200);d=await S.sale(row.id);S.assert.equal(d.sale.status,'voided');S.assert.ok(d.attempts.every(a=>a.status!=='approved'));rows.push({id:row.id,stationId:st.id,status:d.sale.status,attempts:d.attempts.map(a=>({id:a.id,status:a.status,method:a.method}))});}else{S.assert.equal(d.sale.status,'voided');S.assert.equal(row.id,S.correctedOldSale);S.assert.equal(d.attempts.length,0);rows.push({id:row.id,stationId:st.id,status:'voided',attempts:0});}}}}finally{const out=await manager.post('/api/auth/sign-out');const me=await manager.get('/api/me');S.receipt.cleanup.finalManager={signOut:out.status(),meAfter:me.status()};S.assert.equal(me.status(),401);await manager.dispose();}S.assert.equal(rows.length,9);S.assert.equal(rows.filter(x=>x.refundStatus==='refunded').length,7);S.assert.equal(rows.reduce((sum,x)=>sum+(x.refundedSatang??0),0),492500);S.receipt.cleanup.finalMoney={at:new Date().toISOString(),rows,refundedSatang:492500,paidRows:7,voidedRows:2};S.save();return S.receipt.cleanup.finalMoney;

  try { await expect.poll(async () => /Scan to Pay/i.test(await d.locator('body').innerText()), { timeout: 30000, intervals: [200] }).toBe(true); shown = true; } catch {}
  r.qr = { attemptCreate: a.status(), msToDisplayQr: shown ? Date.now() - t1 : null, displayShowsQr: shown, attempt: { id: attempt?.id, status: attempt?.status, provider: attempt?.provider, amount: (attempt?.amountSatang ?? 0) / 100 } };
  S.p1attempt = attempt?.id ?? null;

await S.shot(page, '11b-1440x900-split-shop-customer-half-your-sale-and-language-button.png', [], { clip: { x: hb.x, y: hb.y, width: Math.min(hb.w, 1440 - hb.x), height: hb.h } }); r.pics.push('11b-1440x900-split-shop-customer-half-your-sale-and-language-button.png');

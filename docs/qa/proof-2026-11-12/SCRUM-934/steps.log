S.phase = '1/6: the board after the refund; cancel Pang alone (leaves the waiting list)';
const till = S.till;
await S.unlock('till');
await S.boardApi();
await S.openBoard(till);
await S.searchBoard(till, 'ZZ TEST 934 guardian A');
const card = S.deskCards(till).filter({ hasText: 'ZZ TEST 934 guardian A' }).first();
await card.waitFor({ timeout: 15000 });
const text = S.flat(await card.innerText()).replace(/\+?\d[\d\s-]{7,}\d/g, '<number>');
await S.shot(till, '01h-board-family-a-after-refund-pang-to-pay.png');
await card.getByRole('button', { name: "Cancel ZZ TEST Pang 934's booking", exact: true }).click();
const dialog = till.getByRole('dialog').filter({ hasText: "Cancel ZZ TEST Pang 934's booking" }).last();
await dialog.waitFor();
const seen = { card: text.slice(0, 700), title: S.flat(await dialog.getByRole('heading').first().innerText()), description: S.flat(await dialog.locator('p').first().innerText()) };
await dialog.getByLabel('Reason').fill('ZZ TEST SCRUM-934: Pang went home, refunded by item');
await S.shot(till, '06a-board-cancel-pang-alone-leaves-the-waiting-list.png');
const [answer] = await Promise.all([
  till.waitForResponse(r => /\/api\/checkin\/registrations\/[^/]+\/cancel$/.test(new URL(r.url()).pathname) && r.request().method() === 'POST'),
  dialog.getByRole('button', { name: 'Cancel the booking' }).click(),
]);
seen.answer = answer.status();
const posted = answer.request().postDataJSON();

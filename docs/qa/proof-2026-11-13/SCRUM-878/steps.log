S.phase = '3 (hunt): does the display come back to B by itself? watched for up to 3 minutes, one kid added every 30 s and taken off';
const { expect } = S;
const till = S.till, d = S.d;
const t0 = Date.now();
const samples = [];
let healedAt = null;
for (let i = 0; i < 7; i++) {
  const target = i % 2 === 0 ? 2 : 1;
  await S.quantity(till, 'Kids', target);
  let ok = false;
  try { await expect(d.getByText(new RegExp(`Kids\s*${target}\s*×`))).toBeVisible({ timeout: 25000 }); ok = true; } catch {}
  const notice = await till.getByText(/^Display connection:/).allInnerTexts().catch(() => []);
  const banner = await till.getByText(/^(Test harness|Display connected)/).allInnerTexts().catch(() => []);
  samples.push({ s: Math.round((Date.now() - t0) / 1000), target, displayFollowed: ok, notice: notice.map(S.flat), banner: banner.map(S.flat) });
  if (ok && healedAt === null && i > 0) { healedAt = Math.round((Date.now() - t0) / 1000); }
  if (ok) break;
  await till.waitForTimeout(5000);
}
await S.quantity(till, 'Kids', 1);
await till.waitForTimeout(2000);
await S.both('03d-B-display-after-waiting.png', 'point 3 (hunt) — after waiting: the display and B\'s till', till, d);
S.receipt.reads.p3heal = { samples, healedAt }; S.save();
return S.receipt.reads.p3heal;

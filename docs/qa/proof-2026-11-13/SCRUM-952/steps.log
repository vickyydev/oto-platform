S.phase = 'hunt: READ ONLY, the kiosk summary and the booth status for printers on staging';
const r = {};
const k = await S.call('GET', '/ops/kiosks');
const kiosks = k.body?.kiosks ?? k.body ?? [];
r.kiosks = { status: k.status, list: (Array.isArray(kiosks) ? kiosks : []).map(x => ({ station: x.stationName ?? x.name ?? null, printer: x.printer ? { label: x.printer.label, reachability: x.printer.reachability, paperStatus: x.printer.paperStatus, keys: Object.keys(x.printer) } : null })) };
const branches = (await S.call('GET', '/branches')).body.branches;

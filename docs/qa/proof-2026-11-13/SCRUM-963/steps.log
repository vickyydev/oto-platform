  const back = btn('Back'), cont = btn('Continue to payment');
  const sr = scroll?.getBoundingClientRect();
  const ir = input.getBoundingClientRect(), ar = age?.getBoundingClientRect(), cr = card?.getBoundingClientRect();
  const visTop = sr && sr.height > 0 ? Math.max(0, sr.top) : 0, visBottom = sr && sr.height > 0 ? Math.min(innerHeight, sr.bottom) : innerHeight;
  return { viewport: `${innerWidth}x${innerHeight}`, docScrollWidth: document.documentElement.scrollWidth,
    input: { box: R(ir), value: input.value, scrollWidth: input.scrollWidth, clientWidth: input.clientWidth, wholeNameShows: input.scrollWidth <= input.clientWidth + 1 },
    age: age ? { box: R(ar), text: age.textContent.trim(), underTheName: ar.top >= ir.bottom - 1, width: r1(ar.width) } : null,
    card: cr ? { box: R(cr), height: r1(cr.height), wholeInView: cr.top >= visTop - 1 && cr.bottom <= visBottom + 1 } : null,
    gateScroll: scroll ? { box: R(sr), display: getComputedStyle(scroll).display, overflowY: getComputedStyle(scroll).overflowY, scrollHeight: scroll.scrollHeight, clientHeight: scroll.clientHeight } : null,
    back: back ? { box: R(back.getBoundingClientRect()), fromFoot: r1(innerHeight - back.getBoundingClientRect().bottom) } : null,
    continue: cont ? { box: R(cont.getBoundingClientRect()), fromFoot: r1(innerHeight - cont.getBoundingClientRect().bottom), rightMargin: r1(innerWidth - cont.getBoundingClientRect().right), enabled: !cont.disabled } : null,
    buttonsBelowScroll: sr && back ? back.getBoundingClientRect().top >= sr.bottom - 1 : null };
}, CHILD);

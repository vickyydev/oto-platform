
=== 2026-11-13T01:54:09.267Z 1a: the held ZZ TEST sale of the SCRUM-952 proof, read before anything else
S.phase = '1a: the held ZZ TEST sale of the SCRUM-952 proof, read before anything else';
const r = { readAt: new Date().toISOString() };
const s = await S.sale(S.HELD_SALE);
S.walkNames(s);
r.sale = { id: s.sale.id, status: s.sale.status, receipt: s.sale.receiptNumber ?? null, gross: s.sale.totals.grossSatang / 100, occurredAt: s.sale.occurredAt ?? s.sale.createdAt ?? null, stationId: s.sale.stationId };
r.attempts = (s.attempts ?? []).map(a => ({ id: a.id, status: a.status, method: a.method, provider: a.provider ?? null, amount: a.amountSatang / 100, deviceId: a.deviceId ?? null, responseText: a.responseText ?? null }));
const st = (await S.call('GET', `/branches/${S.branchId}/stations?includeArchived=true`)).body.stations.find(x => x.id === s.sale.stationId);
r.station = st ? { name: st.name, archived: Boolean(st.archived), devices: st.devices.length } : null;
const box = (await S.call('GET', `/branches/${S.branchId}/boxes`)).body.boxes.find(b => b.role === 'virtual' && b.slot === 'virtual-1' && !b.archived);
S.box = { id: box.id, name: box.name, status: box.status };
const devs = await S.devicesOnBox(box.id);
const term = devs.find(d => d.id === r.attempts[0]?.deviceId);
r.terminal = term ? { label: term.label, archived: Boolean(term.archived), transport: term.transport, boxIsVb1: true } : '(not found on Virtual box 1)';
r.commands = await S.termCommandsFor(S.HELD_ATTEMPT);
S.receipt.reads.p1before = r;
const text = [
  `ZZ TEST sale ${S.HELD_SALE} (made by the SCRUM-952 proof) read ${r.readAt}, BEFORE any read of its attempt`,
  '',
  `GET /api/sales/${S.HELD_SALE}`,
  `  sale.status: ${r.sale.status}   receipt: ${r.sale.receipt}   gross: ฿${r.sale.gross}`,
  `  station: ${r.station?.name} (retired: ${r.station?.archived})`,
  `  attempts: ${JSON.stringify(r.attempts, null, 1)}`,
  '',
  `the attempt's terminal on Virtual box 1: ${JSON.stringify(r.terminal)}`,
  '',
  `GET /api/boxes/<Virtual box 1>/commands?limit=100 -> terminal commands for attempt ${S.HELD_ATTEMPT}:`,
  JSON.stringify(r.commands, null, 1),
].join('\n');
await S.txtShot(text, '01a-api-held-sale-before.png', 'Point 1: the held ZZ TEST sale before any read of its attempt');
return r;
